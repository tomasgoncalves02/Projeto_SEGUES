@page
@using static Projeto_SEGUES.Models.Enums.Enums
@model RegisterModel
@{
    ViewData["Title"] = "Criar Conta";
}

@* 1. Contentor Principal *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 85vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-6">

            @* 2. Card com a linha superior na cor institucional *@
            <div class="card shadow-lg border-0 rounded-4" style="border-top: 6px solid #009697 !important;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h1 class="fw-bold display-6 text-dark">SEGUES</h1>
                        <p class="text-muted small">Crie a sua nova conta de utilizador</p>
                        @* Linha de destaque em Teal *@
                        <hr class="mx-auto" style="width: 60px; border-top: 3px solid #009697 !important; opacity: 1;" />
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        @* Nome e Sobrenome *@
                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" placeholder="Nome" />
                                    <label asp-for="Input.FirstName">Primeiro Nome</label>
                                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Sobrenome" />
                                    <label asp-for="Input.LastName">Sobrenome</label>
                                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        @* Email *@
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        @* Género *@
                        <div class="form-floating mb-3">
                            <select asp-for="Input.Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                <option selected="selected" value="">Selecione o Género</option>
                            </select>
                            <label asp-for="Input.Gender">Género</label>
                            <span asp-validation-for="Input.Gender" class="text-danger"></span>
                        </div>

                        @* Password com Toggle *@
                        <div class="mb-3">
                            <div class="input-group">
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Input.Password" class="form-control" id="passwordInput" autocomplete="new-password" aria-required="true" placeholder="password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                                    <label asp-for="Input.Password">Password</label>
                                </div>
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: none;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        @* Confirmar Password com Toggle *@
                        <div class="mb-4">
                            <div class="input-group">
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPasswordInput" autocomplete="new-password" aria-required="true" placeholder="password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                                    <label asp-for="Input.ConfirmPassword">Confirmar Password</label>
                                </div>
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: none;">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        @* Botão REGISTAR em Teal *@
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg fw-bold shadow-sm text-white"
                                style="background-color: #009697 !important; border: none; padding: 15px;">
                            <i class="bi bi-person-plus-fill me-2"></i>REGISTAR
                        </button>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                @* Link para Login em Teal *@
                <p class="small text-muted">Já tem conta? <a asp-page="./Login" class="fw-bold text-decoration-none" style="color: #009697 !important;">Faça Login aqui</a></p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function setupToggle(buttonId, inputId) {
                const toggleBtn = document.querySelector(buttonId);
                const passwordInput = document.querySelector(inputId);
                if (toggleBtn && passwordInput) {
                    const icon = toggleBtn.querySelector('i');
                    toggleBtn.addEventListener('click', function () {
                        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                        passwordInput.setAttribute('type', type);
                        icon.classList.toggle('bi-eye');
                        icon.classList.toggle('bi-eye-slash');
                    });
                }
            }
            setupToggle('#togglePassword', '#passwordInput');
            setupToggle('#toggleConfirmPassword', '#confirmPasswordInput');
        });
    </script>
}