@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Senha";
}

<style>
    /* Linha decorativa institucional em Teal */
    .title-underline {
        border-bottom: 4px solid #009697;
        display: inline-block;
        padding-bottom: 5px;
    }

    /* Estilização do foco nos campos para manter a identidade SEGUES */
    .form-control:focus {
        border-color: #009697;
        box-shadow: 0 0 0 0.25rem rgba(0, 150, 151, 0.25);
    }
</style>

@* 1. Contentor Principal: Alinhamento central para consistência com o Login *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-5">

            @* 2. Card com a borda superior característica de 6px em Teal *@
            <div class="card shadow-lg border-0 rounded-4" style="border-top: 6px solid #009697 !important;">
                <div class="card-body p-5">

                    <div class="text-center mb-5">
                        <h1 class="fw-bold display-6 text-dark">SEGUES</h1>
                        <h2 class="fs-5 title-underline mb-3">Recuperar Senha</h2>
                        <p class="text-muted small">Introduza o seu email para receber as instruções de recuperação.</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                        @* Campo de Email com Estilo Floating *@
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                            <label asp-for="Input.Email" class="form-label">Endereço de Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        @* Botão Principal em Teal *@
                        <button type="submit" class="w-100 btn btn-lg py-3 fw-bold shadow-sm text-white"
                                style="background-color: #009697 !important; border: none; border-radius: 8px;">
                            <i class="bi bi-key me-2"></i>RECUPERAR ACESSO
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <p class="small text-muted">
                            Lembrou-se da senha? <a asp-page="./Login" class="fw-bold text-decoration-none" style="color: #009697 !important;">Voltar ao Login</a>
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}