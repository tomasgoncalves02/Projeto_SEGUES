@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Redefinição Concluída";
}

<style>
    /* Linha decorativa institucional em Teal */
    .title-underline {
        border-bottom: 4px solid #009697;
        display: inline-block;
        padding-bottom: 5px;
    }

    /* Ícone de sucesso com a cor da marca */
    .icon-circle {
        width: 80px;
        height: 80px;
        background-color: rgba(0, 150, 151, 0.1);
        color: #009697;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto 20px;
    }
</style>

@* 1. Contentor Principal: Alinhamento central para consistência com o fluxo de Login *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-5">

            @* 2. Card com a borda superior característica de 6px em Teal *@
            <div class="card shadow-lg border-0 rounded-4 text-center" style="border-top: 6px solid #009697 !important;">
                <div class="card-body p-5">

                    @* Ícone de Confirmação *@
                    <div class="icon-circle">
                        <i class="bi bi-check-circle-fill fs-1"></i>
                    </div>

                    <h1 class="fw-bold display-6 text-dark mb-3">SEGUES</h1>
                    <h2 class="fs-5 title-underline mb-4">Senha Redefinida</h2>

                    <p class="text-muted mb-5 fs-5">
                        A sua senha foi alterada com sucesso. <br />
                        <strong>Agora já pode aceder à sua conta com as novas credenciais.</strong>
                    </p>

                    @* Botão Principal de Login em Teal *@
                    <a asp-page="./Login" class="w-100 btn btn-lg py-3 fw-bold shadow-sm text-white"
                       style="background-color: #009697 !important; border: none; border-radius: 8px;">
                        <i class="bi bi-box-arrow-in-right me-2"></i>ENTRAR NA CONTA
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>