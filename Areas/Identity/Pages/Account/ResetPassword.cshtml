@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir Senha";
}

<style>
    /* Linha decorativa institucional conforme o padrão do sistema */
    .title-underline {
        border-bottom: 4px solid #009697;
        display: inline-block;
        padding-bottom: 5px;
    }

    /* Foco nos campos de entrada para manter a identidade visual */
    .form-control:focus {
        border-color: #009697;
        box-shadow: 0 0 0 0.25rem rgba(0, 150, 151, 0.25);
    }
</style>

@* 1. Contentor Principal: Centralização vertical e horizontal *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-5">

            @* 2. Card com a borda superior característica de 6px em Teal *@
            <div class="card shadow-lg border-0 rounded-4" style="border-top: 6px solid #009697 !important;">
                <div class="card-body p-5">

                    <div class="text-center mb-5">
                        <h1 class="fw-bold display-6 text-dark">SEGUES</h1>
                        <h2 class="fs-5 title-underline mb-3">Redefinir Senha</h2>
                        <p class="text-muted small">Crie uma nova senha para aceder à sua conta.</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                        <input asp-for="Input.Code" type="hidden" />

                        @* Campo de Email (Readonly se necessário, conforme a lógica do Identity) *@
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                            <label asp-for="Input.Email" class="form-label">Endereço de Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        @* Nova Password *@
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nova Senha" />
                            <label asp-for="Input.Password" class="form-label">Nova Senha</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        @* Confirmar Password *@
                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar Senha" />
                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar Senha</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        @* Botão de Submissão em Teal *@
                        <button type="submit" class="w-100 btn btn-lg py-3 fw-bold shadow-sm text-white"
                                style="background-color: #009697 !important; border: none; border-radius: 8px;">
                            <i class="bi bi-shield-lock me-2"></i>REDEFINIR SENHA
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <a asp-page="./Login" class="fw-bold text-decoration-none" style="color: #009697 !important;">
                            <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}