@{
    ViewData["Title"] = "Área do Estudante";
}

<div class="container mt-4">
    <h2 class="mb-4">Olá, @User.Identity.Name! 👋</h2>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-primary text-white h-100 p-3">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75 small">Saldo no Cartão</h6>
                    <h2 class="display-5 fw-bold">@Model.Balance.ToString("C")</h2>
                    <a href="/Wallet/TopUp" class="btn btn-light btn-sm mt-3 fw-bold">Carregar Saldo</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <i class="bi bi-cart-plus fs-1 text-success mb-2"></i>
                    <h4 class="fw-bold">Comprar Senha</h4>
                    <p class="text-muted small">Preço Estudante: 2,90€</p>
                    <a asp-controller="Tickets" asp-action="Index" class="btn btn-success w-100">Ir para Loja</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <i class="bi bi-clock-history fs-1 text-warning mb-2"></i>
                    <h4 class="fw-bold">Minhas Senhas</h4>
                    <p class="text-muted small">Verifica se tens senhas ativas.</p>
                    <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-warning w-100">Ver Histórico</a>
                </div>
            </div>
        </div>
    </div>
</div>