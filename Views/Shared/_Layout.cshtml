<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projeto_SEGUES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Projeto_SEGUES.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @* O Brand (Logo) leva para a Home genérica ou Login *@
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Projeto_SEGUES</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @* LÓGICA DE NAVEGAÇÃO INTELIGENTE *@

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Admin" asp-action="Index">Painel Admin</a>
                            </li>
                        }
                        else if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Teacher" asp-action="Index">Portal Docente</a>
                            </li>
                        }
                        else if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Student" asp-action="Index">Área do Estudante</a>
                            </li>
                        }
                        else if (User.IsInRole("Employee") )
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Employee" asp-action="Index">Área do Funcionário</a>
                            </li>
                        }
                        else if (User.IsInRole("ExternalEmployee"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="ExternalEmployee" asp-action="Index">Área do Colaborador</a>
                            </li>
                        }
                        else
                        {
                            @* Se não tiver login feito, mostra a Home normal *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Início</a>
                            </li>
                        }

                    </ul>

                    @* Botões de Login/Logout *@
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Projeto_SEGUES
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>