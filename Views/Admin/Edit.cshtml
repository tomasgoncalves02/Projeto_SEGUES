@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Models.EditUserViewModel

@{
    ViewData["Title"] = "Editar Utilizador";
}

<style>
    /* Cor Institucional */
    :root {
        --ips-teal: #009697;
    }

    /* Foco nos inputs */
    .form-control:focus, .form-select:focus {
        border-color: var(--ips-teal);
        box-shadow: 0 0 0 0.25rem rgba(0, 150, 151, 0.25);
    }

    /* Labels pequenos e a negrito como na imagem */
    .form-label {
        font-weight: 700;
        font-size: 0.85rem;
        color: #333;
        margin-bottom: 0.3rem;
    }

    /* Botão Principal (Efetuar Registo) */
    .btn-ips {
        background-color: var(--ips-teal);
        color: white;
        border: none;
        font-weight: 600;
    }

        .btn-ips:hover {
            background-color: #007f80;
            color: white;
        }

    /* Botão Cancelar */
    .btn-cancel {
        background-color: white;
        border: 1px solid #ced4da;
        color: #333;
        font-weight: 500;
    }

        .btn-cancel:hover {
            background-color: #f8f9fa;
            color: #333;
        }

    /* Input de Saldo (Símbolo Euro) */
    .input-group-text-teal {
        background-color: var(--ips-teal);
        color: white;
        border: none;
        font-weight: bold;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="mb-2">
                <h2 class="fw-bold m-0" style="color: #333;">Editar Utilizador</h2>
                <p class="text-muted small">Altere as informações de perfil ou o saldo do utilizador selecionado.</p>
            </div>

            <div style="height: 4px; background-color: #009697; width: 100%; border-radius: 2px; margin-bottom: 30px;"></div>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">Nome</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Ex: Joana" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">Sobrenome</label>
                        <input asp-for="LastName" class="form-control" placeholder="Ex: Carla" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Profissional</label>
                    <input asp-for="Email" class="form-control" placeholder="email@exemplo.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label">Género</label>
                        <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Enums.Gender>()">
                            <option value="">Selecione...</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label">Função/Role</label>
                        <select asp-for="Role" class="form-select" asp-items="@(new SelectList(ViewBag.Roles))">
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Balance" class="form-label">Saldo Disponível</label>
                    <div class="input-group" style="max-width: 200px;">
                        <span class="input-group-text input-group-text-teal">€</span>
                        <input asp-for="Balance" type="number" step="0.01" class="form-control fw-bold" />
                    </div>
                    <span asp-validation-for="Balance" class="text-danger small"></span>
                </div>

                <div class="row mt-5">
                    <div class="col-md-6 mb-2">
                        <button type="submit" class="btn btn-ips w-100 py-2">
                            Editar
                        </button>
                    </div>
                    <div class="col-md-6">
                        <a asp-action="ListUsers" class="btn btn-cancel w-100 py-2">
                            Cancelar
                        </a>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}