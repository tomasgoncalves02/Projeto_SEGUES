@model Projeto_SEGUES.Models.User

@{
    ViewData["Title"] = "Detalhes do Utilizador";
}

<style>
    /* Linha decorativa institucional */
    .title-underline {
        border-bottom: 4px solid #009697;
        display: inline-block;
        padding-bottom: 5px;
    }

    /* Estilo para o cartão de detalhes */
    .ips-details-card {
        border: none !important;
        border-top: 6px solid #009697 !important;
        border-radius: 12px !important;
    }

    .text-ips {
        color: #009697 !important;
    }
</style>

<div class="container mt-5">
    @* Cabeçalho alinhado à esquerda *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold title-underline">👤 Ficha de Utilizador</h1>
        <a asp-action="ListUsers" class="btn fw-bold px-4" style="border: 2px solid #009697; color: #009697;">
            <i class="bi bi-arrow-left me-2"></i>Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm ips-details-card">
        @* Cabeçalho do Cartão *@
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold">@Model.FirstName @Model.LastName</h4>

            @* MANTIDO: Lógica de cores por perfil para fácil identificação *@
            @{
                var badgeClass = Model.Role switch
                {
                    Projeto_SEGUES.Models.Enums.Enums.UserRole.Admin => "bg-danger",
                    Projeto_SEGUES.Models.Enums.Enums.UserRole.Employee => "bg-warning text-dark",
                    Projeto_SEGUES.Models.Enums.Enums.UserRole.DocenteNaoDocente => "bg-primary",
                    Projeto_SEGUES.Models.Enums.Enums.UserRole.Student => "bg-info text-dark",
                    _ => "bg-secondary"
                };
            }
            <span class="badge @badgeClass fs-6 px-3 py-2">@ViewBag.UserRole</span>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row g-4">
                @* Coluna Esquerda *@
                <div class="col-md-6 border-end">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted text-uppercase small">Email / Username</dt>
                        <dd class="col-sm-7 fw-bold">@Model.Email</dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">ID Interno</dt>
                        <dd class="col-sm-7 mt-3"><small class="font-monospace text-secondary">@Model.Id</small></dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Género</dt>
                        <dd class="col-sm-7 mt-3">@Model.Gender</dd>
                    </dl>
                </div>

                @* Coluna Direita *@
                <div class="col-md-6 ps-md-5">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted text-uppercase small">Data de Criação</dt>
                        <dd class="col-sm-7">@Model.CreationDate.ToShortDateString()</dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Saldo Atual</dt>
                        <dd class="col-sm-7 mt-3 text-ips fs-4 fw-bold">@Model.Balance.ToString("C")</dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Estado da Conta</dt>
                        <dd class="col-sm-7 mt-3">
                            @if (Model.Status == Projeto_SEGUES.Models.Enums.Enums.UserStatus.Active)
                            {
                                <span class="badge bg-success-subtle text-success px-3 border border-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger px-3 border border-danger">Inativo</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        @* Rodapé com Botões de Ação *@
        <div class="card-footer bg-light border-0 py-4 px-4 px-md-5">
            <div class="d-flex flex-wrap gap-3">
                @* Botão Editar em Teal *@
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn text-white fw-bold px-4 py-2"
                   style="background-color: #009697; border-radius: 8px;">
                    <i class="bi bi-pencil-square me-2"></i>Editar Dados
                </a>

                @* Botão Apagar *@
                @if (User.Identity.Name != Model.UserName)
                {
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger fw-bold px-4 py-2"
                       style="border-radius: 8px;">
                        <i class="bi bi-trash me-2"></i>Apagar Conta
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary fw-bold px-4 py-2" disabled
                            title="Não podes apagar a tua própria conta" style="border-radius: 8px;">
                        <i class="bi bi-shield-lock me-2"></i>Apagar Conta
                    </button>
                }
            </div>
        </div>
    </div>
</div>