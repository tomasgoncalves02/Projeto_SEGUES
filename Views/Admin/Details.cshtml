@model Projeto_SEGUES.Models.User

@{
    ViewData["Title"] = "Detalhes do Utilizador";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>👤 Ficha de Utilizador</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">⬅️ Voltar à Lista</a>
    </div>

    <div class="card shadow-sm border-top border-4 border-primary">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h4 class="mb-0">@Model.FirstName @Model.LastName</h4>
            <span class="badge bg-primary fs-6">@ViewBag.UserRole</span>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Email / Username</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Email</dd>

                        <dt class="col-sm-4 text-muted">ID Interno</dt>
                        <dd class="col-sm-8"><small class="font-monospace">@Model.Id</small></dd>

                        <dt class="col-sm-4 text-muted">Género</dt>
                        <dd class="col-sm-8">@Model.Gender</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Data Criação</dt>
                        <dd class="col-sm-8">@Model.CreationDate.ToShortDateString()</dd>

                        <dt class="col-sm-4 text-muted">Saldo Atual</dt>
                        <dd class="col-sm-8 text-success fs-5 fw-bold">@Model.Balance.ToString("C")</dd>

                        <dt class="col-sm-4 text-muted">Estado</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == Projeto_SEGUES.Models.Enums.Enums.UserStatus.Active)
                            {
                                <span class="text-success">✅ Ativo</span>
                            }
                            else
                            {
                                <span class="text-danger">❌ Inativo</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        @* AQUI ESTÃO OS NOVOS BOTÕES DE AÇÃO *@
        <div class="card-footer bg-white py-3">
            <div class="d-flex gap-2">
                @* Botão Editar *@
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                    ✏️ Editar Dados
                </a>

                @* Botão Apagar (Com proteção para não apagar o próprio admin logado) *@
                @if (User.Identity.Name != Model.UserName)
                {
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger px-4">
                        🗑️ Apagar Conta
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary" disabled title="Não podes apagar a tua própria conta">
                        🗑️ Apagar Conta
                    </button>
                }
            </div>
        </div>
    </div>
</div>