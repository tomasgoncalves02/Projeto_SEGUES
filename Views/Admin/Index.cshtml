@{
    ViewData["Title"] = "Painel de Administração - SEGUES";
}

<style>
    /* Estilos de interatividade consistentes com o resto do sistema */
    .hover-effect {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    /* Linha decorativa institucional */
    .title-underline {
        border-bottom: 4px solid #009697;
        display: inline-block;
        padding-bottom: 5px;
    }
</style>
<div class="container mt-5">
    @* Cabeçalho atualizado com Botão Voltar e Badge *@
    <div class="row mb-5 align-items-center">
        <div class="col-md-7">
            <h1 class="fw-bold title-underline mb-0">Painel de Administração</h1>
        </div>
        <div class="col-md-5 text-end d-flex justify-content-end align-items-center gap-3">
            <span class="badge py-2 px-3" style="background-color: #009697 !important;">
                <i class="bi bi-person-badge me-1"></i> @User.Identity?.Name
            </span>

            @* Botão Voltar consistente com as outras páginas *@
            <a asp-controller="Home" asp-action="Index" class="btn fw-bold px-4"
               style="border: 2px solid #009697; color: #009697; border-radius: 8px;">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @* 1. NOVO REGISTO INTERNO *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-effect d-flex flex-column text-center"
                 style="border: none; border-top: 5px solid #009697; background-color: white; border-radius: 10px;">
                <div class="card-body d-flex flex-column p-5">
                    <div class="fs-1 mb-3" style="color: #009697;"><i class="bi bi-person-plus"></i></div>
                    <h3 class="card-title fw-bold">Novo Registo</h3>
                    <p class="text-muted">Criar manualmente um Administrador ou Funcionário no sistema.</p>

                    <div class="mt-auto pt-3">
                        <a asp-action="CreateInternalAccount" class="btn w-100 py-2 fw-bold text-white stretched-link"
                           style="background-color: #009697; border: none; border-radius: 6px;">
                            + Criar Conta
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* 2. GERIR UTILIZADORES *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-effect d-flex flex-column text-center"
                 style="border: none; border-top: 5px solid #009697; background-color: white; border-radius: 10px;">
                <div class="card-body d-flex flex-column p-5">
                    <div class="fs-1 mb-3" style="color: #009697;"><i class="bi bi-people"></i></div>
                    <h3 class="card-title fw-bold">Gerir Utilizadores</h3>
                    <p class="text-muted">Consultar lista, ver detalhes, editar ou apagar contas registadas.</p>

                    <div class="mt-auto pt-3">
                        <a asp-action="ListUsers" class="btn w-100 py-2 fw-bold text-white stretched-link"
                           style="background-color: #009697; border: none; border-radius: 6px;">
                            Ver Lista ->
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* 3. GESTÃO DE SENHAS *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm hover-effect d-flex flex-column text-center"
                 style="border: none; border-top: 5px solid #009697; background-color: white; border-radius: 10px;">
                <div class="card-body d-flex flex-column p-5">
                    <div class="fs-1 mb-3" style="color: #009697;"><i class="bi bi-ticket-perforated"></i></div>
                    <h3 class="card-title fw-bold">Gestão de Senhas</h3>
                    <p class="text-muted">Monitorizar vendas, validar estados e verificar as expirações.</p>

                    <div class="mt-auto pt-3">
                        <a asp-controller="Tickets" asp-action="GestaoSenhas" class="btn w-100 py-2 fw-bold text-white stretched-link"
                           style="background-color: #009697; border: none; border-radius: 6px;">
                            Gerir Senhas ->
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>