@{
    ViewData["Title"] = "Painel de Administração";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>⚙️ Painel de Administração</h1>
        <span class="badge bg-dark">@User.Identity?.Name</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @* CARTÃO 1: CRIAR CONTA *@
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-start border-4 border-primary hover-effect">
                <div class="card-body text-center p-5">
                    <div class="fs-1 mb-3">👤</div>
                    <h3 class="card-title fw-bold">Novo Registo Interno</h3>
                    <p class="text-muted">Criar manualmente um Administrador ou Funcionário.</p>
                    <a asp-action="CreateInternalAccount" class="btn btn-primary btn-lg w-100 mt-3 stretched-link">
                        + Criar Conta
                    </a>
                </div>
            </div>
        </div>

        @* CARTÃO 2: VER LISTA DE UTILIZADORES (O QUE PEDISTE) *@
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-start border-4 border-success hover-effect">
                <div class="card-body text-center p-5">
                    <div class="fs-1 mb-3">📋</div>
                    <h3 class="card-title fw-bold">Gerir Utilizadores</h3>
                    <p class="text-muted">Consultar lista, ver detalhes, editar ou apagar contas.</p>
                    <a asp-action="ListUsers" class="btn btn-success btn-lg w-100 mt-3 stretched-link">
                        Ver Lista ➡️
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>