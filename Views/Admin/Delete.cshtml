@model Projeto_SEGUES.Models.User

@{
    ViewData["Title"] = "Apagar Utilizador";
}

<div class="container mt-4">
    <h1 class="text-danger">Apagar Utilizador</h1>
    <h3 class="text-muted">Tens a certeza que queres apagar este utilizador?</h3>
    <p class="text-warning">Esta ação não pode ser revertida.</p>

    <div class="card border-danger mt-4">
        <div class="card-header bg-danger text-white">
            Utilizador a remover
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-2">Nome</dt>
                <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>

                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@Model.Email</dd>

                <dt class="col-sm-2">Saldo Atual</dt>
                <dd class="col-sm-10">@Model.Balance.ToString("C")</dd>
            </dl>
        </div>
        <div class="card-footer bg-white">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Sim, Apagar Definitivamente</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>