@using Projeto_SEGUES.Models.Enums
@using static Projeto_SEGUES.Models.Enums.Enums
@inject Microsoft.AspNetCore.Identity.UserManager<User> UserManager

@{
    ViewData["Title"] = "Página Inicial";
    var user = await UserManager.GetUserAsync(User);
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-dark">Olá, @user.FirstName! 👋</h1>
            <p class="text-muted">Bem-vindo ao sistema de gestão de refeições do IPS.</p>
        </div>
    </div>

    @* --- DASHBOARD PARA COMPRADORES (Estudante, Docente, Externo) --- *@
    @if (user.Role == UserRole.Student || user.Role == UserRole.DocenteNaoDocente || user.Role == UserRole.External)
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-primary text-white h-100">
                    <div class="card-body p-4">
                        <small class="text-uppercase opacity-75 fw-bold">Saldo Disponível</small>
                        <h2 class="display-5 fw-bold mt-2">@user.Balance.ToString("C")</h2>
                        <a href="/Wallet/TopUp" class="btn btn-light btn-sm mt-3 fw-bold">Carregar Cartão</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 border-top border-4 border-success">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-cart-plus fs-1 text-success"></i>
                        <h4 class="fw-bold mt-3">Comprar Senha</h4>
                        <p class="text-muted small">Adquire já a tua próxima refeição.</p>
                        <a asp-controller="Tickets" asp-action="Index" class="btn btn-success w-100">Ir para a Loja</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100 border-top border-4 border-info">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-qr-code fs-1 text-info"></i>
                        <h4 class="fw-bold mt-3">Minhas Senhas</h4>
                        <p class="text-muted small">Consulta os teus códigos ativos.</p>
                        <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-info w-100">Ver Histórico</a>
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- DASHBOARD PARA STAFF (Employee) --- *@
    else if (user.Role == UserRole.Employee)
    {
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 bg-dark text-white p-4">
                    <div class="text-center">
                        <i class="bi bi-qr-code-scan display-1"></i>
                        <h3 class="mt-3 fw-bold">Validar Refeição</h3>
                        <p class="opacity-75">Valida a entrada de alunos e docentes no refeitório.</p>
                        <a asp-controller="Tickets" asp-action="Index" class="btn btn-primary btn-lg w-100 mt-2">
                            <i class="bi bi-camera me-2"></i> Abrir Validador
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm border-0 border-start border-4 border-info h-100 p-4">
                    <h4 class="fw-bold"><i class="bi bi-info-circle me-2 text-info"></i>Resumo do Dia</h4>
                    <hr>
                    <p class="mb-1">Senhas validadas hoje: <strong>124</strong></p>
                    <p class="mb-1">Capacidade do refeitório: <strong>85%</strong></p>
                    <p class="text-muted small mt-3">Utilize o painel de auditoria para consultar senhas específicas.</p>
                </div>
            </div>
        </div>
    }

    @* --- DASHBOARD PARA ADMIN --- *@
    else if (user.Role == UserRole.Admin)
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-top border-4 border-primary p-4 h-100 text-center">
                    <i class="bi bi-people fs-1 text-primary"></i>
                    <h4 class="fw-bold mt-2">Utilizadores</h4>
                    <a asp-controller="Admin" asp-action="ListUsers" class="btn btn-outline-primary mt-3">Gerir Contas</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-top border-4 border-warning p-4 h-100 text-center">
                    <i class="bi bi-ticket-perforated fs-1 text-warning"></i>
                    <h4 class="fw-bold mt-2">Auditoria</h4>
                    <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-warning mt-3">Ver Vendas</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-top border-4 border-danger p-4 h-100 text-center">
                    <i class="bi bi-currency-euro fs-1 text-danger"></i>
                    <h4 class="fw-bold mt-2">Configurações</h4>
                    <a href="#" class="btn btn-outline-danger mt-3">Editar Preços</a>
                </div>
            </div>
        </div>
    }
</div>