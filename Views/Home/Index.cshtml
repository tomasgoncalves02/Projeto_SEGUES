@using Projeto_SEGUES.Models.Enums
@{
    ViewData["Title"] = "Dashboard - SEGUES";
    var balance = ViewBag.UserBalance ?? 0m;
}

<style>
    /* Estilos de interatividade e alinhamento */
    .hover-effect {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>

<div class="container mt-5">
    <div class="row mb-5">
        <div class="col-12">
            @* Agora utiliza o campo Nome da base de dados *@
            <h3 class="fw-bold display-5">Olá, @ViewBag.FirstName! 👋</h3>
            <p class="text-muted fs-5">Selecione uma das opções abaixo para gerir os seus serviços.</p>
        </div>
    </div>

    @* Grelha Principal Responsiva *@
    <div class="row g-4">

        @* 1. CARTÃO DE SALDO (AZUL) *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 bg-primary text-white hover-effect d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <small class="d-block opacity-75 fw-bold mb-2">Saldo Disponível</small>
                    <h2 class="display-6 fw-bold my-auto">@balance.ToString("C")</h2>

                    <div class="mt-auto pt-3">
                        <button class="btn btn-light w-100 py-2 fw-bold">Carregar Saldo</button>
                    </div>
                </div>
            </div>
        </div>

        @* 2. CARTÃO REFEITÓRIO (VERDE - RF17) *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-success hover-effect d-flex flex-column text-center">
                <div class="card-body d-flex flex-column p-4">
                    <div class="fs-1 text-success mb-3"><i class="bi bi-cart-plus"></i></div>
                    <h5 class="fw-bold">Refeitório</h5>
                    <p class="text-muted small mb-4">Compra e usa as tuas senhas de refeição.</p>

                    <div class="mt-auto">
                        <a asp-controller="Tickets" asp-action="Refeitorio" class="btn btn-success w-100 py-2">Ir para o Refeitório</a>
                    </div>
                </div>
            </div>
        </div>

        @* 3. CARTÃO BAR (AZUL CLARO) *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-primary hover-effect d-flex flex-column text-center">
                <div class="card-body d-flex flex-column p-4">
                    @* Ícone de copo com palhinha conforme pedido *@
                    <div class="fs-1 text-primary mb-3"><i class="bi bi-cup-straw"></i></div>
                    <h5 class="fw-bold">Bar</h5>
                    <p class="text-muted small mb-4">Compra e gere os teus pedidos no bar.</p>

                    <div class="mt-auto">
                        <button class="btn btn-primary w-100 py-2" style="background-color: #84a5f8; border-color: #84a5f8;" disabled>Ir para o Bar</button>
                    </div>
                </div>
            </div>
        </div>

        @* 4. CARTÃO HISTÓRICO (LARANJA - RF06) *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-warning hover-effect d-flex flex-column text-center">
                <div class="card-body d-flex flex-column p-4">
                    <div class="fs-1 text-warning mb-3"><i class="bi bi-clock-history"></i></div>
                    <h5 class="fw-bold">Histórico</h5>
                    <p class="text-muted small mb-4">Visualiza o teu histórico de utilização e validade.</p>

                    <div class="mt-auto">
                        <a asp-controller="Tickets" asp-action="HistoricoMenu" class="btn btn-warning text-white w-100 py-2">Ver Histórico</a>
                    </div>
                </div>
            </div>
        </div>

        @* 5. PAINEL ADMIN (EXCLUSIVO ADMIN - RF26) *@
        @if (User.IsInRole("Admin"))
        {
            <div class="col-12 mt-4">
                <div class="card shadow-lg border-0 bg-dark text-white p-4 hover-effect">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2"></i>Painel de Administração</h4>
                            <p class="mb-0 opacity-75">Configurações de limites e gestão de contas internas.</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-light btn-lg px-5">Gerir Sistema -></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>