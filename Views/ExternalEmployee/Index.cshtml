@{
    ViewData["Title"] = "Área do Colaborador";
}

<div class="container mt-5">
    <div class="card bg-secondary text-white p-4 mb-4 shadow-sm border-0">
        <h1 class="mb-0">Área de Utente Externo</h1>
        <p class="opacity-75">Bem-vindo ao sistema de refeições do IPS.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-12">
            <div class="card shadow-sm border-top border-5 border-warning p-5 text-center">
                <h3>O seu Saldo: <strong>@ViewBag.UserBalance.ToString("C")</strong></h3>
                <p class="text-muted">A sua tarifa é de 5,50€ por refeição.</p>
                <a asp-controller="Tickets" asp-action="Index" class="btn btn-warning btn-lg text-white mt-3 px-5 fw-bold">
                    Comprar / Ver Senhas
                </a>
            </div>
        </div>
    </div>
</div>