@model IEnumerable<Projeto_SEGUES.Models.Ticket>
@using static Projeto_SEGUES.Models.Enums.Enums

@{
    ViewData["Title"] = "Gestão de Senhas - SEGUES";
    var userRole = ViewBag.UserRole;
    var balance = ViewBag.UserBalance ?? 0m;
    var price = ViewBag.CurrentPrice ?? 0m;

    bool podeComprar = (userRole == UserRole.Student ||
                        userRole == UserRole.IPSWorker ||
                        userRole == UserRole.External || userRole == UserRole.Admin || userRole == UserRole.Employee);
}

@* Importação do SweetAlert2 *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .title-underline {
        border-bottom: 4px solid #009697;
        display: inline-block;
        padding-bottom: 5px;
    }

    .text-ips {
        color: #009697 !important;
    }

    .bg-ips {
        background-color: #009697 !important;
    }

    .btn-ips {
        background-color: #009697 !important;
        color: white !important;
        border: none;
    }

        .btn-ips:hover {
            filter: brightness(90%);
            color: white;
        }

    .card-ips {
        border: none !important;
        border-top: 5px solid #009697 !important;
        border-radius: 10px !important;
    }
</style>

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-ticket-detailed-fill me-2" style="color: #009697;"></i>
                Comprar Senhas
            </h2>
            <p class="text-muted small">Controlo de Refeições - SEGUES</p>
        </div>

        <div class="col-md-5 text-end d-flex justify-content-end align-items-center gap-3">
            @if (podeComprar)
            {
                <div class="card bg-ips text-white border-0 shadow-sm d-none d-lg-block">
                    <div class="card-body py-2 px-3">
                        <small class="d-block opacity-75 fw-bold" style="font-size: 0.7rem;">SALDO</small>
                        <span class="fw-bold">@balance.ToString("C")</span>
                    </div>
                </div>
            }

            <a asp-controller="Home" asp-action="Index" class="btn fw-bold px-4"
               style="border: 2px solid #009697; color: #009697; border-radius: 8px;">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    <div class="row g-4">
        @* --- COMPRA DE SENHA --- *@
        @if (podeComprar)
        {
            <div class="col-lg-4">
                <div class="card shadow-sm card-ips mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-ips"><i class="bi bi-cart-plus me-2"></i>Nova Senha</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-light border-0 small mb-4" style="background-color: #f0f7f7;">
                            Preço para o seu perfil: <strong class="text-ips fs-5">@price.ToString("C")</strong>
                        </div>

                        @* MUDANÇA 1: Adicionei id="formCompra" para o JS controlar 
                        *@
                        <form asp-action="BuyTicket" method="post" id="formCompra">
                            <div class="mb-4">
                                <label class="form-label small fw-bold">Quantidade:</label>
                                @* MUDANÇA 2: Adicionei id="selectQtd" para ler a quantidade 
                                *@
                                <select name="quantity" id="selectQtd" class="form-select border-2">
                                    <option value="1">1 Refeição (@price.ToString("C"))</option>
                                    <option value="2">2 Refeições (@((price * 2).ToString("C")))</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-ips w-100 py-2 fw-bold shadow-sm"
                                    @(balance < price ? "disabled" : "")>
                                <i class="bi bi-check2-circle me-1"></i> CONFIRMAR COMPRA
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* --- TABELA DE SENHAS --- *@
        <div class="@(podeComprar ? "col-lg-8" : "col-lg-12")">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0 fw-bold text-ips"><i class="bi bi-list-check me-2"></i>Registo de Senhas</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #009697; color: white;">
                            <tr>
                                <th>Código</th>
                                <th>Expiração</th>
                                <th>Estado</th>
                                <th class="text-center">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><code class="fw-bold text-ips">@item.ValidationCode</code></td>
                                    <td class="small">@item.ExpirationDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.State == TicketState.Available)
                                        {
                                            <span class="badge" style="background-color: #009697;">Disponível</span>
                                        }
                                        else if (item.State == TicketState.Used)
                                        {
                                            <span class="badge bg-secondary">Consumida</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Expirada</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.State == TicketState.Available)
                                        {
                                            <button class="btn btn-sm fw-bold" style="border: 2px solid #009697; color: #009697;" onclick="verCodigo('@item.ValidationCode')">
                                                <i class="bi bi-qr-code"></i> VER
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Mensagens de Feedback do Servidor
            var success = '@TempData["Success"]';
            var error = '@TempData["Error"]';

            if (success) {
                Swal.fire({ icon: 'success', title: 'Operação Concluída', text: success, confirmButtonColor: '#009697' });
            }
            if (error) {
                Swal.fire({ icon: 'error', title: 'Erro', text: error, confirmButtonColor: '#d33' });
            }

            // ----------------------------------------------------
            // LÓGICA DE CONFIRMAÇÃO DE COMPRA
            // ----------------------------------------------------
            const formCompra = document.getElementById('formCompra');

            if (formCompra) {
                formCompra.addEventListener('submit', function(e) {
                    e.preventDefault(); // Impede o envio imediato

                    // Pega a quantidade selecionada e o preço unitário
                    const qtd = document.getElementById('selectQtd').value;
                    // Converte o preço C# para JS (troca virgula por ponto se necessário)
                    const unitPrice = @price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

                    const total = (qtd * unitPrice).toFixed(2); // Calcula total

                    Swal.fire({
                        title: 'Confirmar Compra?',
                        html: `Deseja comprar <b>${qtd}</b> senha(s)?<br>Total a descontar: <b>${total}€</b>`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#009697',  // Verde/Teal do IPS
                        cancelButtonColor: '#d33',      // Vermelho para o NÃO
                        confirmButtonText: 'Sim, comprar',
                        cancelButtonText: 'Não, cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Se disse SIM, envia o formulário manualmente
                            formCompra.submit();
                        }
                        // Se disse NÃO, não faz nada (o preventDefault já parou tudo)
                    });
                });
            }
        });

        function verCodigo(code) {
            Swal.fire({
                title: 'Senha de Refeição',
                html: '<div class="p-4 bg-light border border-2 rounded" style="border-color: #009697 !important;">' +
                      '<img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + code +'&size=150" alt="QR Code"> </div>' +
                      '<br>'+
                      '<div class="p-4 bg-light border border-2 rounded" style="border-color: #009697 !important;">' +
                      '<h2 class="mb-0 fw-bold" style="letter-spacing: 2px; color: #009697;">' + code + '</h2>' +
                      '</div><p class="mt-3 text-muted small">Apresente este código no refeitório para validação.</p>',
                confirmButtonText: 'Fechar',
                confirmButtonColor: '#009697'
            });
        }
    </script>
}