@model IEnumerable<Projeto_SEGUES.Models.Ticket>
@using static Projeto_SEGUES.Models.Enums.Enums

@{
    ViewData["Title"] = "Gestão de Senhas - SEGUES";
    var userRole = ViewBag.UserRole;
    var balance = ViewBag.UserBalance ?? 0m;
    var price = ViewBag.CurrentPrice ?? 0m;

    // Perfis que PODEM comprar senhas
    bool podeComprar = (userRole == UserRole.Student ||
                        userRole == UserRole.DocenteNaoDocente ||
                        userRole == UserRole.External);

    // Perfis que PODEM ver todas as senhas (Staff e Admin)
    bool isAuditor = (userRole == UserRole.Admin || userRole == UserRole.Employee);
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-4">
    @* --- CABEÇALHO --- *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-dark">
                <i class="bi bi-ticket-detailed-fill text-primary me-2"></i>
                @(isAuditor ? "Painel de Auditoria de Senhas" : "As Minhas Senhas")
            </h2>
            <p class="text-muted small">Controlo de Refeições - Sprint 2</p>
        </div>

        @if (podeComprar)
        {
            <div class="col-md-4 text-end">
                <div class="card bg-primary text-white border-0 shadow-sm">
                    <div class="card-body py-2 px-4">
                        <small class="d-block opacity-75 fw-bold">SALDO DISPONÍVEL</small>
                        <span class="fs-3 fw-bold">@balance.ToString("C")</span>
                    </div>
                </div>
            </div>
        }
    </div>

    @* --- SECÇÃO EXCLUSIVA PARA ADMIN: DEFINIÇÃO DE PREÇOS (RF17) --- *@
    @if (userRole == UserRole.Admin)
    {
        var prices = ViewBag.Prices as List<Projeto_SEGUES.Models.TicketPrice>;

        <div class="card shadow-sm border-0 mb-5 border-top border-4 border-warning">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-currency-euro me-2"></i>Definição de Preçário (RF17)</h5>
            </div>
            <div class="card-body p-4 bg-light">
                <form asp-controller="Tickets" asp-action="UpdatePrices" method="post" class="row align-items-end g-3">
                    @if (prices != null)
                    {
                        @for (int i = 0; i < prices.Count; i++)
                        {
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted">@prices[i].TicketType.ToString()</label>

                                @* CAMPOS HIDDEN CRUCIAL: Sem isto dá erro de sistema *@
                                <input type="hidden" name="updatedPrices[@i].Id" value="@prices[i].Id" />
                                <input type="hidden" name="updatedPrices[@i].TicketType" value="@prices[i].TicketType" />
                                <input type="hidden" name="updatedPrices[@i].InitialDatePrice" value="@prices[i].InitialDatePrice.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                <input type="hidden" name="updatedPrices[@i].EndDatePrice" value="@prices[i].EndDatePrice.ToString("yyyy-MM-ddTHH:mm:ss")" />

                                <div class="input-group">
                                    <span class="input-group-text bg-white">€</span>
                                    <input type="text" name="updatedPrices[@i].Price"
                                           class="form-control fw-bold"
                                           value="@prices[i].Price.ToString("F2")" />
                                </div>
                            </div>
                        }
                    }
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-warning w-100 fw-bold text-dark shadow-sm">
                            <i class="bi bi-arrow-repeat me-1"></i> ATUALIZAR PREÇOS
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="row">
        @* --- COMPRA DE SENHA (Utentes) --- *@
        @if (podeComprar)
        {
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 mb-4 border-top border-4 border-success">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-success"><i class="bi bi-cart-plus me-2"></i>Nova Senha</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-light border-0 small mb-3">
                            Preço para o seu perfil: <strong class="text-dark">@price.ToString("C")</strong>
                        </div>

                        <form asp-action="BuyTicket" method="post">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Quantidade:</label>
                                <select name="quantity" class="form-select border-2">
                                    <option value="1">1 Refeição (@price.ToString("C"))</option>
                                    <option value="2">2 Refeições (@((price * 2).ToString("C")))</option>
                                </select>
                                <div class="form-text text-danger" style="font-size: 0.75rem;">
                                    <i class="bi bi-info-circle"></i> Limite de 2 senhas/dia.
                                </div>
                            </div>
                            <button type="submit" class="btn btn-success w-100 py-2 fw-bold shadow-sm"
                                    @(balance < price ? "disabled" : "")>
                                <i class="bi bi-check2-circle me-1"></i> CONFIRMAR COMPRA
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* --- REGISTO/AUDITORIA DE SENHAS --- *@
        <div class="@(podeComprar ? "col-lg-8" : "col-lg-12")">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Registo de Senhas</h5>
                    @if (isAuditor)
                    {
                        <span class="badge bg-dark">Visualização Global</span>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                @if (isAuditor)
                                {
                                    <th class="ps-3">Utente</th>
                                }
                                <th>Código</th>
                                <th>Expiração</th>
                                <th>Estado</th>
                                <th class="text-center">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @if (isAuditor)
                                    {
                                        <td class="ps-3">
                                            <div class="fw-bold small">@item.Owner?.FirstName @item.Owner?.LastName</div>
                                            <div class="text-muted" style="font-size: 0.7rem;">@item.Owner?.Email</div>
                                        </td>
                                    }
                                    <td><code class="fw-bold text-primary">@item.ValidationCode</code></td>
                                    <td class="small">@item.ExpirationDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.State == TicketState.Available)
                                        {
                                            <span class="badge bg-success shadow-none">Disponível</span>
                                        }
                                        else if (item.State == TicketState.Used)
                                        {
                                            <span class="badge bg-secondary">Consumida</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Expirada</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.State == TicketState.Available && !isAuditor)
                                        {
                                            <button class="btn btn-sm btn-outline-dark fw-bold" onclick="verCodigo('@item.ValidationCode')">
                                                <i class="bi bi-qr-code"></i> VER
                                            </button>
                                        }
                                        else if (isAuditor)
                                        {
                                            <span class="text-muted small italic">Somente leitura</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!Model.Any())
                {
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox fs-1 text-muted"></i>
                        <p class="mt-2 text-muted">Não foram encontrados registos de senhas.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var success = '@TempData["Success"]';
            var error = '@TempData["Error"]';

            if (success) {
                Swal.fire({ icon: 'success', title: 'Operação Concluída', text: success, confirmButtonColor: '#ffc107', confirmButtonTextColor: '#000' });
            }
            if (error) {
                Swal.fire({ icon: 'error', title: 'Erro de Sistema', text: error, confirmButtonColor: '#d33' });
            }
        });

        function verCodigo(code) {
            Swal.fire({
                title: 'Senha de Refeição',
                html: '<div class="p-4 bg-light border border-2 border-primary rounded">' +
                       //API usada na criação https://goqr.me/
                      '<img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + code +' &size=150" alt="QR Code"> </div>' +
                      '<br>'+
                      '<div class="p-4 bg-light border border-2 border-primary rounded">' +
                      '<h2 class="mb-0 fw-bold letter-spacing-2">' + code + '</h2>' +
                      '</div><p class="mt-3 text-muted">Apresente este código no refeitório para validação.</p>',
                confirmButtonText: 'Fechar',
                confirmButtonColor: '#0d6efd'
            });
        }
    </script>
}