@{
    ViewData["Title"] = "Painel de Gestão";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold">Painel de Gestão</h2>

        <a asp-controller="Home" asp-action="Index" class="btn btn-dark px-4 py-2">
            Voltar
        </a>
    </div>

    <div class="row" style="min-height: 50vh; align-items: center;">
        <div class="col-md-6 col-lg-5">

            <div class="card border-2 shadow-sm text-center p-4" style="border-color: #009697;">
                <div class="card-body py-4">

                    <h4 class="card-title fw-bold mb-3">Validar Senhas</h4>

                    <p class="card-text text-muted mb-4">
                        Valide as senhas dos alunos na fila do refeitório
                    </p>

                    <a asp-action="ValidateTicket" class="btn btn-primary w-100 py-2 fw-bold"
                       style="background-color: #009697; border-color: #009697;">
                        Validar
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>