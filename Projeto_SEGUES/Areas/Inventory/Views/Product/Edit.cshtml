@model Projeto_SEGUES.Areas.Inventory.ViewModels.BarProductViewModel
@{
    ViewData["Title"] = "Editar Produto - SEGUES";
}

<div class="container mt-5">
    @* Cabeçalho *@
    <div class="text-start mb-4">
        <h2 class="fw-bold title-underline mb-0">Editar Produto</h2>
        <p class="text-muted mt-2">Altere as informações, preço ou stock do produto selecionado.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-body p-5 text-start">
                    <form asp-action="Edit" method="post" id="editForm">
                        <input type="hidden" asp-for="Product.Id" />                       
                        <input type="hidden" asp-for="Product.IsActive" />

                        <div class="row g-4">
                            @* Nome *@
                            <div class="col-md-12">
                                <label class="form-label fw-bold small text-muted text-uppercase">Nome do Produto</label>
                                <input asp-for="Product.Name" class="form-control" />
                                <span asp-validation-for="Product.Name" class="text-danger small"></span>
                            </div>

                            @* Descrição *@
                            <div class="col-md-12">
                                <label class="form-label fw-bold small text-muted text-uppercase">Descrição Detalhada</label>
                                <textarea asp-for="Product.Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Product.Description" class="text-danger small"></span>
                            </div>

                            @* Stock *@
                            <div class="col-md-12">
                                <label class="form-label fw-bold small text-muted text-uppercase">Stock Disponível</label>
                                <input asp-for="Product.Stock" type="number" class="form-control" />
                                <span asp-validation-for="Product.Stock" class="text-danger small"></span>
                            </div>

                            @* Campo de Preço Estilizado (Igual ao Saldo) *@
                            <div class="col-md-12">
                                <div class="p-4 bg-light rounded border">
                                    <label class="form-label fw-bold small text-muted text-uppercase d-block mb-3">Preço Unitário (€)</label>
                                    <div class="d-flex align-items-center bg-white border rounded overflow-hidden">
                                        <div class="bg-color-ips text-white px-3 py-2 d-flex align-items-center justify-content-center" style="min-width: 50px;">
                                            <span class="fw-bold">€</span>
                                        </div>
                                        <input asp-for="Product.Price" type="number" step="0.01" class="form-control border-0 fw-bold fs-5 px-3" />
                                    </div>
                                    <span asp-validation-for="Product.Price" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        @* Botões *@
                        <div class="d-flex justify-content-center gap-3 mt-5">
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 fw-bold">Cancelar</a>
                            <button type="submit" class="btn btn-ips px-5 fw-bold shadow-sm text-uppercase">Guardar Alterações</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('editForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const form = this;

            Notifications.confirm(
                '',
                'Deseja guardar as alterações efetuadas neste produto?',
            ).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>
}