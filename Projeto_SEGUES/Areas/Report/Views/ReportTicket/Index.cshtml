@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Areas.Report.ViewModels.ReportTicketSearchViewModel

@{
    ViewData["Title"] = "Histórico de Senhas";
}

<div class="container mt-4">
    @* Header *@
    <div class="d-flex mb-4 align-items-center justify-content-between flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-clock-history me-2 text-color-ips"></i> Histórico de Senhas
            </h2>
            <p class="text-muted small mt-1 mb-0">Consulta detalhada de todas as tuas movimentações.</p>
        </div>
        <a asp-area="Report" asp-controller="Report" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm px-4 order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Filter section with HTMX *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body p-4">
            <form id="filterForm"
                  hx-get="/Report/ReportTickets/GetFilteredHistory"
                  hx-trigger="submit, change, keyup delay:300ms from:#searchFilter"
                  hx-target="#historyTableBody"
                  hx-indicator=".loader-spinner"
                  class="row g-3 align-items-end">
                
                <div class="col-md-6 col-xl">
                    <label asp-for="SearchString" class="small fw-bold"></label>
                    <input asp-for="SearchString" id="searchFilter" type="text" class="form-control form-control-sm" placeholder="Código ou Nome...">
                </div>
                
                <div class="col-md-4 col-xl-2">
                    <label asp-for="DateFilter" class="small fw-bold"></label>
                    <input asp-for="DateFilter" type="date" class="form-control form-control-sm">
                </div>
                
                <div class="col-md-4 col-xl-2">
                    <label asp-for="StateFilter" class="small fw-bold"></label>
                    <select asp-for="StateFilter" asp-items="Html.GetEnumSelectList<TicketState>()" class="form-select form-select-sm">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="col-md-4 col-xl-2">
                    <label asp-for="FlowFilter" class="small fw-bold"></label>
                    <select asp-for="FlowFilter" asp-items="Html.GetEnumSelectList<TicketFlow>()" class="form-select form-select-sm">
                        <option value="">Todas</option>
                    </select>
                </div>
                <div class="col-xl-auto">
                    <div class="d-flex align-items-center justify-content-end gap-3 pb-1">
                        @* HTMX Loading Spinner *@
                        <div class="d-flex align-items-center text-color-ips htmx-indicator loader-spinner" id="searchSpinner">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span class="small fw-bold">A pesquisar...</span>
                        </div>
                        @* Clear button *@
                        <a asp-action="Index" class="btn btn-sm btn-reset-x btn-ips-outline-secondary fw-bold px-3">
                            <i class="bi bi-x-circle me-1"></i>Limpar Filtros
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Table *@
    <div class="card card-ips shadow-sm border-0">
        <div class="table-responsive" style="max-height: 500px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead style="position: sticky; top: 0;">
                    <tr>
                        <th class="ps-4 py-3 text-start">Código</th>
                        <th class="py-3">Data Compra</th>
                        <th class="py-3">Estado</th>
                        <th class="py-3">Validade</th>
                        <th class="py-3">Data Uso</th>
                        <th class="py-3">Data Transf.</th>
                        <th class="py-3">Transferido Para</th>
                        <th class="pe-4 py-3">Recebido De</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody"
                       hx-get="/Report/ReportTickets/GetFilteredHistory"
                       hx-trigger="every 30s"
                       hx-include="#filterForm"
                       hx-swap="innerHTML">
                    <partial name="_TicketHistoryRowsPartial" model="Model.Results" />
                </tbody>
            </table>
        </div>
    </div>
</div>