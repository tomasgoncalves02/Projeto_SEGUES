@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Areas.Report.ViewModels.ReportOrderSearchViewModel

@{
    ViewData["Title"] = "Histórico de Bar";
}

<div class="container mt-4">
    @* Header *@
    <div class="d-flex mb-4 align-items-center justify-content-between col-12 col-md-auto flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h1 class="fw-bold display-6 title-underline mb-1">Histórico de Bar</h1>
            <p class="text-muted mt-1 mb-0">Consulta detalhada de todas as suas compras no Bar.</p>
        </div>
        <a asp-area="Report" asp-controller="Report" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto px-4 fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Filter section with HTMX *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body p-4">
            <form id="orderFilterForm"
                  hx-get="/Report/ReportOrder/GetFilteredOrders"
                  hx-trigger="submit, change, keyup delay:300ms from:#searchFilter"
                  hx-target="#orderTableBody"
                  hx-indicator=".loader-spinner"
                  class="row g-3 align-items-end">
                
                @* Search Filter *@
                <div class="col-md-6 col-xl">
                    <label asp-for="SearchString" class="small fw-bold">Pesquisar</label>
                    <input asp-for="SearchString" id="searchFilter" type="text" class="form-control form-control-sm" placeholder="Código do pedido...">
                </div>
                
                @* Date Filter *@
                <div class="col-md-4 col-xl-2">
                    <label asp-for="DateFilter" class="small fw-bold">Compradas em</label>
                    <input asp-for="DateFilter" type="date" class="form-control form-control-sm">
                </div>
                
                @* Status Filter *@
                <div class="col-md-4 col-xl-3">
                    <label asp-for="StatusFilter" class="small fw-bold">Estado</label>
                    <select asp-for="StatusFilter" 
                            asp-items="Html.GetEnumSelectList<OrderStatus>().Where(s => s.Value != ((int) OrderStatus.Cart).ToString()).ToList()" 
                            class="form-select form-select-sm">
                        <option value="">Todos os estados</option>
                    </select>
                </div>
                
                @* Actions *@
                <div class="col-xl-auto">
                    <div class="d-flex align-items-center justify-content-end gap-3 pb-1">
                        @* HTMX Loading Spinner *@
                        <div class="d-flex align-items-center text-color-ips htmx-indicator loader-spinner" id="searchSpinner">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span class="small fw-bold">A pesquisar...</span>
                        </div>
                        @* Clear button *@
                        <a asp-action="Index" class="btn btn-sm btn-reset-x btn-ips-outline-secondary fw-bold px-3">
                            <i class="bi bi-x-circle me-1"></i>Limpar Filtros
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Table *@
    <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3">
        <div class="table-responsive" style="max-height: 500px;">
            <table class="table table-hover align-middle mb-0 text-center" id="historyTable" style="min-width: 1200px;">
                <thead class="bg-color-ips text-white" style="position: sticky; top: 0;">
                <tr>
                    <th class="py-3 ps-4">Código Pedido</th>
                    <th class="py-3">Nº Pedido</th>
                    <th class="py-3">Data/Hora Compra</th>
                    <th class="py-3">Agendado p/</th>
                    <th class="py-3">Estado</th>
                    <th class="py-3">Recolhido em</th>
                    <th class="py-3">Produtos</th>
                    <th class="py-3 pe-4">Preço Total</th>
                </tr>
                </thead>
                <tbody id="orderTableBody"
                       hx-get="/Report/ReportOrder/GetFilteredOrders"
                       hx-trigger="every 30s"
                       hx-include="#orderFilterForm"
                       hx-swap="innerHTML">
                    <partial name="_OrderHistoryRowsPartial" model="Model.Results" />
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/report/reportOrder.js"></script>
}