@{
    ViewData["Title"] = "Estatisticas do Bar"; 
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h2 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-bar-chart-line me-2 text-color-ips"></i>
                Estatísticas do Bar
            </h2>
        </div>
        <a asp-area="Report" asp-controller="ReportStatistics" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm px-4 order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Period filter *@
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3">
                <div class="card-body p-3">
                    <label class="fw-bold small mb-1">Data</label>
                    <select id="selectOrdersPeriod" class="form-select shadow-none">
                        <option value="1" selected>Dia</option>
                        <option value="2">Semana</option>
                        <option value="3">Mês</option>
                        <option value="4">Ano</option>
                        <option value="5">Total</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @* Total orders *@
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <p class="small fw-semibold text-muted mb-1">Total de Pedidos</p>
                    <h3 class="fw-bold mb-1 text-color-ips" id="totalOrderBar">—</h3>
                </div>
            </div>
        </div>
        @* Total revenue *@
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <p class="small fw-semibold text-muted mb-1">Receita Total</p>
                    <h3 class="fw-bold mb-1 text-color-ips" id="totalIncomeBar">—</h3>
                </div>
            </div>
        </div>
        @* Average revenue *@
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <p class="small fw-semibold text-muted mb-1">Receita Média</p>
                    <h3 class="fw-bold mb-1 text-color-ips" id="averageIncomeBar">—</h3>
                </div>
            </div>
        </div>
        @* Unique total clients *@
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <p class="small fw-semibold text-muted mb-1">Total de Clientes</p>
                    <h3 class="fw-bold mb-1 text-color-ips" id="totalBuyersBar">—</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @* Line Chart *@
        <div class="col-lg-6">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-1 text-color-ips">Pedidos ao longo do tempo</h6>
                    <p class="text-muted small mb-3" id="orderChartSubtitle">Pedidos por hora hoje</p>
                    <div style="position: relative; height: 260px;">
                        <canvas id="orderChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        @* Category Chart *@
        <div class="col-lg-5">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-1 text-color-ips">Por categoria</h6>
                    <p class="text-muted small mb-4">Distribuição de produtos</p>
                    <div style="position: relative; height: 240px;">
                        <canvas id="productCategoriesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Top Products Table *@
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3 text-color-ips">Produtos Mais Vendidos</h6>
                    <div class="table-responsive" style="max-height: 500px;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-color-ips-very-light text-muted small text-uppercase">
                                <tr>
                                    <th class="rounded-start">Produto</th>
                                    <th class="text-center rounded-end" style="width: 150px;">Quantidade</th>
                                </tr>
                            </thead>
                            <tbody id="topProductsTableBody">
                                <tr><td colspan="2" class="text-center text-muted py-3">A carregar...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js/dist/chart.umd.min.js"></script>
    <script type="module" src="~/js/report/statistics.js"></script>
}