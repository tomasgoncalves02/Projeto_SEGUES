@{
    ViewData["Title"] = "Estatisticas do Refeitório - Admin";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">Estatísticas Refeitório</h2>
        </div>
        <a asp-area="Report" asp-controller="ReportStatistics" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm px-4 order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Period filter *@
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3">
                <div class="card-body p-3">
                    <label class="form-label fw-semibold small mb-1">Data</label>
                    <select id="selectTicketsPeriod" class="form-select shadow-none">
                        <option value="1" selected>Dia</option>
                        <option value="2">Semana</option>
                        <option value="3">Mês</option>
                        <option value="4">Ano</option>
                        <option value="5">Total</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row g-3 mb-4">
        @* Total used tickets *@
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <p class="small fw-semibold text-muted mb-1">Total de Senhas Utilizadas</p>
                    <h3 class="fw-bold mb-1 text-color-ips" id="totalUsedTickets">—</h3>
                </div>
            </div>
        </div>
        @* Total revenue *@
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <p class="small fw-semibold text-muted mb-1">Receita Total</p>
                    <h3 class="fw-bold mb-1 text-color-ips" id="totalIncomeCanteen">—</h3>
                </div>
            </div>
        </div>
        @* Average revenue *@
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <p class="small fw-semibold text-muted mb-1">Receita Média</p>
                    <h3 class="fw-bold mb-1 text-color-ips" id="averageIncomeCanteen">—</h3>
                </div>
            </div>
        </div>
        @* Total unique clients *@
        <div class="col-md-3">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <p class="small fw-semibold text-muted mb-1">Total de Clientes</p>
                    <h3 class="fw-bold mb-1 text-color-ips" id="totalBuyersCanteen">—</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @* Line chart *@
        <div class="col-lg-7">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-1 text-color-ips">Refeições ao longo do tempo</h6>
                    <p class="text-muted small mb-3" id="ticketChartSubtitle">Refeições por hora hoje</p>
                    <div style="position: relative; height: 260px;">
                        <canvas id="ticketsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        @* Tickets per user category *@
        <div class="col-lg-5">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3 text-color-ips">Senhas utilizadas por categoria de cliente</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                                <div class="card-body p-3">
                                    <p class="small fw-semibold text-muted mb-1">Estudante</p>
                                    <h3 class="fw-bold mb-1 text-color-ips" id="usedStudentTickets">—</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                                <div class="card-body p-3">
                                    <p class="small fw-semibold text-muted mb-1">Externo</p>
                                    <h3 class="fw-bold mb-1 text-color-ips" id="usedExternalTickets">—</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                                <div class="card-body p-3">
                                    <p class="small fw-semibold text-muted mb-1">Trabalhador IPS</p>
                                    <h3 class="fw-bold mb-1 text-color-ips" id="usedWorkerTickets">—</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js/dist/chart.umd.min.js"></script>
    <script type="module" src="~/js/report/statistics.js"></script>
}