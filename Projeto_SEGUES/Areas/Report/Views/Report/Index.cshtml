@{
    ViewData["Title"] = "Histórico";
}

<div class="container mt-5">
    @* Page Header *@
    <div class="d-flex justify-content-between align-items-center col-12 col-md-auto mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h1 class="fw-bold display-6 mb-1 title-underline">Histórico</h1>
            <p class="text-muted small mt-1 mb-0">Consulta aqui os seus consumos de bar, refeitório e movimentos de saldo.</p>
        </div>
        @* Return button *@
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Main row *@
    <div class="row g-4">
        @* Ticket history *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-clock-history"></i></div>
                    <h5 class="fw-bold">Histórico de Senhas</h5>
                    <p class="text-muted small mb-4">Visualiza o registo das suas senhas.</p>
                    <div class="mt-auto">
                        <a asp-area="Report" asp-controller="ReportTicket" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">
                            Ver Histórico
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* Bar history *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cup-straw"></i></div>
                    <h5 class="fw-bold">Histórico do Bar</h5>
                    <p class="text-muted small mb-4">Visualiza os seus consumos no bar.</p>
                    <div class="mt-auto">
                        <a asp-area="Report" asp-controller="ReportOrder" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">
                            Ver Histórico
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* Balance history *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-currency-euro"></i></div>
                    <h5 class="fw-bold">Histórico do Saldo</h5>
                    <p class="text-muted small mb-4">Visualiza os seus movimentos de conta.</p>
                    <div class="mt-auto">
                        <a asp-area="Report" asp-controller="ReportTransaction" asp-action="Index"
                           class="btn w-100 py-2 fw-bold btn-ips">
                            Ver Movimentos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>