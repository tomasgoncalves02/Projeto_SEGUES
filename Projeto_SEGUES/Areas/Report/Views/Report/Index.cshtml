@{
    ViewData["Title"] = "Histórico - SEGUES";
}

<div class="container mt-5">
    <div class="row mb-5">
        @* Left aligned text *@
        <div class="col-12 text-start">
            <h1 class="fw-bold title-underline mb-3">Histórico</h1>
            <p class="text-muted fs-5">Consulta aqui os teus consumos de bar, refeitório e movimentos de saldo.</p>
        </div>
    </div>

    @* Main row *@
    <div class="row g-4">
        @* Ticket history *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-clock-history"></i></div>
                    <h5 class="fw-bold">Histórico de Senhas</h5>
                    <p class="text-muted small mb-4">Visualiza o registo das tuas senhas.</p>
                    <div class="mt-auto">
                        <a asp-area="Report" asp-controller="ReportTickets" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">
                            Ver Histórico
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* Bar history *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cup-straw"></i></div>
                    <h5 class="fw-bold">Histórico do Bar</h5>
                    <p class="text-muted small mb-4">Visualiza os teus consumos no bar.</p>
                    <div class="mt-auto">
                        <a asp-area="Report" asp-controller="ReportOrder" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">
                            Ver Histórico
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* Balance history *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-currency-euro"></i></div>
                    <h5 class="fw-bold">Histórico do Saldo</h5>
                    <p class="text-muted small mb-4">Visualiza os teus movimentos de conta.</p>
                    <div class="mt-auto">
                        <a asp-area="Report" asp-controller="ReportTransaction" asp-action="Index"
                           class="btn w-100 py-2 fw-bold btn-ips">
                            Ver Movimentos
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* Return button *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-arrow-left-circle"></i></div>
                    <h5 class="fw-bold">Voltar</h5>
                    <p class="text-muted small mb-4">Voltar à página anterior.</p>
                    <div class="mt-auto">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Voltar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>