@{
    ViewData["Title"] = "Estatisticas"; 
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">@ViewData["Title"]</h2>
            <p class="text-muted small mb-0 mt-1">Visualize as estatísticas do refeitório e do bar</p>
        </div>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4 shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Cards *@
    <div class="row g-4 justify-content-center">
        @* Order Statistics *@
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="card-ips-icon mb-4">
                        <i class="bi bi-graph-up-arrow fs-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Estatísticas do Bar</h3>
                    <p class="text-muted">Visualizar estatísticas correspondentes ao Bar</p>

                    <div class="mt-auto pt-3">
                        <a asp-area="Report" asp-controller="ReportStatisticsOrder" asp-action="Index"
                           class="btn btn-ips w-100 py-2 fw-bold">
                            Ver estatísticas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Ticket Statistics *@
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="card-ips-icon mb-4">
                        <i class="bi bi-graph-up-arrow fs-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Estatísticas do Refeitório</h3>
                    <p class="text-muted">Visualizar estatísticas correspondentes ao Refeitório</p>

                    <div class="mt-auto pt-3">
                        <a asp-area="Report" asp-controller="ReportStatisticsTicket" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">
                            Ver estatísticas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
