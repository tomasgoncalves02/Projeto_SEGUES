@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>
@using Projeto_SEGUES.Models.Enums

@{
    ViewData["Title"] = "Histórico de Senhas - SEGUES";
}

<div class="container mt-4">
    @* Top row *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-clock-history me-2 text-color-ips"></i>
                Histórico de Senhas
            </h2>
            <p class="text-muted small">Consulta detalhada de todas as tuas movimentações e utilizações.</p>
        </div>
        <div class="col-md-5 text-end">
            <a asp-area="Report" asp-controller="Report" asp-action="Index" style="border: 2px solid #009697; color: #009697; border-radius: 8px;">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @* Filter row *@
    <div class="card shadow-sm mb-4 card-ips filter-bar">
        <div class="card-body py-3">
            <form asp-area="Report" asp-controller="ReportTickets" asp-action="Index" method="get" class="row g-3 align-items-end">

                @* State filter *@
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">ESTADO</label>
                    <select name="stateFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        <option value="Available" selected="@(ViewData["CurrentState"]?.ToString() == "Available")">Disponível</option>
                        <option value="Used" selected="@(ViewData["CurrentState"]?.ToString() == "Used")">Utilizada</option>
                        <option value="Expired" selected="@(ViewData["CurrentState"]?.ToString() == "Expired")">Expirada</option>
                    </select>
                </div>

                @* Data filter *@
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted text-nowrap">COMPRADAS DESDE</label>
                    <input type="date" name="dateFilter" class="form-control form-control-sm"
                           value="@(ViewData["CurrentDate"] is DateTime dt ? dt.ToString("yyyy-MM-dd") : "")"
                           onchange="this.form.submit()">
                </div>

                @* Flow filter *@
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">ORIGEM/DESTINO</label>
                    <select name="flowFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todas</option>
                        <option value="Compradas" selected="@(ViewData["CurrentFlow"]?.ToString() == "Compradas")">Compradas</option>
                        <option value="Enviadas" selected="@(ViewData["CurrentFlow"]?.ToString() == "Enviadas")">Enviadas</option>
                        <option value="Recebidas" selected="@(ViewData["CurrentFlow"]?.ToString() == "Recebidas")">Recebidas</option>
                    </select>
                </div>

                @* Search filter *@
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">PESQUISAR</label>
                    <input type="text" name="searchString" class="form-control form-control-sm"
                           placeholder="Código ou Nome..." value="@ViewData["CurrentSearch"]">
                </div>

                @* Botões Alinhados - Limpar à esquerda do botão grande *@
                <div class="col-md-3">
                    <div class="d-flex align-items-center justify-content-end gap-3">
                        <a asp-area="Report" asp-controller="ReportTickets" asp-action="Index"
                           class="text-muted small text-decoration-none text-nowrap">
                            Limpar Filtros <i class="bi bi-x-circle-fill"></i>
                        </a>
                        <button type="submit" class="btn btn-ips fw-bold px-4 py-2 text-nowrap">
                            <i class="bi bi-search me-2"></i> PESQUISAR
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Table *@
    <div class="card shadow-sm card-ips">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Data Compra</th>
                        <th>Estado</th>
                        <th>Validade</th>
                        <th>Data Uso</th>
                        <th>Data Transf.</th>
                        <th>Transferido Para</th>
                        <th>Recebido De</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-ticket-perforated display-6 d-block mb-3 opacity-25"></i>
                                <span class="fw-bold">Nenhum registo encontrado.</span><br>
                                <small>Tenta ajustar os filtros de pesquisa.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var currentUserId = ViewBag.CurrentUserId as string;
                            var transfer = item.Transfers?.OrderByDescending(t => t.TransferDate).FirstOrDefault();

                            <tr>
                                <td class="ps-4">
                                    <code class="fw-bold text-color-ips fs-6">@item.ValidationCode</code>
                                </td>
                                <td class="small">@item.TicketPurchase.TransactionDate.ToString("dd/MM/yyyy")</td>
                                
                                @* State *@
                                <td>
                                    @if (item.State == TicketState.Available)
                                    {
                                        <span class="badge bg-color-ips">Disponível</span>
                                    }
                                    else if (item.State == TicketState.Used)
                                    {
                                        <span class="badge bg-secondary">Utilizada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Expirada</span>
                                    }
                                </td>
                                
                                <td class="small">@item.ExpirationDate.ToString("dd/MM/yyyy")</td>
                                <td class="small fw-bold text-muted">@(item.UsedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="small">@(transfer?.TransferDate.ToString("dd/MM/yyyy") ?? "-")</td>
                                
                                @* Tranfer to *@
                                <td>
                                    @if (transfer != null && transfer.Sender.Id == currentUserId)
                                    {
                                        <span class="text-dark small fw-bold">
                                            <i class="bi bi-person-up text-danger me-1"></i>
                                            @transfer.Receiver?.FirstName @transfer.Receiver?.LastName
                                        </span>
                                    }
                                    else
                                    {

                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                
                                @* Received from *@
                                <td>
                                    @if (transfer != null && transfer.Receiver?.Id == currentUserId)
                                    {
                                        <span class="text-dark small fw-bold">
                                            <i class="bi bi-person-down text-success me-1"></i>
                                            @transfer.Sender?.FirstName @transfer.Sender?.LastName
                                        </span>
                                    }
                                    else if (transfer == null)
                                    {
                                        <span class="badge bg-light text-muted border small">Compra Própria</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>