@using Projeto_SEGUES.Models.Enums
@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Histórico de Senhas - SEGUES";
}

<div class="container mt-4">
    @* Cabeçalho *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-clock-history me-2 text-color-ips"></i> Histórico de Senhas
            </h2>
            <p class="text-muted small">Consulta detalhada de todas as tuas movimentações.</p>
        </div>
        <div class="col-md-5 text-end">
            <a asp-area="Report" asp-controller="Report" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @* Seção de Filtros com HTMX *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body p-4">
            <form id="filterForm"
                  hx-get="/Report/ReportTickets/GetFilteredHistory"
                  hx-trigger="change, keyup delay:300ms from:#searchFilter"
                  hx-target="#historyTableBody"
                  hx-indicator=".loader-spinner"
                  class="row g-3 align-items-end">

                <div class="col-md-4 col-xl-2">
                    <label class="form-label small fw-bold">Estado</label>
                    <select name="stateFilter" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        <option value="Available">Disponível</option>
                        <option value="Used">Utilizada</option>
                        <option value="Expired">Expirada</option>
                    </select>
                </div>

                <div class="col-md-4 col-xl-2">
                    <label class="form-label small fw-bold">A partir de</label>
                    <input type="date" name="dateFilter" class="form-control form-control-sm">
                </div>

                <div class="col-md-4 col-xl-2">
                    <label class="form-label small fw-bold">Fluxo</label>
                    <select name="flowFilter" class="form-select form-select-sm">
                        <option value="">Todas</option>
                        <option value="Compradas">Compradas</option>
                        <option value="Enviadas">Enviadas</option>
                        <option value="Recebidas">Recebidas</option>
                    </select>
                </div>

                <div class="col-md-6 col-xl">
                    <label class="form-label small fw-bold">Pesquisar</label>
                    <input id="searchFilter" type="text" name="searchString" class="form-control form-control-sm"
                           placeholder="Código ou Nome...">
                </div>

                <div class="col-md-4 col-xl-auto">
                    <div class="d-flex align-items-center gap-2">
                        <a asp-action="Index" class="btn btn-sm btn-reset-x">Limpar</a>
                        <div class="spinner-border spinner-border-sm text-primary htmx-indicator loader-spinner" role="status"></div>
                        <button type="submit" class="btn btn-ips fw-bold px-3 py-2 shadow-sm d-flex align-items-center">
                            <i class="bi bi-search me-2"></i> PESQUISAR
                            <div class="spinner-border spinner-border-sm text-white htmx-indicator loader-spinner ms-2" role="status"></div>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Tabela *@
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive" style="max-height: 500px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white" style="position: sticky; top: 0; z-index: 2;">
                    <tr>
                        <th class="ps-4 py-3 text-start">Código</th>
                        <th class="py-3">Data Compra</th>
                        <th class="py-3">Estado</th>
                        <th class="py-3">Validade</th>
                        <th class="py-3">Data Uso</th>
                        <th class="py-3">Data Transf.</th>
                        <th class="py-3">Transferido Para</th>
                        <th class="pe-4 py-3">Recebido De</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody"
                       hx-get="/Report/ReportTickets/GetFilteredHistory"
                       hx-trigger="every 2s"
                       hx-include="#filterForm"
                       hx-swap="innerHTML">
                    <partial name="_TicketHistoryRows" model="Model" />
                </tbody>
            </table>
        </div>
    </div>
</div>