@using Projeto_SEGUES.Models.Enums
@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Histórico de Senhas - SEGUES";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container mt-4">
    @* Cabeçalho *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-clock-history me-2 text-color-ips"></i>
                Histórico de Senhas
            </h2>
            <p class="text-muted small">Consulta detalhada de todas as tuas movimentações e utilizações.</p>
        </div>
        <div class="col-md-5 text-end">
            <a asp-area="Report" asp-controller="Report" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @* Seção de Filtros *@
    <div class="card card-ips shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-area="Report" asp-controller="ReportTickets" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4 col-xl-2">
                    <label for="stateFilter" class="form-label small fw-bold">Estado</label>
                    <select id="stateFilter" name="stateFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        <option value="Available" selected="@(ViewData["CurrentState"]?.ToString() == "Available")">Disponível</option>
                        <option value="Used" selected="@(ViewData["CurrentState"]?.ToString() == "Used")">Utilizada</option>
                        <option value="Expired" selected="@(ViewData["CurrentState"]?.ToString() == "Expired")">Expirada</option>
                    </select>
                </div>

                <div class="col-md-4 col-xl-2">
                    <label for="dateFilter" class="form-label small fw-bold text-nowrap">Compradas Em</label>
                    <input id="dateFilter" type="date" name="dateFilter" class="form-control form-control-sm"
                           value="@(ViewData["CurrentDate"] is DateTime dt ? dt.ToString("yyyy-MM-dd") : "")"
                           onchange="this.form.submit()">
                </div>

                <div class="col-md-4 col-xl-2">
                    <label for="flowFilter" class="form-label small fw-bold">Origem/Destino</label>
                    <select id="flowFilter" name="flowFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Todas</option>
                        <option value="Compradas" selected="@(ViewData["CurrentFlow"]?.ToString() == "Compradas")">Compradas</option>
                        <option value="Enviadas" selected="@(ViewData["CurrentFlow"]?.ToString() == "Enviadas")">Enviadas</option>
                        <option value="Recebidas" selected="@(ViewData["CurrentFlow"]?.ToString() == "Recebidas")">Recebidas</option>
                    </select>
                </div>

                <div class="col-md-6 col-xl">
                    <label for="searchFilter" class="form-label small fw-bold">Pesquisar</label>
                    <input id="searchFilter" type="text" name="searchString" class="form-control form-control-sm"
                           placeholder="Código ou Nome..." value="@ViewData["CurrentSearch"]" onchange="this.form.submit()">
                </div>

                <div class="col-md-4 col-xl-auto text-end text-xl-start">
                    <div class="d-flex align-items-center gap-3">
                        <a asp-area="Report" asp-controller="ReportTickets" asp-action="Index"
                           class="text-muted small text-decoration-none btn-reset-x">
                            Limpar <i class="bi bi-x-circle ms-1"></i>
                        </a>
                        <button type="submit" class="btn btn-ips fw-bold px-3 py-2 shadow-sm">
                            <i class="bi bi-search me-2"></i> PESQUISAR
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Tabela de Dados *@
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white" style="position: sticky; top: 0; z-index: 2;">
                    <tr>
                        <th class="ps-4 py-3 text-start">Código</th>
                        <th class="py-3">Data Compra</th>
                        <th class="py-3">Estado</th>
                        <th class="py-3">Validade</th>
                        <th class="py-3">Data Uso</th>
                        <th class="py-3">Data Transf.</th>
                        <th class="py-3">Transferido Para</th>
                        <th class="pe-4 py-3">Recebido De</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-ticket-perforated display-4 d-block mb-3 opacity-25"></i>
                                <span class="fw-bold">Nenhum registo encontrado.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            // Encontra a transferência mais recente para verificar se eu fui o remetente
                            var lastTransfer = item.Transfers.OrderByDescending(t => t.TransferDate).FirstOrDefault();

                            // Lógica Central: Eu enviei esta senha?
                            bool euEnviei = lastTransfer != null && lastTransfer.Sender?.Id == currentUserId;

                            <tr>
                                <td class="ps-4 text-start">
                                    @if (euEnviei)
                                    {
                                        <span class="text-muted small italic">Oculto (Enviada)</span>
                                    }
                                    else
                                    {
                                        <code class="fw-bold text-color-ips bg-light px-2 py-1 rounded">@item.ValidationCode</code>
                                    }
                                </td>
                                <td>@(euEnviei ? "---" : item.TicketPurchase.TransactionDate.ToString("dd/MM/yyyy"))</td>
                                <td>
                                    @if (euEnviei)
                                    {
                                        @* Para quem enviou, o estado visual é sempre "Transferida" *@
                                        <span class="badge bg-secondary px-3">Transferida</span>
                                    }
                                    else
                                    {
                                        @* Para quem recebeu (ou comprou), mostra o estado REAL (Disponível, Usada, etc) *@
                                        <span class="badge @item.State.ToString().ToBadgeClass() px-3">
                                            @item.State.ToDisplayName()
                                        </span>
                                    }
                                </td>
                                <td>@(euEnviei ? "---" : item.ExpirationDate.ToString("dd/MM/yyyy"))</td>
                                <td>@(euEnviei ? "---" : (item.UsedDate?.ToString("dd/MM/yyyy") ?? "-"))</td>
                                <td>@(lastTransfer?.TransferDate.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>
                                    @if (lastTransfer != null && lastTransfer.Sender?.Id == currentUserId)
                                    {
                                        <span class="text-dark small fw-bold">
                                            <i class="bi bi-person-up text-danger me-1"></i>
                                            @lastTransfer.Receiver?.FirstName @lastTransfer.Receiver?.LastName
                                        </span>
                                    }
                                    else
                                    {

                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="pe-4">
                                    @if (lastTransfer != null && lastTransfer.Receiver?.Id == currentUserId)
                                    {
                                        <span class="text-dark small fw-bold">
                                            <i class="bi bi-person-down text-success me-1"></i>
                                            @lastTransfer.Sender?.FirstName @lastTransfer.Sender?.LastName
                                        </span>
                                    }
                                    else if (lastTransfer == null)
                                    {
                                        <span class="badge bg-light text-muted border small">Compra Própria</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>