@model IEnumerable<Projeto_SEGUES.Models.Payment.Transaction>

@if (!Model.Any())
{
    <tr>
        <td colspan="5" class="text-center py-5 text-muted">
            <i class="bi bi-wallet2 display-4 d-block mb-3 opacity-50 text-color-ips"></i>
            <span class="fw-bold">Ainda não tens movimentos na tua conta.</span>
        </td>
    </tr>
}
else
{
    @foreach (var item in Model)
    {
        bool isPositive = item.Amount > 0;
        bool isPurchase = item.Amount < 0;
        bool isRefund = isPositive && item.Reference.Equals("Cancelamento", StringComparison.OrdinalIgnoreCase);
        string icon = "bi-cash-stack";
        string label = "Carregamento";

        if (isPurchase)
        {
            icon = "bi-cart-dash";
            label = "Compra";
        }
        else if (isRefund)
        {
            icon = "bi-arrow-counterclockwise";
            label = "Reembolso";
        }
        bool isCompleted = item.IsPaid || isPurchase || isRefund;

        <tr class="align-middle">
            @* Date *@
            <td class="ps-4">
                <div class="fw-bold">@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                <div class="small text-muted">@item.CreatedAt.ToString("HH:mm")</div>
            </td>
            @* Description *@
            <td>
                <div class="d-flex align-items-center justify-content-center">
                    <i class="bi @icon me-2 text-color-ips fs-5"></i>
                    <div>
                        <div class="fw-bold mb-1">@label</div>
                        <div class="small text-muted text-truncate" style="max-width: 250px;" title="@(item.Description ?? item.Reference)">
                            @(item.Description ?? item.Reference)
                        </div>
                    </div>
                </div>
            </td>
            @* Status *@
            <td>
                @if (isCompleted)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 shadow-sm">Concluído</span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-2 shadow-sm">Pendente</span>
                }
            </td>
            @* Reference *@
            <td>
                <code class="small text-muted bg-color-ips-light px-2 py-1 border rounded">@(item.Reference)</code>
            </td>
            @* Amount *@
            <td class="pe-4">
                <span class="fw-bold fs-5 @(isPositive ? "text-success" : "text-danger")">
                    @(isPositive ? "+" : "")@item.Amount.ToString("C")
                </span>
            </td>
        </tr>
    }
}