@page
@model Projeto_SEGUES.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir Senha";
}

<div class="container py-2 px-lg-5">
    <div class="card shadow-lg card-ips hover-shadow-ips border-0 d-flex flex-column mx-lg-6">
        @* Padding p-3 in mobile, p-5 in tablet/desktop *@
        <div class="card-body p-3 p-sm-4 p-md-5 d-flex flex-column text-center justify-content-center">
            
            <div class="mb-4 mb-md-5 text-center d-flex flex-column align-items-center">
                <h1 class="fw-bold display-6 display-md-5 mb-2 title-underline">SEGUES</h1>
                <p class="text-muted fs-6 fs-md-5 mb-1">Redefinir Password</p>
                <p class="text-muted small mb-0">Crie uma nova password para aceder à sua conta.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>
                
                @* Required Hidden Inputs *@
                <input asp-for="Input.Code" type="hidden" />
                <input asp-for="Input.Email" type="hidden" />

                @* Password *@
                <div class="mb-3 mb-md-4 text-start">
                    <div class="input-group">
                        <div class="form-floating w-100">
                            <input asp-for="Input.Password" class="form-control" id="passwordInput"
                                   autocomplete="new-password" aria-required="true" placeholder="Nova senha"
                                   style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                            <label for="passwordInput">Password</label>
                        </div>
                        <button class="btn btn-ips-outline-secondary px-3" type="button" id="togglePassword"
                                style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px;">
                            <i class="bi bi-eye fs-5"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                @* Confirm Password *@
                <div class="mb-3 mb-md-4 text-start">
                    <div class="input-group">
                        <div class="form-floating w-100">
                            <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPasswordInput"
                                   autocomplete="new-password" aria-required="true" placeholder="Confirmar Senha"
                                   style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                            <label for="confirmPasswordInput">Confirmar Password</label>
                        </div>
                        <button class="btn btn-ips-outline-secondary px-3" type="button" id="toggleConfirmPassword"
                                style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px;">
                            <i class="bi bi-eye fs-5"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                @* Submit button *@
                <button type="submit" class="w-100 btn btn-ips btn-lg py-2 py-md-3 fw-bold shadow-sm mb-4">
                    <i class="bi bi-shield-lock me-2"></i>Redefinir Password
                </button>
            </form>

            <div class="mt-2 text-center">
                <p class="small text-muted mb-0">
                    <a asp-page="./Login" class="fw-bold">
                        <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
                    </a>
                </p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/identity/password.js"></script>
}