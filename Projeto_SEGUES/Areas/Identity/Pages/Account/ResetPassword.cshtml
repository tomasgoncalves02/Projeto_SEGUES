@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir Senha - SEGUES";
}

@* Main container *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-5">
            @* Card with top line in institucional color *@
            <div class="card shadow-lg card-ips hover-shadow-ips">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h1 class="fw-bold display-6 text-dark">SEGUES</h1>
                        <h2 class="fs-5 mb-3">Redefinir Password</h2>
                        @* Underline in IPS color *@
                        <hr class="mx-auto title-underline"/>
                        <p class="text-muted small">Crie uma nova password para aceder à sua conta.</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                        <input asp-for="Input.Code" type="hidden" />
                        <input asp-for="Input.Email" type="hidden" />

                        @* New password with view toggle *@
                        <div class="mb-4">
                            <div class="input-group">
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Input.Password" class="form-control" id="passwordInput" autocomplete="new-password" aria-required="true" placeholder="Nova senha" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                                    <label for="passwordInput" class="form-label">Password</label>
                                </div>
                                <button class="btn btn-ips-outline-secondary px-3" type="button" id="togglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                    <i class="bi bi-eye fs-5"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        @* Confirmar Password *@
                        <div class="mb-4">
                            <div class="input-group">
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPasswordInput" autocomplete="new-password" aria-required="true" placeholder="Confirmar Senha" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                                    <label for="confirmPasswordInput" class="form-label">Confirmar Password</label>
                                </div>
                                <button class="btn btn-ips-outline-secondary px-3" type="button" id="toggleConfirmPassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                    <i class="bi bi-eye fs-5"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                        @* Submit button *@
                        <button type="submit" class="w-100 btn btn-lg py-3 fw-bold shadow-sm mb-4 btn-ips">
                            <i class="bi bi-shield-lock me-2"></i>REDEFINIR PASSWORD
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <a asp-page="./Login" class="fw-bold">
                            <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/identity/password.js"></script>
}