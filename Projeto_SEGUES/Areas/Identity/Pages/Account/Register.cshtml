@page
@using Projeto_SEGUES.Models.Enums
@model RegisterModel

@{
    ViewData["Title"] = "Criar Conta - SEGUES";
}

<div class="container py-2 px-lg-5">
    <div class="card shadow-lg card-ips hover-shadow-ips border-0 d-flex flex-column mx-lg-6">
        @* Padding p-3 in mobile, p-5 in tablet/desktop *@
        <div class="card-body p-3 p-sm-4 p-md-5 d-flex flex-column text-center justify-content-center">
            <div class="mb-4 mb-md-5 text-center d-flex flex-column align-items-center">
                <h1 class="fw-bold display-6 display-md-5 mb-2 title-underline">SEGUES</h1>
                <p class="text-muted fs-6 fs-md-5 mb-0">Crie a sua nova conta</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>

                @* Name *@
                <div class="row g-3 mb-3 mb-md-4 text-start">
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" placeholder="Nome"/>
                            <label asp-for="Input.FirstName">Primeiro Nome</label>
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Sobrenome"/>
                            <label asp-for="Input.LastName">Sobrenome</label>
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                @* Email *@
                <div class="form-floating mb-3 mb-md-4 text-start">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                @* Gender and BirthDate *@
                <div class="row g-3 mb-3 mb-md-4 text-start">
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <select asp-for="Input.Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                <option selected="selected" value="">Selecione...</option>
                            </select>
                            <label asp-for="Input.Gender">Género</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Input.BirthDate" class="form-control" type="date" aria-required="true" value="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                            <label asp-for="Input.BirthDate">Data Nascimento</label>
                        </div>
                    </div>
                    <div class="col-12 mt-1">
                        <span asp-validation-for="Input.Gender" class="text-danger small d-block mb-1"></span>
                        <span asp-validation-for="Input.BirthDate" class="text-danger small"></span>
                    </div>
                </div>

                @* Passwords *@
                <div class="mb-3 mb-md-4 text-start">
                    <div class="input-group">
                        <div class="form-floating w-100">
                            <input asp-for="Input.Password" class="form-control" id="passwordInput" autocomplete="new-password" aria-required="true" placeholder="password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;"/>
                            <label for="passwordInput">Password</label>
                        </div>
                        <button class="btn btn-ips-outline-secondary px-3" type="button" id="togglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px;">
                            <i class="bi bi-eye fs-5"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 text-start">
                    <div class="input-group">
                        <div class="form-floating w-100">
                            <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPasswordInput" autocomplete="new-password" aria-required="true" placeholder="password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;"/>
                            <label for="confirmPasswordInput">Confirmar Password</label>
                        </div>
                        <button class="btn btn-ips-outline-secondary px-3" type="button" id="toggleConfirmPassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px;">
                            <i class="bi bi-eye fs-5"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button id="registerSubmit" type="submit" class="w-100 btn btn-ips btn-lg py-2 py-md-3 fw-bold shadow-sm mb-4">
                    <i class="bi bi-person-plus me-2"></i>Registar
                </button>
            </form>

            <div class="text-center mt-2">
                <p class="small text-muted mb-2">
                    Já tem conta? <a asp-page="./Login" class="fw-bold">Faça Login aqui</a>
                </p>
                <p class="small text-muted mb-0">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="fw-bold">Voltar à página inicial.</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/identity/password.js"></script>
}