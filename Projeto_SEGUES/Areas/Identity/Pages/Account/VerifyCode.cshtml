@page
@model Projeto_SEGUES.Areas.Identity.Pages.Account.VerifyCodeModel
@{
    ViewData["Title"] = "Validar Conta - SEGUES";
}

<div class="container py-2 px-lg-5">
    <div class="card shadow-lg card-ips hover-shadow-ips border-0 d-flex flex-column mx-lg-6">
        @* Padding p-3 in mobile, p-5 in tablet/desktop *@
        <div class="card-body p-3 p-sm-4 p-md-5 d-flex flex-column text-center justify-content-center">
            
            <div class="mb-4 mb-md-5 text-center d-flex flex-column align-items-center">
                @* Icon *@
                <div class="card-ips-icon mb-3 text-color-ips">
                    <i class="bi bi-patch-check display-4"></i>
                </div>
                
                <h1 class="fw-bold display-6 display-md-5 mb-2 title-underline">SEGUES</h1>
                <p class="text-muted fs-6 fs-md-5 mb-2">Verificação de Conta</p>
                <p class="text-muted small mb-0">Introduza o código enviado para <strong>@Model.UserEmailDisplay</strong></p>
            </div>

            <form method="post" id="verificationCodeForm" asp-page-handler="">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>

                @* Verification Code Input *@
                <div class="mb-3 mb-md-4 text-start px-md-4">
                    <label for="verificationCodeInput" class="form-label fw-bold text-muted small ms-1">Código de Verificação</label>
                    <input asp-for="Input.Code" id="verificationCodeInput" class="form-control form-control-lg text-center fw-bold code-input"
                           placeholder="000000" maxlength="6" inputmode="numeric" pattern="[0-9]*" autofocus required />
                    <span asp-validation-for="Input.Code" class="text-danger small d-block text-center mt-1"></span>
                </div>

                @* Main button *@
                <button type="submit" class="w-100 btn btn-ips btn-lg py-2 py-md-3 fw-bold shadow-sm mb-4">
                    <i class="bi bi-check-circle me-2"></i>Confirmar e Entrar
                </button>
            </form>

            <div class="mt-2 text-center">
                @* Resend Code *@
                <div class="small text-muted mb-4 d-flex align-items-center justify-content-center">
                    <span class="me-2">Não recebeu o código?</span>
                    <form asp-page-handler="ResendCode" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-ips py-1 px-3 fw-bold shadow-sm">
                            Reenviar
                        </button>
                    </form>
                </div>
                
                <p class="small text-muted mb-2">
                    <a asp-page="./Login" class="fw-bold">
                        <i class="bi bi-arrow-left me-1"></i>Voltar ao Login
                    </a>
                </p>
                <p class="small text-muted mb-0">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="fw-bold">Voltar à página inicial.</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/identity/email.js"></script>
}