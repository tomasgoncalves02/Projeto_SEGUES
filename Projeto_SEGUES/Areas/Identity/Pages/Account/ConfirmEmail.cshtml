@page
@model Projeto_SEGUES.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "A confirmar email...";
}

<div class="container text-center py-5 mt-5">
    <div class="spinner-border text-ips" role="status" style="width: 3rem; height: 3rem;">
        <span class="visually-hidden">A carregar...</span>
    </div>
    <h2 class="mt-4 text-muted fs-4">A validar a sua conta...</h2>
    <p class="text-muted small">Por favor aguarde, será redirecionado em breve.</p>
</div>