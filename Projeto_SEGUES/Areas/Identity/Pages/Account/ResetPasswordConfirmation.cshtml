@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Redefinição Concluída - SEGUES";
}

@* Main container *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-5">
            @* Card with top line in institucional color *@
            <div class="card shadow-lg card-ips">
                <div class="card-body p-5">
                    @* Icon *@
                    <div class="card-ips-icon">
                        <i class="bi bi-check-circle-fill fs-1"></i>
                    </div>
                    <div class="text-center mb-5">
                        <h1 class="fw-bold display-6 text-dark mb-3">SEGUES</h1>
                        <h2 class="fs-5 mb-4">Senha Redefinida</h2>
                        @* Underline in IPS color *@
                        <hr class="mx-auto title-underline"/>

                        <p class="text-muted mb-5 fs-5">
                            A sua senha foi alterada com sucesso. <br/>
                            <strong>Agora já pode aceder à sua conta com as novas credenciais.</strong>
                        </p>
                        
                        @* Return button *@
                        <a asp-page="./Login" class="w-100 btn btn-lg py-3 fw-bold shadow-sm text-decoration-none btn-ips">
                            <i class="bi bi-arrow-left me-2"></i>VOLTAR AO LOGIN
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>