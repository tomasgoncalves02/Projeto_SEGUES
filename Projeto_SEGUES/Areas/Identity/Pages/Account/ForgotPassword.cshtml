@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Senha";
}

@* Main container *@
<div class="container py-2 px-lg-5">
    @* Card with top line in institucional color *@
    <div class="card shadow-lg card-ips hover-shadow-ips border-0 d-flex flex-column mx-lg-7">
        @* Padding p-3 in mobile, p-5 in tablet/desktop *@
        <div class="card-body p-3 p-sm-4 p-md-5 d-flex flex-column text-center justify-content-center">
            <div class="mb-4 mb-md-5 text-center d-flex flex-column align-items-center">
                <h1 class="fw-bold display-6 display-md-5 mb-2 title-underline">SEGUES</h1>
                <p class="text-muted fs-6 fs-md-5 mb-1">Recuperar Senha</p>
                <p class="text-muted small mb-0">Introduza o seu email para receber as instruções de recuperação.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>

                @* Email *@
                <div class="form-floating mb-3 mb-md-4">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com"/>
                    <label asp-for="Input.Email">Endereço de Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                @* Main button *@
                <button type="submit" class="w-100 btn btn-ips btn-lg py-2 py-md-3 fw-bold shadow-sm mb-4">
                    <i class="bi bi-key me-2"></i>Recuperar Senha
                </button>
            </form>

            <div class="mt-2 text-center">
                <p class="small text-muted mb-2">
                    Lembrou-se da senha? <a asp-page="./Login" class="fw-bold">Voltar ao Login</a>
                </p>
                <p class="small text-muted mb-0">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="fw-bold">Voltar à página inicial.</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}