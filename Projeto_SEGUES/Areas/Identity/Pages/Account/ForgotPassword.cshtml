@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Senha - SEGUES";
}

@* Main container *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-5">
            @* Card with top line in institucional color *@
            <div class="card shadow-lg card-ips hover-shadow-ips">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h1 class="fw-bold display-6 text-dark">SEGUES</h1>
                        <h2 class="fs-5 mb-3">Recuperar Senha</h2>
                        @* Underline in IPS color *@
                        <hr class="mx-auto title-underline"/>
                        <p class="text-muted small">Introduza o seu email para receber as instruções de recuperação.</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        @* Email *@
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                            <label asp-for="Input.Email" class="form-label">Endereço de Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        @* Main button *@
                        <button type="submit" class="w-100 btn btn-lg py-3 fw-bold shadow-sm mb-4 btn-ips">
                            <i class="bi bi-key me-2"></i>RECUPERAR ACESSO
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <p class="small text-muted">
                            Lembrou-se da senha? <a asp-page="./Login" class="fw-bold">Voltar ao Login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}