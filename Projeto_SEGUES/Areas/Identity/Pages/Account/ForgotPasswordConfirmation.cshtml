@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Email Enviado";
}

<style>
    /* Linha decorativa institucional em Teal */
    .title-underline {
        border-bottom: 4px solid #009697;
        display: inline-block;
        padding-bottom: 5px;
    }

    /* Ícone de sucesso animado ou estático com a cor da marca */
    .icon-circle {
        width: 80px;
        height: 80px;
        background-color: rgba(0, 150, 151, 0.1);
        color: #009697;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto 20px;
    }
</style>

@* 1. Contentor Principal: Alinhamento central para consistência com o Login *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-5">

            @* 2. Card com a borda superior característica de 6px em Teal *@
            <div class="card shadow-lg border-0 rounded-4 text-center" style="border-top: 6px solid #009697 !important;">
                <div class="card-body p-5">

                    @* Ícone de Instrução *@
                    <div class="icon-circle">
                        <i class="bi bi-envelope-paper-fill fs-1"></i>
                    </div>

                    <h1 class="fw-bold display-6 text-dark mb-3">SEGUES</h1>
                    <h2 class="fs-5 title-underline mb-4">Verifique o seu Email</h2>

                    <p class="text-muted mb-5">
                        Enviámos as instruções para a redefinição da sua senha. <br />
                        <strong>Por favor, verifique a sua caixa de entrada e a pasta de spam.</strong>
                    </p>

                    @* Botão de Retorno em Teal *@
                    <a asp-page="./Login" class="w-100 btn btn-lg py-3 fw-bold shadow-sm text-white"
                       style="background-color: #009697 !important; border: none; border-radius: 8px;">
                        <i class="bi bi-arrow-left me-2"></i>VOLTAR AO LOGIN
                    </a>

                    <hr class="my-4 opacity-0" /> @* Espaçador invisível *@

                    <p class="small text-muted">
                        Não recebeu o email? <a asp-page="./ForgotPassword" class="fw-bold text-decoration-none" style="color: #009697 !important;">Tente novamente</a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>