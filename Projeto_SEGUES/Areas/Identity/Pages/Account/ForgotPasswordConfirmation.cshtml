@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Email Enviado";
}

@* Main Container *@
<div class="container py-2 px-lg-5">
    @* Card with top line in institucional color *@
    <div class="card shadow-lg card-ips hover-shadow-ips border-0 d-flex flex-column mx-lg-7">
        @* Padding p-3 in mobile, p-5 in tablet/desktop *@
        <div class="card-body p-3 p-sm-4 p-md-5 d-flex flex-column text-center justify-content-center">
            
            <div class="mb-4 mb-md-5 text-center d-flex flex-column align-items-center">
                @* Icon *@
                <div class="card-ips-icon mb-3 text-color-ips">
                    <i class="bi bi-envelope-paper display-4"></i>
                </div>
                
                <h1 class="fw-bold display-6 display-md-5 mb-2 title-underline">SEGUES</h1>
                <p class="text-muted fs-6 fs-md-5 mb-2">Verifique o seu Email</p>
                
                <p class="text-muted small mb-0">
                    Enviámos as instruções para a redefinição da sua senha.<br />
                    <strong>Por favor, verifique a sua caixa de entrada e a pasta de spam.</strong>
                </p>
            </div>

            @* Return button *@
            <a asp-page="./Login" class="w-100 btn btn-ips btn-lg py-2 py-md-3 fw-bold shadow-sm mb-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar ao Login
            </a>

            <div class="mt-2 text-center">
                <p class="small text-muted mb-2">
                    Não recebeu o email? <a asp-page="./ForgotPassword" class="fw-bold">Tente novamente</a>
                </p>
                <p class="small text-muted mb-0">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="fw-bold">Voltar à página inicial.</a>
                </p>
            </div>
            
        </div>
    </div>
</div>