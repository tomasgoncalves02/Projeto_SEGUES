@page
@model EmailModel
@{
    ViewData["Title"] = "Alterar Email - SEGUES";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="row justify-content-center text-center">
    <div class="col-md-10 col-lg-8">
        <h3 class="fw-bold text-dark mb-4">@ViewData["Title"]</h3>
        <div class="card shadow-sm card-ips hover-shadow-ips border-0 d-flex flex-column">
            <div class="card-body p-3 p-md-4">
                <form id="email-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>

                    @* Current Email *@
                    <div class="mb-3 mb-md-4 text-start">
                        @if (Model.IsEmailConfirmed)
                        {
                            <div class="input-group">
                                <div class="form-floating w-100">
                                    <input asp-for="Email" class="form-control" placeholder="Email atual" disabled
                                           style="border-top-right-radius: 0; border-bottom-right-radius: 0;"/>
                                    <label asp-for="Email">Email Atual (Verificado)</label>
                                </div>
                                <span class="input-group-text text-success bg-white border-start-0"
                                      style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px; justify-content: center;">
                                    <i class="bi bi-patch-check fs-5"></i>
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="form-floating mb-2">
                                <input asp-for="Email" class="form-control" placeholder="Email atual" disabled/>
                                <label asp-for="Email">Email Atual (Não Verificado)</label>
                            </div>
                            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link p-0 small text-ips fw-bold">
                                Enviar email de verificação
                            </button>
                        }
                    </div>

                    @* New Email *@
                    <div class="mb-4 text-start">
                        <div class="form-floating">
                            <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Novo email"/>
                            <label asp-for="Input.NewEmail">Novo Email</label>
                        </div>
                        <span asp-validation-for="Input.NewEmail" class="text-danger small d-block mt-1"></span>
                    </div>

                    @* Action Buttons *@
                    <div class="d-flex flex-column gap-3 mt-4">
                        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-ips btn-lg py-2 fw-bold shadow-sm">
                            <i class="bi bi-envelope-check me-2"></i>Alterar Email
                        </button>

                        <a asp-controller="User" asp-action="Index" asp-area="User" class="w-100 btn btn-ips-outline-secondary py-2 fw-bold shadow-sm">
                            <i class="bi bi-arrow-left me-2"></i>Voltar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}