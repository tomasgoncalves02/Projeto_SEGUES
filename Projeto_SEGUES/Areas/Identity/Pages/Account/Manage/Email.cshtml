@page
@model EmailModel
@{
    ViewData["Title"] = "Alterar Email - SEGUES";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3 class="mb-4">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <div class="card card-ips shadow-sm border-0 p-4">
            <form id="email-form" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                @* Email Atual *@
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold">Email Atual</label>
                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="input-group flex-nowrap">
                            <div class="form-floating">
                                <input asp-for="Email" class="form-control" placeholder="Email atual" disabled
                                       style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                                <label asp-for="Email">Email Atual</label>
                            </div>
                            <span class="input-group-text text-success bg-white border-start-0"
                                  style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px; justify-content: center;">
                                <i class="bi bi-patch-check-fill fs-5"></i>
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="form-floating">
                            <input asp-for="Email" class="form-control" placeholder="Email atual" disabled />
                            <label asp-for="Email">Email Atual</label>
                        </div>
                        <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link p-0 small">
                            Enviar email de verificação
                        </button>
                    }
                </div>

                @* Novo Email *@
                <div class="mb-4">
                    <label asp-for="Input.NewEmail" class="form-label fw-bold">Novo Email</label>
                    <div class="form-floating">
                        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Novo email" />
                        <label asp-for="Input.NewEmail">Novo Email</label>
                        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
                    </div>
                </div>

                @* Botões de Ação *@
                <div class="d-flex flex-column gap-2">
                    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-ips fw-bold py-2 text-uppercase">
                        <i class="bi bi-envelope-check me-2"></i>Alterar Email
                    </button>

                    <a asp-controller="User" asp-action="Index" asp-area="User" class="w-100 btn btn-secondary fw-bold py-2 text-uppercase">
                        <i class="bi bi-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}