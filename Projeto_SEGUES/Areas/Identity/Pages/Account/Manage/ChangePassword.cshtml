@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar password - SEGUES";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="row justify-content-center text-center mx-lg-6">
    <div class="col-md-10 col-lg-8">
        <h3 class="fw-bold text-dark mb-1">@ViewData["Title"]</h3>
        <div class="card shadow-sm card-ips hover-shadow-ips border-0 d-flex flex-column">
            <div class="card-body p-3 p-md-4">
                <form id="change-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>

                    @* Current Atual *@
                    <div class="mb-3 mb-md-4 text-start">
                        <div class="input-group">
                            <div class="form-floating w-100">
                                <input asp-for="Input.OldPassword" class="form-control" id="oldPasswordInput"
                                       autocomplete="current-password" placeholder="Password atual"
                                       style="border-top-right-radius: 0; border-bottom-right-radius: 0;"/>
                                <label for="oldPasswordInput">Password Atual</label>
                            </div>
                            <button class="btn btn-ips-outline-secondary px-3" type="button" id="toggleOldPassword"
                                    style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px;">
                                <i class="bi bi-eye fs-5"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.OldPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    @* New Password *@
                    <div class="mb-3 mb-md-4 text-start">
                        <div class="input-group">
                            <div class="form-floating w-100">
                                <input asp-for="Input.NewPassword" class="form-control" id="passwordInput"
                                       autocomplete="new-password" placeholder="Nova password"
                                       style="border-top-right-radius: 0; border-bottom-right-radius: 0;"/>
                                <label for="passwordInput">Nova Password</label>
                            </div>
                            <button class="btn btn-ips-outline-secondary px-3" type="button" id="togglePassword"
                                    style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px;">
                                <i class="bi bi-eye fs-5"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    @* Confirm New Password *@
                    <div class="mb-4 text-start">
                        <div class="input-group">
                            <div class="form-floating w-100">
                                <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPasswordInput"
                                       autocomplete="new-password" placeholder="Confirmar nova password"
                                       style="border-top-right-radius: 0; border-bottom-right-radius: 0;"/>
                                <label for="confirmPasswordInput">Confirmar Nova Password</label>
                            </div>
                            <button class="btn btn-ips-outline-secondary px-3" type="button" id="toggleConfirmPassword"
                                    style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 50px;">
                                <i class="bi bi-eye fs-5"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    @* Action Buttons *@
                    <div class="d-flex flex-column gap-3 mt-4">
                        <button type="submit" class="w-100 btn btn-ips btn-lg py-2 fw-bold shadow-sm">
                            <i class="bi bi-key me-2"></i>Alterar Password
                        </button>

                        <a asp-area="User" asp-controller="User" asp-action="Index" class="w-100 btn btn-ips-outline-secondary py-2 fw-bold shadow-sm">
                            <i class="bi bi-arrow-left me-2"></i>Voltar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/identity/password.js"></script>
}