@page
@model LoginModel

@{
    ViewData["Title"] = "Entrar - SEGUES";
}

@* Main container *@
<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-md-8 col-lg-6">
            @* Card with top line in institucional color *@
            <div class="card shadow-lg card-ips">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <h1 class="fw-bold display-6 text-dark">SEGUES</h1>
                        <p class="text-muted fs-5">Controlo de Refeições - Login</p>
                        @* Underline in IPS color *@
                        <hr class="mx-auto title-underline"/>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        @* Email *@
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                            <label asp-for="Input.Email" class="form-label">Endereço de Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        @* Password with view toggle *@
                        <div class="mb-4">
                            <div class="input-group">
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Input.Password" class="form-control" id="passwordInput" autocomplete="current-password" aria-required="true" placeholder="password" style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                                    <label for="passwordInput" class="form-label">Password</label>
                                </div>
                                <button class="btn btn-ips-outline-secondary px-3" type="button" id="togglePassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                    <i class="bi bi-eye fs-5"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" style="width: 1.2em; height: 1.2em;"/>
                                <label class="form-check-label fs-6 ms-2" asp-for="Input.RememberMe">
                                    Lembrar-me
                                </label>
                            </div>
                            @* Forgot Password link *@
                            <a id="forgot-password" asp-page="./ForgotPassword" class="fw-bold">Esqueceu-se da senha?</a>
                        </div>

                        @* Main button to enter *@
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg py-3 fw-bold shadow-sm mb-4 btn-ips">
                            ENTRAR
                        </button>
                    </form>

                    <div class="d-flex align-items-center mb-4">
                        <hr class="flex-grow-1 text-muted">
                        <span class="mx-3 text-muted fw-bold small">OU ACEDA VIA</span>
                        <hr class="flex-grow-1 text-muted">
                    </div>

                    @* External Providers (Microsoft, etc.) *@
                    <section>
                        @{
                            if ((Model.ExternalLogins?.Count ?? 0) == 0)
                            {
                                <div class="alert alert-light border-0 text-center">
                                    <small class="text-muted italic">Login externo indisponível.</small>
                                </div>
                            }
                            else
                            {
                                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center py-3 rounded-3 shadow-sm" name="provider" value="@provider.Name">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 21 21" class="me-3">
                                                <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                                                <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                                                <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                                                <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                                            </svg>
                                            <span class="fw-bold">Entrar com Conta Microsoft</span>
                                        </button>
                                    }
                                </form>
                            }
                        }
                    </section>

                    <div class="mt-5 text-center">
                        @* Register link *@
                        <p class="fs-6">Ainda não tem conta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold">Registe-se aqui</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}