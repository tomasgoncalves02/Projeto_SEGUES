@page
@model LoginModel

@{
    ViewData["Title"] = "Entrar - SEGUES";
}

<div class="login-wrapper">
    <div class="login-card-container">

        <div class="card shadow-lg card-ips border-0">
            @* Padding responsivo: p-3 em mobile, p-5 em desktop *@
            <div class="card-body p-3 p-sm-4 p-md-5">

                <div class="text-center mb-4 mb-md-5">
                    <h1 class="fw-bold display-6 display-md-5 text-dark mb-2">SEGUES</h1>
                    <p class="text-muted fs-6 fs-md-5">Controlo de Refeições - Login</p>
                    <hr class="mx-auto title-underline" style="width: 50px; margin-top: 0;" />
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>

                    @* Email *@
                    <div class="form-floating mb-3 mb-md-4">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Endereço de Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger small text-break-all"></span>
                    </div>

                    @* Password *@
                    <div class="mb-3 mb-md-4">
                        <div class="input-group">
                            <div class="form-floating">
                                <input asp-for="Input.Password" class="form-control" id="passwordInput"
                                       autocomplete="current-password" placeholder="password"
                                       style="border-top-right-radius: 0; border-bottom-right-radius: 0;" />
                                <label for="passwordInput">Password</label>
                            </div>
                            <button class="btn btn-ips-outline-secondary px-3" type="button" id="togglePassword"
                                    style="border-top-left-radius: 0; border-bottom-left-radius: 0; z-index: 4; min-width: 50px;">
                                <i class="bi bi-eye fs-5"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small text-break-all"></span>
                    </div>

                    @* Links e Checkbox responsivos: empilham em ecrãs minúsculos *@
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 mb-md-5 gap-3">
                        <div class="form-check m-0">
                            <input class="form-check-input shadow-none" asp-for="Input.RememberMe" style="cursor: pointer;" />
                            <label class="form-check-label small" asp-for="Input.RememberMe" style="cursor: pointer;">Lembrar-me</label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small fw-bold">Esqueceu-se da senha?</a>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-ips btn-lg py-2 py-md-3 fw-bold shadow-sm mb-4 text-uppercase">
                        ENTRAR
                    </button>
                </form>

                @*<div class="d-flex align-items-center mb-4">
                    <hr class="flex-grow-1 text-muted">
                    <span class="mx-2 mx-md-3 text-muted fw-bold" style="font-size: 0.7rem; white-space: nowrap; letter-spacing: 1px;">OU ACEDA VIA</span>
                    <hr class="flex-grow-1 text-muted">
                </div>*@

                <section>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        @foreach (var provider in Model.ExternalLogins ?? new List<Microsoft.AspNetCore.Authentication.AuthenticationScheme>())
                        {
                            <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center py-2 py-md-3 rounded-3 shadow-sm border-0" name="provider" value="@provider.Name">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 21 21" class="me-2 me-md-3">
                                    <rect x="1" y="1" width="9" height="9" fill="#f25022" />
                                    <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                                    <rect x="1" y="11" width="9" height="9" fill="#00a4ef" />
                                    <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                                </svg>
                                <span class="fw-bold text-white small">Entrar com Microsoft</span>
                            </button>
                        }
                    </form>
                </section>

                <div class="mt-4 mt-md-5 text-center">
                    <p class="text-muted mb-0 small">
                        Ainda não tem conta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-nowrap">Registe-se aqui</a>
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_NotificationPartial" />
}