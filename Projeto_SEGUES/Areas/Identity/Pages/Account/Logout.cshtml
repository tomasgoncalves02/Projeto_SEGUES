@page
@model LogoutModel
@{
    ViewData["Title"] = "Logout - SEGUES";
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "", controller = "Home", action = "Index" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Clica aqui para fazer logout.</button>
            </form>
        }
        else
        {
            <p>You have successfully logged out of the application.</p>
        }
    }
</header>
