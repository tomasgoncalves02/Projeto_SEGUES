@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Areas.User.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Perfil";
    var initialLetter = Model.FirstName[0].ToString().ToUpper();
    
    bool isStudent = Model.Category.Equals("Estudante", StringComparison.OrdinalIgnoreCase);
    bool isEmployee = Model.Role.Name!.Equals("Employee", StringComparison.OrdinalIgnoreCase);
    bool showSchool = isEmployee || Model.Role.Name!.Equals("Client", StringComparison.OrdinalIgnoreCase);
}

<div class="container py-2 px-lg-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h1 class="fw-bold display-6 mb-1 title-underline">Perfil</h1>
            <p class="text-muted small mt-1 mb-0">Faça a gestão dos seus dados pessoais e de segurança.</p>
        </div>
        @* Return button *@
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    
    @* Profile Card *@
    <div class="card shadow-sm card-ips hover-shadow-ips border-0 d-flex flex-column mx-lg-3 mb-4">
        <div class="card-body p-4 p-md-5">
            @* User Header *@
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
                <div class="d-flex align-items-center">
                    <div class="avatar-circle fs-2" style="width: 65px; height: 65px;">
                        @initialLetter
                    </div>
                    <div class="ms-3">
                        <h4 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h4>
                        <div class="text-muted small">@Model.Email</div>
                    </div>
                </div>
                <span class="badge @Model.Role.Name.ToBadgeClass() fw-semibold fs-6 shadow-sm">
                    @Model.Role.DisplayName.ToUpper()
                </span>
            </div>

            <hr class="mb-4 text-muted">

            @* Update Form *@
            <form id="profileForm" method="post" asp-area="User" asp-controller="User" asp-action="UpdateProfile">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                <input type="hidden" asp-for="Id"/>
                @Html.AntiForgeryToken()

                <h5 class="fw-bold mb-3 text-color-ips"><i class="bi bi-person-badge me-2"></i>Informações Pessoais</h5>

                <div class="row g-3 mb-4 text-start">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="FirstName" class="form-control" />
                            <label asp-for="FirstName"></label>
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="LastName" class="form-control" />
                            <label asp-for="LastName"></label>
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                <option value="">Selecione...</option>
                            </select>
                            <label asp-for="Gender"></label>
                        </div>
                        <span asp-validation-for="Gender" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="BirthDate" type="date" class="form-control" 
                                   min="@DateTime.Now.AddYears(-120).ToString("yyyy-MM-dd")"
                                   max="@DateTime.Now.AddYears(-17).ToString("yyyy-MM-dd")"/>
                            <label asp-for="BirthDate"></label>
                        </div>
                        <span asp-validation-for="BirthDate" class="text-danger small d-block mt-1"></span>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="FiscalNumber" class="form-control" placeholder="NIF" />
                            <label asp-for="FiscalNumber"></label>
                        </div>
                        <span asp-validation-for="FiscalNumber" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
                
                @* Address and contacts *@
                <h5 class="fw-bold mb-3 text-color-ips border-top pt-3"><i class="bi bi-house-door me-2"></i>Morada</h5>
                <div class="row g-3 mb-4 text-start">
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Address" class="form-control" placeholder="Morada" />
                            <label asp-for="Address"></label>
                        </div>
                        <span asp-validation-for="Address" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-8">
                        <div class="form-floating">
                            <input asp-for="City" class="form-control" placeholder="Cidade" />
                            <label asp-for="City"></label>
                        </div>
                        <span asp-validation-for="City" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="PostalCode" class="form-control" placeholder="Código Postal" />
                            <label asp-for="PostalCode"></label>
                        </div>
                        <span asp-validation-for="PostalCode" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
                
                @* Institutional information *@
                <h5 class="fw-bold mb-3 text-color-ips border-top pt-3"><i class="bi bi-building me-2"></i>Informações Institucionais</h5>
                <div class="row g-3 mb-4 text-start">
                    <div class="col-md-6">
                        <div class="p-2 px-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                            <span class="d-block small text-muted fw-bold mb-1">Categoria de Utilizador</span>
                            <span class="fs-6 fw-medium">@(Model.Category)</span>
                        </div>
                    </div>

                    @if (isEmployee)
                    {
                        <div class="col-md-6">
                            <div class="p-2 px-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                                <span class="d-block small text-muted fw-bold mb-1">Cargo / Função</span>
                                <span class="fs-6 fw-medium">@(Model.RoleDescription ?? "Não definido")</span>
                            </div>
                        </div>
                    }

                    @if (isStudent)
                    {
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="StudentNumber" class="form-control" placeholder="Nº Estudante"/>
                                <label asp-for="StudentNumber"></label>
                            </div>
                            <span asp-validation-for="StudentNumber" class="text-danger small d-block mt-1"></span>
                        </div>
                    }

                    @if (showSchool)
                    {
                        <div class="col-md-6">
                            <div class="form-floating h-100">
                                <select asp-for="SchoolId" class="form-select" asp-items="ViewBag.Schools">
                                    <option value="">Selecione a Escola...</option>
                                </select>
                                <label asp-for="SchoolId"></label>
                            </div>
                            <span asp-validation-for="SchoolId" class="text-danger small d-block mt-1"></span>
                        </div>
                    }
                </div>
                
                @* Action Buttons *@
                <div class="d-grid gap-3 d-lg-flex justify-content-lg-between align-items-center border-top pt-4 mt-2">
                    <div class="d-grid gap-3 d-md-flex justify-content-md-center">
                        <a asp-area="Identity" asp-page="/Account/Manage/Email" class="btn btn-ips-outline-secondary fw-bold shadow-sm d-flex align-items-center justify-content-center text-nowrap">
                            <i class="bi bi-envelope me-2"></i>Email
                        </a>
                        <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-ips-outline-secondary fw-bold shadow-sm d-flex align-items-center justify-content-center text-nowrap">
                            <i class="bi bi-key me-2"></i>Password
                        </a>
                    </div>

                    <button type="submit" class="btn btn-ips px-4 fw-bold shadow-sm d-flex align-items-center justify-content-center text-nowrap">
                        <i class="bi bi-check2-circle me-2"></i>Guardar Alterações
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
                   
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}