@using Microsoft.AspNetCore.Identity
@using Projeto_SEGUES.Models.User
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager


@{
    ViewData["Title"] = "Perfil - SEGUES";
}

<div class="container mt-5">
@* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold title-underline">Perfil</h1>
        @* Return button *@
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4" style="padding-top: 0.72rem; padding-bottom: 0.71rem;">
            <i class="bi bi-arrow-left me-2"></i>Voltar ao Inicio
        </a>
    </div>
</div>



@if (SignInManager.IsSignedIn(User))
{
    var roles = ViewBag.Roles as List<SelectListItem> ?? [];
    var user = await UserManager.GetUserAsync(User);
    if (user == null) return;
    var userRoles = await UserManager.GetRolesAsync(user);
    var userRole = userRoles.FirstOrDefault() ?? "Client";
    var roleText = roles.Find(r => r.Value == userRole)?.Text ?? userRole;

   

    var name = user?.FirstName ?? "Utilizador";
    var lastname = user?.LastName ?? "Utilizador";
    var email = user?.Email ?? "Email";
    var birthDate = user?.BirthDate;
    var genre = user?.Gender;

    



    
    
    var fields = new List<(string Label, string Value, string Key)>
    {
        ("Nome", name, "name"),
        ("Apelido", lastname, "lastname"),
        ("Email", email, "email"),
        ("Data de Nascimento", birthDate?.ToString("dd/MM/yyyy") ?? "Não definido", "birthDate"),
        ("Género", genre?.ToDisplayName() ?? "Não definido","genre"),
        ("Password","******","password")

    };
    var initialLetter = name[0].ToString().ToUpper();




    <div class="card card-ips mb-4 shadow-sm">
        <div class="card-body py-4">

            <div class="d-flex align-items-center justify-content-between flex-wrap p-0 gap-2">
                <div class="d-flex align-items-center">
                    <div class="avatar-circle" style="width: 60px; height: 60px; font-size: 2rem; display: flex; align-items: center; justify-content: center;">@initialLetter</div>
                    <span class="ms-3 text-dark fw-bold fs-3">@name</span>
                </div>

              


                <span class="badge  @userRole.ToBadgeClass() fw-semibold fs-5 w-100 d-md-none"> @roleText.ToUpper()</span>
                <span class="badge  @userRole.ToBadgeClass() fw-semibold fs-5 d-none d-md-block"> @roleText.ToUpper()</span>
            </div>
            <br/>
            <hr class="m-0" style="border-color: #ddd; border-width: 2px;">

            <div class="card-body p-4">
                <h4 class="fw-bold mb-4 text-dark">Informações</h4>
                <div class="row">
                    <div class="col-12 col-md-6">
                        <div class="d-flex flex-column gap-2">
                            @foreach (var field in fields)
                            {
                                <div class="d-flex justify-content-between align-items-center px-3 py-2 rounded" style="background-color: #d8efeb;">
                                    <span class="text-dark">@field.Label: <span class="fw-bold">@field.Value</span></span>

                                    @if (field.Key == "birthDate")
                                    {
                                        <a onclick="showEditData('@field.Label', '@field.Value', '@field.Key')" class="text-decoration-none fw-semibold" style="cursor: pointer; color: #129b8e;">Editar</a>
                                    } else if (field.Key == "genre")
                                    {
                                        <a onclick="showEditGenre('@field.Label', '@field.Value', '@field.Key')" class="text-decoration-none fw-semibold" style="cursor: pointer; color: #129b8e;">Editar</a>
                                    }
                                    else
                                    {
                                        <a onclick="showEdit('@field.Label', '@field.Value', '@field.Key')" class="text-decoration-none fw-semibold" style="cursor: pointer; color: #129b8e;">Editar</a>
                                    }

                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            


        </div>
    </div>

   


 }









