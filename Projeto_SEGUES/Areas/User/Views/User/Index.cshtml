@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Areas.User.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Perfil - SEGUES";
    var initialLetter = Model.FirstName[0].ToString().ToUpper();
}


<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold title-underline">Perfil</h1>
        @* Return button *@
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4 rounded-3">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    @* Profile *@
    <div class="card card-ips mb-4 shadow-sm">
        <div class="card-body py-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                <div class="d-flex align-items-center">
                    <div class="avatar-circle" style="width: 60px; height: 60px; font-size: 2rem;">@initialLetter</div>
                    <div class="ms-3">
                        <span class="text-dark fw-bold fs-3">@Model.FirstName @Model.LastName</span>
                        <div class="text-muted">@ViewBag.Email</div>
                    </div>
                </div>
                <span class="badge @Model.Role.ToBadgeClass() fw-semibold fs-5 px-3">@Model.Role.ToUpper()</span>
            </div>
            <hr class="mb-4" style="border-color: #ddd; border-width: 2px;">

            <form id="profileForm" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id"/>
                @Html.AntiForgeryToken()
                
                <div class="row g-3">
                    <h4 class="fw-bold text-dark mb-2">Informações Pessoais</h4>

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-bold"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-bold"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label fw-bold"></label>
                        <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                            <option value="">Selecione...</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BirthDate" class="form-label fw-bold"></label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FiscalNumber" class="form-label fw-bold small"></label>
                        <input asp-for="FiscalNumber" class="form-control" />
                        <span asp-validation-for="FiscalNumber" class="text-danger small"></span>
                    </div>
                    
                    <h4 class="fw-bold text-dark mt-4 mb-2">Localização</h4>
                    <div class="col-md-8">
                        <label asp-for="Address" class="form-label fw-bold small"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PostalCode" class="form-label fw-bold small"></label>
                        <input asp-for="PostalCode" class="form-control" />
                        <span asp-validation-for="PostalCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label fw-bold small"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    
                    @if (Model.Category == "Student")
                    {
                        <h4 class="fw-bold text-dark mt-4 mb-2">Dados Académicos</h4>
                        <div class="col-md-6">
                            <label asp-for="StudentNumber" class="form-label fw-bold small"></label>
                            <input asp-for="StudentNumber" class="form-control" />
                            <span asp-validation-for="StudentNumber" class="text-danger small"></span>
                        </div>
                    }
                    else if (Model.Category == "Employee")
                    {
                        <h4 class="fw-bold text-dark mt-4 mb-2">Dados Profissionais</h4>
                        <div class="col-md-6">
                            <label asp-for="RoleDescription" class="form-label fw-bold small"></label>
                            <input asp-for="RoleDescription" class="form-control" />
                            <span asp-validation-for="RoleDescription" class="text-danger small"></span>
                        </div>
                    }
                    
                    <div class="col-12 mt-4">
                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                            <div class="d-flex gap-2">
                                <a asp-area="Identity" asp-page="/Account/Manage/Email" class="btn btn-outline-primary fw-bold">
                                    <i class="bi bi-envelope me-2"></i>Alterar Email
                                </a>
                                <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-outline-warning fw-bold">
                                    <i class="bi bi-key me-2"></i>Alterar Password
                                </a>
                            </div>
                            <button type="submit" class="btn btn-ips px-5 fw-bold">
                                Guardar Alterações
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
