@model IEnumerable<Projeto_SEGUES.Models.Order.Order>
@{
    ViewData["Title"] = "Os Meus Pedidos";
}

@* Header *@
<div class="container mt-4 text-start">
    <div class="d-flex mb-4 align-items-center justify-content-between flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h2 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-bag-check me-2 text-color-ips"></i>
                Os Meus Pedidos
            </h2>
            <p class="text-muted small mt-1 mb-0">Apresente estes códigos no bar para levantares os seus produtos.</p>
        </div>
        <a asp-area="Order" asp-controller="Order" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* HTMX *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4"
         hx-get="/Order/ActiveOrder/GetUpdatedActiveOrders"
         hx-trigger="every 60s"
         hx-swap="innerHTML">

        <partial name="_ActiveOrdersCardsPartial" model="@Model"/>
    </div>
</div>