@model IEnumerable<Projeto_SEGUES.Models.Order.Order>

@if (!Model.Any())
{
    <div class="col-12 w-100 text-center py-5 my-5">
        <div class="d-flex flex-column align-items-center justify-content-center">
            <i class="bi bi-bag-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted fw-bold">Não tem pedidos ativos no Bar.</h4>
            <div class="mt-3">
                <a asp-area="Order" asp-controller="CreateOrder" asp-action="Index" class="btn btn-ips px-4 py-2 shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i>Fazer Pedido
                </a>
            </div>
        </div>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        bool isScheduled = item.PickupTime.HasValue && item.PickupTime.Value != TimeSpan.Zero;
        <div class="col">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips border-0">
                <div class="card-body d-flex flex-column p-4">
                    <div class="d-flex justify-content-between mb-3 align-items-center">
                        <span class="badge @item.Status.ToString().ToBadgeClass() px-3 py-2">
                            @item.Status.ToDisplayName()
                        </span>
                        <small class="text-muted fw-bold">
                            @if (isScheduled && item.PickupTime.HasValue)
                            {
                                <i class="bi bi-clock-history me-1 text-color-ips"></i>
                                <span>@item.PickupTime.Value.ToString(@"hh\:mm")</span>
                            }
                            else
                            {
                                <i class="bi bi-clock me-1 text-color-ips"></i>
                                <span>@item.OrderDate.ToString("HH:mm")</span>
                            }
                        </small>
                    </div>
                    <div class="text-center my-3">
                        <h3 class="fw-bold mb-0 text-dark" style="letter-spacing: 6px; font-family: monospace;">
                            @item.RedemptionCode
                        </h3>
                        <small class="text-muted text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">Código de Resgate</small>
                    </div>
                    <div class="mt-auto">
                        <a asp-area="Order" asp-controller="ActiveOrder" asp-action="OrderDetails" asp-route-id="@item.Id"
                           class="btn btn-ips w-100 py-2 fw-bold shadow-sm">
                            <i class="bi bi-info-circle me-2"></i>Informações
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}