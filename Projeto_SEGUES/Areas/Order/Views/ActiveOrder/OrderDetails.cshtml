@model Projeto_SEGUES.Models.Order.Order
@{
    ViewData["Title"] = "Informações do Pedido - SEGUES";
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Employee");
    bool isScheduled = Model.DeliveryTime.HasValue && Model.DeliveryTime.Value != TimeSpan.Zero;
}

<div class="container mt-4">
    @* Title row *@
    <div class="d-flex mb-4 align-items-center justify-content-between flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-ticket-detailed me-2 text-color-ips"></i>
                Pedido
            </h2>
        </div>
        @* Back button *@
        <a asp-area="Order" asp-controller="ActiveOrder" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i> Voltar
        </a>
    </div>

    @* Main row *@
    <div class="row g-4">
        @* Info Sidebar *@
        <div class="col-lg-4">
            <div class="card shadow-sm card-ips hover-shadow-ips border-0 mb-4 h-100">
                <div class="card-header bg-white py-3 text-color-ips border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-cart-plus me-2"></i>Resumo</h5>
                </div>

                <div class="card-body p-4">
                    @* Value Details *@
                    <div class="mb-4 pb-3 border-bottom">
                        <p class="mb-2 text-dark small fw-bold d-flex justify-content-between">
                            <span>Hora da Compra:</span> <span class="text-muted">@Model.OrderDate.ToString("HH:mm")</span>
                        </p>
                        <p class="mb-2 text-dark small fw-bold d-flex justify-content-between">
                            <span>Valor Total:</span> <span class="text-color-ips">@Model.TotalValue.ToString("C")</span>
                        </p>
                        <p class="mb-0 text-dark small fw-bold d-flex justify-content-between">
                            <span>Itens:</span> <span class="text-muted">@ViewBag.TotalQuantity</span>
                        </p>
                    </div>

                    @* State field *@
                    <div class="row align-items-center mb-3">
                        <div class="col-4">
                            <p class="mb-0 text-dark small fw-bold">Estado</p>
                        </div>
                        <div class="col-8">
                            <div class="alert alert-light border-0 mb-0 py-2 px-3 d-flex justify-content-center align-items-center shadow-sm bg-color-ips-light rounded-3" style="min-height: 45px;">
                                <strong class="text-dark">@Model.Status.ToDisplayName()</strong>
                            </div>
                        </div>
                    </div>

                    @* Pickup field *@
                    <div class="row align-items-center mb-4">
                        <div class="col-4">
                            <p class="mb-0 text-dark small fw-bold">Recolha</p>
                        </div>
                        <div class="col-8">
                            <div class="alert alert-light border-0 mb-0 py-2 px-3 d-flex @(!isScheduled ? "justify-content-center" : "justify-content-between") align-items-center shadow-sm bg-color-ips-light rounded-3" style="min-height: 45px;">
                                @if (!isScheduled)
                                {
                                    <strong class="text-dark">Agora</strong>
                                }
                                else
                                {
                                    <span class="text-dark fw-bold small me-2">A partir das</span>
                                    <strong class="text-dark">@Model.DeliveryTime!.Value.ToString(@"hh\:mm")</strong>
                                }
                            </div>
                        </div>
                    </div>

                    @* Actions *@
                    <div class="d-flex flex-column gap-2 mt-2">
                        <button data-code="@Model.RedemptionCode" class="btn btn-ips w-100 py-2 fw-bold shadow-sm showCode">
                            <i class="bi bi-qr-code me-2"></i> Ver Código
                        </button>

                        <form id="orderCancellationForm" asp-area="Order" asp-controller="ActiveOrder" asp-action="CancelOrder" asp-route-id="@Model.Id" method="post" class="w-100">
                            @Html.AntiForgeryToken()
                            <button type="button" id="confirmOrderCancellation"
                                    class="btn btn-outline-danger w-100 py-2 fw-bold">
                                <i class="bi bi-x-circle me-2"></i> Cancelar Pedido
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @* Table with products *@
        <div class="col-lg-8">
            <div class="card shadow-sm card-ips hover-shadow-ips border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0 fw-bold text-color-ips"><i class="bi bi-list-check me-2"></i>Produtos no Pedido</h5>
                </div>

                <div class="table-responsive" style="max-height: 550px;">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="text-white bg-color-ips position-sticky top-0">
                            <tr>
                                <th class="text-start ps-4 py-3">Nome</th>
                                <th class="py-3">Quantidade</th>
                                <th class="py-3">Preço</th>
                                <th class="pe-4 py-3">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in Model.ProductPurchases)
                        {
                            var productInfo = new
                            {
                                name = p.Product.Name,
                                description = p.Product.Description,
                                price = p.ProductValue.ToString("C2"),
                                categoryName = p.Product.Category?.Name ?? "N/A",
                                categoryDescription = p.Product.Category?.Description ?? "",
                                stock = isStaff ? (int?)p.Product.Stock : null,
                                minStock = isStaff ? (int?)p.Product.MinimumStock : null
                            };
                            <tr>
                                <td class="ps-4 text-start fw-bold">@p.Product.Name</td>
                                <td class="fw-bold">@p.Quantity</td>
                                <td class="text-color-ips fw-bold">@p.ProductValue.ToString("C")</td>
                                <td class="pe-4">
                                    <button class="btn btn-sm btn-ips shadow-sm showProductDetails"
                                            data-product='@Html.Raw(Json.Serialize(productInfo))'>
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/order/order.js"></script>
    <script type="module" src="~/js/inventory/inventory.js"></script>
}