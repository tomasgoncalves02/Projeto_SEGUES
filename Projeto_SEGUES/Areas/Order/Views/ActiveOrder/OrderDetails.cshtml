@model Projeto_SEGUES.Models.Order.Order
@{
    ViewData["Title"] = "Informações do Pedido - SEGUES";
}

<div class="container mt-4">
@* Title row *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-5">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-ticket-detailed-fill me-2 text-color-ips"></i>
                Pedido: @Model.Id
            </h2>
        </div>
        @* Back buttons *@
        <div class="col-md-7 text-center d-flex justify-content-end align-items-center gap-3">
            <a asp-area="Order" asp-controller="ActiveOrder" asp-action="Index"
               class="btn btn-ips-outline-secondary fw-bold px-4 shadow-sm">
                <i class="bi bi-arrow-left me-2"></i> Voltar
            </a>
        </div>
    </div>
@* Main row with purchase form and tickets table *@
    <div class="row g-4">
@* Info form *@
        <div class="col-lg-4">
            <div class="card shadow-sm card-ips mb-4">
                <div class="card-header bg-white py-3 text-color-ips">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-cart-plus me-2"></i>Total</h5>
                </div>
                <div class="card-body">
                  
                    <div class="p-4 border-bottom">
                        <p class="mb-1 text-dark small fw-bold text-uppercase">Hora da Compra: @Model.OrderDate.ToString("HH:mm")</p>
                        <p class="mb-1 text-dark small fw-bold text-uppercase">Valor: @Model.TotalValue.ToString("N2")€</p>
                        <p class="mb-1 text-dark small fw-bold text-uppercase">Quantidade de Itens comprados: @ViewBag.TotalQuantity</p>
                        
                    </div>
                </div>

                <div class="card-body">

                    <div class="p-4 border-bottom">
                        <p class="mb-1 text-muted small fw-bold text-uppercase">
                            Estado: <span class="alert alert-light border-0 small mb-4" style="background-color: var(--ips-shadow-soft);">
                               <strong class="text-color-ips fs-5">@Model.Status</strong>
                            </span>
                        </p>
                        <p class="mb-1 text-muted small fw-bold text-uppercase">
                            Recolha <span class="alert alert-light border-0 small mb-4" style="background-color: var(--ips-shadow-soft);">
                                <strong class="text-color-ips fs-5">
                                    @(Model.PickupTime == TimeSpan.Zero
                                                                        ? Model.OrderDate.TimeOfDay.ToString(@"hh\:mm")
                                                                        : Model.PickupTime.ToString())
                                </strong>
                            </span>
                        </p>
                    </div>
                </div>

                <div class="card-body">
                    <div class="d-flex flex-column gap-2">
                        <button onclick="showCode('@Model.RedemptionCode')" class="btn btn-ips w-100 py-2 fw-bold text-uppercase">
                            CÓDIGO
                        </button>
                        <form asp-area="Order" asp-controller="ActiveOrder" asp-action="CancelOrder" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="button" onclick="confirmarCancelamento(this.form)"
                                    class="btn btn-secondary w-100 py-2 fw-bold text-uppercase">
                                CANCELAR
                            </button>
                        </form>
                    </div>
                </div>

            </div>

</div>




    
@* Table with ticket history *@
    <div class="col-lg-8">
        <div class="card shadow-sm card-ips h-100">
            @* h-100 opcional para alinhar alturas *@
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="mb-0 fw-bold text-color-ips"><i class="bi bi-list-check me-2"></i>Produtos</h5>
            </div>

            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="text-white bg-color-ips" style="position: sticky; top: 0; z-index: 1;">
                        <tr>
                            <th>Nome</th>
                            <th>Informações</th>
                            <th>Preço</th>
                            <th>Quantidade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.ProductPurchases)
                        {
                            <tr>
                                    <td class="ps-4 text-start fw-bold">@product.Product.Name</td>
                                <td>
                                        <button class="btn btn-sm btn-ips shadow-sm" onclick="showProductDetails('@product.Product.Name', '@Html.Raw(product.Product.Description?.Replace("'", "\\'"))', '@product.Product.Price.ToString("0.00") €')">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                </td>
                                    <td class="text-color-ips fw-bold">@product.Product.Price.ToString("N2")€</td>
                                    <td class="pe-4">@product.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>








