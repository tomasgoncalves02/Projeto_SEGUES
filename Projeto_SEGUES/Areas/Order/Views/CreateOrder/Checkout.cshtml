@model Projeto_SEGUES.Models.Order.Order
@{
    ViewData["Title"] = "Carrinho";
}

<div class="container mt-4 text-start">
    <div class="d-flex mb-4 align-items-center justify-content-between flex-column flex-md-row">
        @* Title *@
        <div class="mb-2 mb-md-0 col-12 col-md-auto order-last order-md-first text-center text-md-start mt-3 mt-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-cart3 me-2 text-color-ips"></i> Carrinho
            </h2>
            <p class="text-muted small mt-1 mb-0">Verifica os produtos e confirme o seu pedido.</p>
        </div>
        @* Buttons *@
        <div class="d-flex flex-column flex-md-row col-12 col-md-auto align-self-stretch align-self-md-center gap-3 order-first order-md-last justify-content-md-end mb-3 mb-md-0">
            <a asp-area="Order" asp-controller="CreateOrder" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm px-4 align-content-center">
                <i class="bi bi-arrow-left me-2"></i> Voltar
            </a>
            <div class="bg-color-ips text-white px-4 py-2 rounded shadow-sm d-flex flex-column align-items-center justify-content-center">
                <small class="fw-bold fs-7">Saldo Atual</small>
                <span class="fw-bold fs-5">@ViewBag.Balance.ToString("C")</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3">
                <div class="card-body p-3 p-md-4 text-center">
                    <div class="bg-light border rounded p-3 mb-2 mb-md-4 shadow-sm">
                        <small class="text-muted fw-bold d-block mb-1">Total a Pagar</small>
                        <span class="fs-4 fw-bold text-color-ips">@Model.TotalValue.ToString("N2") €</span>
                    </div>

                    <form id="checkoutForm" asp-area="Order" asp-controller="CreateOrder" asp-action="SubmitOrder" method="post">
                        @Html.AntiForgeryToken()
                        <p class="fw-bold small mb-2 text-start">Data de entrega</p>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <input type="radio" class="btn-check receiveNow" name="receiveNow" id="now" value="true" checked>
                                <label class="btn btn-ips w-100 fw-bold py-2" for="now" id="nowLabel">Agora</label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check receiveNow" name="receiveNow" id="later" value="false">
                                <label class="btn btn-ips-outline-secondary border-secondary-subtle w-100 fw-bold py-2" for="later" id="laterLabel">Depois</label>
                            </div>
                        </div>
                        <div id="pickup-time-wrapper" class="d-none">
                            <p class="fw-bold small mb-2 text-start">Horário de recolha</p>
                            <div class="d-flex justify-content-center mb-4">
                                <input type="time" name="pickupTime" id="pickupTime"
                                       class="form-control fw-bold text-center w-auto" style="border-color: var(--ips);">
                            </div>
                        </div>

                        <button type="button" id="confirmOrder"
                                class="btn btn-ips w-100 py-2 py-md-3 fw-bold shadow-sm text-decoration-none"
                                @(Model.ProductPurchases.Any() ? "" : "disabled")>
                            <i class="bi bi-check-circle me-2"></i> Confirmar compra
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 overflow-hidden h-100">
                <div class="table-responsive" style="max-height: 500px;">
                    <table class="table table-hover align-middle mb-0 text-center position-sticky top-0">
                        <thead class="bg-color-ips text-white">
                        <tr>
                            <th class="ps-4 text-start py-2 py-md-3">Nome</th>
                            <th class="py-2 py-md-3">Preço</th>
                            <th class="py-2 py-md-3">Qtd</th>
                            <th class="pe-4 py-2 py-md-3">Ação</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (!Model.ProductPurchases.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-cart-x display-4 d-block mb-3 opacity-25"></i>
                                    <span class="fw-bold">O seu carrinho está vazio.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.ProductPurchases)
                            {
                                <tr>
                                    <td class="ps-4 text-start fw-bold">@item.Product.Name</td>
                                    <td class="text-color-ips fw-bold">@item.ProductValue.ToString("C")</td>
                                    <td>
                                        <span class="badge bg-color-ips-light text-color-ips shadow-sm px-3 py-2 fs-7">@item.Quantity</span>
                                    </td>
                                    <td class="pe-4">
                                        <button type="button" class="btn btn-sm btn-danger rounded-3 removeFromCart" data-id="@item.ProductId" data-name="@item.Product.Name" title="Remover Produto">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/order/createOrder.js"></script>
}