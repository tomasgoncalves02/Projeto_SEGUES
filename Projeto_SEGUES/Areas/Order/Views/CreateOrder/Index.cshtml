@model Projeto_SEGUES.Areas.Order.ViewModels.CreateOrderViewModel

@{
    ViewData["Title"] = "Efetuar Pedido";
}

<div class="container mt-4 text-start">
    @* Top row *@
    <div class="d-flex mb-4 align-items-center justify-content-between flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h2 class="fw-bold display-6 title-underline mb-2">Efetuar Pedido</h2>
            <p class="text-muted small mt-1 mb-0">Selecione os produtos e as quantidades que pretende adquirir.</p>
        </div>
        <a asp-area="Order" asp-controller="Order" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold px-4 shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Filters Bar *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body p-4 filter-bar">
            <div class="row g-3 align-items-end">
                @* Checkout Cart *@
                <div class="col-6 col-md-4 col-xl-2 order-1 border-end pe-2 pe-md-4 d-flex align-items-center justify-content-center">
                    <div class="text-center">
                        <span class="fw-bold small d-block text-muted mb-1">Carrinho</span>
                        <a asp-area="Order" asp-controller="CreateOrder" asp-action="Checkout" class="position-relative d-inline-block text-decoration-none">
                            <i class="bi bi-cart-check fs-2 text-color-ips"></i>
                            <span id="cartCount" class="position-absolute badge rounded-pill bg-danger fs-7"
                                  style="display: @(Model.CartTotal.TotalQuantity > 0 ? "block" : "none"); top: -2px; right: -5px; padding: 0.35em 0.5em; border: 2px solid white;">
                                @Model.CartTotal.TotalQuantity
                            </span>
                        </a>
                        <span class="fw-bold small d-block text-muted mt-2">Total: <span id="cartTotal">@Model.CartTotal.TotalValue €</span></span>
                    </div>
                </div>
                
                @* Clear button *@
                <div class="col-6 col-md-auto order-2 order-md-4 d-flex align-items-center justify-content-center justify-content-md-end pb-1 pb-md-0">
                    <button type="button" id="clearProductsTableFilters" class="btn btn-sm btn-ips-outline-secondary fw-bold px-3 py-2">
                        <i class="bi bi-x-circle me-1"></i> Limpar
                    </button>
                </div>

                @* Category filter *@
                <div class="col-12 col-md-4 col-xl-3 order-3 order-md-2 pt-2 pt-md-0">
                    <label for="categoryFilter" class="form-label small fw-bold text-muted mb-1">Categoria</label>
                    <select id="categoryFilter" class="form-select form-select-sm border-secondary-subtle">
                        <option value="">Todas</option>
                        @foreach (SelectListItem cat in Model.Categories)
                        {
                            <option value="@cat.Value">@cat.Text</option>
                        }
                    </select>
                </div>

                @* Search filter *@
                <div class="col-12 col-md col-xl order-4 order-md-3">
                    <label for="nameFilter" class="form-label small fw-bold text-muted mb-1">Pesquisar</label>
                    <input id="nameFilter" type="text" class="form-control form-control-sm border-secondary-subtle" placeholder="Nome do produto...">
                </div>
            </div>
        </div>
    </div>

    @* Products Table *@
    <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-color-ips"><i class="bi bi-list-ul me-2"></i>Lista de Produtos</h5>
            <span class="badge bg-light text-dark border"><span id="productsCountBadge">@Model.Products.Count()</span> registos</span>
        </div>
        <div class="table-responsive" style="max-height: 550px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white position-sticky top-0">
                    <tr>
                        <th class="ps-4 py-3 text-start">Nome</th>
                        <th class="py-3">Categoria</th>
                        <th class="py-3">Preço</th>
                        <th class="py-3">Quantidade</th>
                        <th class="pe-4 py-3">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam display-4 d-block mb-3 opacity-25"></i>
                                <span class="fw-bold">Não existem produtos disponíveis no momento.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Products)
                        {
                            <tr class="productRow" data-name="@p.Name" data-categoryid="@p.CategoryId">
                                <td class="ps-4 text-start fw-bold">@p.Name</td>
                                <td>@p.CategoryName</td> 
                                <td class="text-color-ips fw-bold">@p.FormattedPrice</td>
                                <td>
                                    <input type="number" id="qty-@p.Id" min="1" max="10" value="1" class="form-control form-control-sm border-secondary-subtle" />
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-ips btn-sm px-3 fw-bold addToCart" data-id="@p.Id" data-name="@p.Name">
                                            <i class="bi bi-cart-plus me-1"></i> Adicionar
                                        </button>
                                        <button class="btn btn-sm btn-ips-outline-secondary shadow-sm showProductDetails" data-product='@Html.Raw(Json.Serialize(p.ModalInfo))'>
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/order/createOrder.js"></script>
    <script type="module" src="~/js/inventory/inventory.js"></script>
}