@model Projeto_SEGUES.Areas.Order.ViewModels.CreateOrderViewModel

@{
    ViewData["Title"] = "Efetuar Pedido";
}

<div class="container mt-4 text-start">
    @* Top row *@
    <div class="d-flex mb-4 align-items-center justify-content-between flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h2 class="fw-bold display-6 title-underline mb-2">Efetuar Pedido</h2>
            <p class="text-muted small mt-1 mb-0">Selecione os produtos e as quantidades que pretende adquirir.</p>
        </div>
        <a asp-area="Order" asp-controller="Order" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold px-4 shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    @* Filters Bar *@
    <div class="card card-ips shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body p-3 p-md-4 bg-light rounded-3">
            <div class="row g-3 align-items-center">

                @* Checkout Cart Section *@
                <div class="col-12 col-md-auto d-flex align-items-center justify-content-center justify-content-md-start mb-3 mb-md-0">
                    <div class="text-center px-3">
                        <span class="fw-bold small d-block text-muted mb-2" style="font-size: 0.8rem;">Carrinho</span>
                        <a asp-area="Order" asp-controller="CreateOrder" asp-action="Checkout" class="position-relative d-inline-block text-decoration-none">
                            <i class="bi bi-cart-check fs-2 text-color-ips"></i>
                            <span id="cartCount" class="position-absolute badge rounded-pill bg-danger"
                                  style="display: @(Model.CartTotal.TotalQuantity > 0 ? "block" : "none"); top: -5px; right: -10px; border: 2px solid white; font-size: 0.65rem;">
                                @Model.CartTotal.TotalQuantity
                            </span>
                        </a>
                        <div class="mt-2">
                            <span class="fw-bold text-muted small">Total: </span>
                            <span id="cartTotal" class="fw-bold text-dark small">@(Model.CartTotal.TotalValue.ToString("C"))</span>
                        </div>
                    </div>
                </div>

                @* Filtros com a linha separadora *@
                <div class="col col-md border-start ps-md-4">
                    <div class="row g-2 g-md-3 align-items-end">

                        @* Categoria e Pesquisa *@
                        <div class="col-6 col-md-4">
                            <label for="categoryFilter" class="form-label small fw-bold text-muted mb-1">Categoria</label>
                            <select id="categoryFilter" class="form-select form-select-sm border-secondary-subtle">
                                <option value="">Todas</option>
                                @foreach (SelectListItem cat in Model.Categories)
                                {
                                    <option value="@cat.Value">@cat.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-6 col-md">
                            <label for="nameFilter" class="form-label small fw-bold text-muted mb-1">Pesquisar</label>
                            <input id="nameFilter" type="text" class="form-control form-control-sm border-secondary-subtle" placeholder="Nome do produto...">
                        </div>

                        @* Botão Limpar *@
                        <div class="col-12 col-md-auto text-center text-md-end">
                            <button type="button" id="clearProductsTableFilters" class="btn btn-sm btn-ips-outline-secondary fw-bold px-3 w-100 w-md-auto" style="height: 31px;">
                                <i class="bi bi-x-circle me-1"></i> Limpar
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* Products Table *@
    <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-color-ips"><i class="bi bi-list-ul me-2"></i>Lista de Produtos</h5>
            <span class="badge bg-light text-dark border"><span id="productsCountBadge">@Model.Products.Count()</span> registos</span>
        </div>
        <div class="table-responsive" style="max-height: 550px;">
            <table class="table table-hover align-middle mb-0 text-center small fs-md-6">
                <thead class="bg-color-ips text-white position-sticky top-0">
                    <tr>
                        <th class="ps-4 py-2 py-md-3 text-start">Nome</th>
                        <th class="py-2 py-md-3 d-none d-md-table-cell">Categoria</th>
                        <th class="py-2 py-md-3">Preço</th>
                        <th class="py-2 py-md-3" style="width: 80px;">Quantidade</th>
                        <th class="pe-4 py-2 py-md-3">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam display-4 d-block mb-3 opacity-25"></i>
                                <span class="fw-bold">Não existem produtos disponíveis no momento.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Products)
                        {
                            <tr class="productRow" data-name="@p.Name" data-categoryid="@p.CategoryId">
                                <td class="ps-4 text-start fw-bold">@p.Name</td>
                                <td class="d-none d-md-table-cell">@p.CategoryName</td>
                                <td class="text-color-ips fw-bold text-nowrap">@p.FormattedPrice</td>
                                <td>
                                    <input type="number" id="qty-@p.Id" min="1" max="99" value="1"
                                           class="form-control form-control-sm border-secondary-subtle px-1 text-center no-spinners"
                                           style="min-width: 50px;"
                                           oninput="if(this.value.length > 2) this.value = this.value.slice(0,2);" />
                                </td>
                                <td class="pe-3 pe-md-4">
                                    <div class="d-flex justify-content-center gap-1 gap-md-2">
                                        <button class="btn btn-ips btn-sm px-2 px-md-3 fw-bold addToCart" data-id="@p.Id" data-name="@p.Name" title="Adicionar ao Carrinho">
                                            <i class="bi bi-cart-plus fs-6"></i>
                                            <span class="d-none d-md-inline ms-1">Adicionar</span>
                                        </button>
                                        <button class="btn btn-sm btn-ips-outline-secondary shadow-sm showProductDetails px-2" data-product='@Html.Raw(Json.Serialize(p.ModalInfo))'>
                                            <i class="bi bi-eye fs-6"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/order/createOrder.js"></script>
    <script type="module" src="~/js/inventory/inventory.js"></script>
}