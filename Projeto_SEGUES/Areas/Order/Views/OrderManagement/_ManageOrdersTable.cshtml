@using Projeto_SEGUES.Models.Enums
@model IEnumerable<Projeto_SEGUES.Models.Order.Order>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
   <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 text-center">
        <thead class="bg-color-ips text-white">
            <tr>
                <th>Selecionar</th>
                <th>Utilizador</th>
                <th>Pedido efetuado</th>
                <th>Hora de entregar</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr data-order-id="@order.Id">
                    <td>
                        <button class="btn btn-sm btn-ips shadow-sm"
                                hx-get="/Order/OrderManagement/GetOrderDetailsSide/@order.Id"
                                hx-target="#side-panel-target">
                            <i class="bi bi-eye text-white"></i>
                        </button>
                    </td>
                    <td>@order.AppUser.FirstName @order.AppUser.LastName<br />@order.AppUser.UserName</td>
                    <td>@order.OrderDate.ToString("HH:mm")</td>
                    <td>@(order.PickupTime == TimeSpan.Zero ? "-" : order.PickupTime.ToString())</td>
                    <td>
                        <span class="badge @(order.Status == OrderStatus.Pending ? "bg-secondary" : order.Status == OrderStatus.Preparing ? "bg-info" : order.Status == OrderStatus.ReadyToDeliver ? "bg-warning" : "bg-success")">
                            @((order.Status == OrderStatus.Pending) ? "Pendente" : (order.Status == OrderStatus.Preparing) ? "Em Preparação" : (order.Status == OrderStatus.ReadyToDeliver) ? "Pronto" : "Entregue")
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>