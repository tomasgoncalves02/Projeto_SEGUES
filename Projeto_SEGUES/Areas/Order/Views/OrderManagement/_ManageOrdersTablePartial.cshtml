@using Projeto_SEGUES.Extensions
@model IEnumerable<Projeto_SEGUES.Models.Order.Order>

<div class="card shadow-sm border-0 h-100 small fs-md-6">
    <div class="table-responsive rounded-3" style="max-height: 500px;">
        <table class="table align-middle mb-0 text-center">
            <thead class="bg-color-ips text-white">
                <tr>
                    <th class="ps-3 ps-md-4 py-2 py-md-3">Ver</th>
                    <th class="py-2 py-md-3">Utilizador</th>
                    <th class="py-2 py-md-3">Pedido efetuado</th>
                    <th class="py-2 py-md-3">Hora de entregar</th>
                    <th class="pe-3 pe-md-4 py-2 py-md-3">Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var order in Model)
                    {
                        <tr class="table-row-ips-hover">
                            @* Select *@
                            <td>
                                <button class="btn btn-sm btn-ips shadow-sm"
                                        hx-get="/Order/OrderManagement/GetOrderDetailsSide/@order.Id"
                                        hx-target="#side-panel-target"
                                        hx-swap="outerHTML">
                                    <i class="bi bi-arrow-up-left"></i>
                                </button>
                            </td>

                            @* User *@
                            <td class="ps-3 ps-md-4">
                                <div class="d-flex align-items-center flex-column">
                                    <div class="fw-bold text-dark">@order.AppUser.FirstName @order.AppUser.LastName</div>
                                    <div class="text-muted small">@order.AppUser.UserName</div>
                                </div>
                            </td>

                            @* Order date *@
                            <td>@order.OrderDate.ToString(@"HH\:mm")</td>

                            @* Pickup time *@
                            <td class="align-middle">
                                @if (order.DeliveryTime.HasValue)
                                {
                                    <span class="fw-bold">@string.Format("{0:hh\\:mm}", order.DeliveryTime.Value)</span>
                                }
                                else
                                {
                                    <span class="badge p-2 bg-color-ips text-white" style="min-width: fit-content;">
                                        AGORA
                                    </span>
                                }
                            </td>

                            @* Status *@
                            <td class="pe-3 pe-md-4">
                                <span class="badge @order.Status.ToString().ToBadgeClass() p-2" style="min-width: fit-content;">
                                    @order.Status.ToDisplayName().ToUpper()
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-5 text-center">
                            <div class="text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                <p class="mb-0 fw-bold">Não existem pedidos ativos de momento.</p>
                                <small>Novos pedidos aparecerão aqui automaticamente.</small>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>