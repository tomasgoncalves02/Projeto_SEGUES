@using System.Text.Json
@model Projeto_SEGUES.Areas.Order.ViewModels.OrderManagementSideViewModel

<div id="side-panel-target" 
     hx-get="/Order/OrderManagement/GetOrderDetailsSide/@Model.Id"
     hx-trigger="orderUpdated from:body"
     hx-swap="outerHTML"
>
    <div class="card shadow-sm border-0 card-ips hover-shadow-ips hover-translate d-flex flex-column h-100">
        @* Header *@
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
            <i class="bi bi-cart fs-3 text-color-ips me-3"></i>
            <div>
                <h5 class="fw-bold mb-0 text-color-ips">Pedido</h5>
                <small class="text-muted fw-bold">Gestão do Estado</small>
            </div>
        </div>
            
        <div class="card-body p-0">
            @* General Information Section *@
            <div class="p-4 border-bottom bg-light bg-opacity-10">
                <h6 class="fw-bold mb-3 text-color-ips">
                    <i class="bi bi-info-circle me-2"></i>Informações Gerais
                </h6>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Total:</span>
                        <span class="text-color-ips fw-bold fs-5">@Model.FormattedTotalValue</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Itens:</span>
                        <span class="badge bg-secondary-subtle text-dark border">@Model.TotalQuantity un.</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Comprador:</span>
                        <span class="text-muted small">@Model.BuyerName</span>
                    </div>
                </div>
            </div>
            @* Product List *@
            <div class="p-4 border-bottom">
                <h6 class="fw-bold mb-3 text-color-ips">
                    <i class="bi bi-box-seam me-2"></i>Produtos
                </h6>
                <div class="w-100 custom-scrollbar" style="max-height: 280px; overflow-y: auto;">
                    @if (Model.Items.Any())
                    {
                        foreach (var p in Model.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-color-ips-light rounded-3">
                                <div class="d-flex flex-column overflow-hidden me-2">
                                    <span class="small fw-bold text-truncate">@p.Name</span>
                                    <span class="fs-7">@p.Quantity x @p.FormattedPrice : @(p.FormattedTotalPrice)</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-ips shadow-sm showProductDetails flex-shrink-0"
                                        data-product='@Html.Raw(JsonSerializer.Serialize(p.ModalInfo))'>
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small fst-italic text-center py-3">Nenhum produto encontrado.</p>
                    }
                </div>
            </div>
                
            @* Order State Management Form *@
            <div class="p-4">
                <h6 class="fw-bold mb-3 text-color-ips">
                    <i class="bi bi-gear-wide-connected me-2"></i>Alterar Estado
                </h6>
                <div class="d-flex flex-column align-items-center bg-light p-3 rounded-3 shadow-sm border">
                    <p class="small fw-bold mb-2">Estado Atual</p>
                    <div class="d-flex align-items-center justify-content-center w-100">
                        @* Previous State Button *@
                        <button type="button" data-id="@Model.Id" data-status="@Model.PrevStatusId"
                                class="btn btn-ips changeOrderState@(Model.CanGoBack ? "" : " btn-disabled-dark")"
                                title="Estado Anterior"
                                @(Model.CanGoBack ? "" : "disabled")>
                            <i class="bi bi-arrow-left fs-5"></i>
                        </button>
                        @* Current State Display *@
                        <div class="text-center px-3">
                            <span class="badge @Model.StatusBadgeClass fs-6 py-2 px-3 shadow-sm">
                                @Model.StatusDisplayName
                            </span>
                        </div>
                        @* Next State Button *@
                        <button type="button" data-id="@Model.Id" data-status="@Model.NextStatusId"
                                class="btn btn-ips changeOrderState@(Model.CanGoForward ? "" : " btn-disabled-dark")"
                                title="Próximo Estado"
                                @(Model.CanGoForward ? "" : "disabled")>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </button>
                    </div>
                    @Html.AntiForgeryToken()
                </div>
                
                <div class="form-text text-center mt-2 fs-7 text-muted">
                    Utilize as setas para avançar ou retroceder no fluxo do pedido.
                </div>
            </div>
        </div>
    </div>
</div>