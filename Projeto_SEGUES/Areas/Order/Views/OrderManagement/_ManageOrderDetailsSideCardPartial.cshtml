@using Projeto_SEGUES.Models.Enums
@using System.Text.Json
@model Projeto_SEGUES.Models.Order.Order

@{
    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Employee");
}

<div class="card shadow-sm border-0 card-ips hover-translate d-flex flex-column h-100">
    @* Header *@
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
        <i class="bi bi-cart fs-3 text-color-ips me-3"></i>
        <div>
            <h5 class="fw-bold mb-0 text-color-ips">Pedido</h5>
            <small class="text-muted fw-bold">Gestão do Estado</small>
        </div>
    </div>
    
    <div class="card-body p-0">
        @* General Information Section *@
        <div class="p-4 border-bottom bg-light bg-opacity-10">
            <h6 class="fw-bold mb-3 text-color-ips">
                <i class="bi bi-info-circle me-2"></i>Informações Gerais
            </h6>
            <div class="d-flex flex-column gap-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Total:</span>
                    <span class="text-color-ips fw-bold fs-5">@Model.TotalValue.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Itens:</span>
                    <span class="badge bg-secondary-subtle text-dark border">@ViewBag.TotalQuantity un.</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Comprador:</span>
                    <span class="text-muted small">@Model.AppUser.FirstName @Model.AppUser.LastName</span>
                </div>
            </div>
        </div>
        @* Product List *@
        <div class="p-4 border-bottom">
            <h6 class="fw-bold mb-3 text-color-ips">
                <i class="bi bi-box-seam me-2"></i>Produtos
            </h6>
            <div class="w-100 custom-scrollbar" style="max-height: 280px; overflow-y: auto;">
                @if (Model.ProductPurchases.Any())
                {
                    foreach (var item in Model.ProductPurchases)
                    {
                        var productInfo = new
                        {
                            name = item.Product.Name,
                            description = item.Product.Description,
                            price = item.ProductValue.ToString("C"),
                            categoryName = item.Product.Category.Name,
                            categoryDescription = item.Product.Category.Description,
                            stock = isStaff ? (int?)item.Product.Stock : null,
                            minStock = isStaff ? (int?)item.Product.MinimumStock : null
                        };
                        <div class="d-flex justify-content-between align-items-center p-2 mb-2 bg-color-ips-light rounded-3">
                            <div class="d-flex flex-column overflow-hidden me-2">
                                <span class="small fw-bold text-truncate">@item.Product.Name</span>
                                <span class="fs-7">@item.Quantity x @item.ProductValue.ToString("C") : @((item.ProductValue * item.Quantity).ToString("C"))</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-ips shadow-sm showProductDetails flex-shrink-0"
                                    data-product='@Html.Raw(JsonSerializer.Serialize(productInfo))'>
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small italic text-center py-3">Nenhum produto encontrado.</p>
                }
            </div>
        </div>
        
        @* Order State Management Form *@
        <div class="p-4">
            <h6 class="fw-bold mb-3 text-color-ips">
                <i class="bi bi-gear-wide-connected me-2"></i>Alterar Estado
            </h6>
            <form id="updateOrderForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="orderId" name="id" value="@Model.Id"/>
                
                <div class="mb-3">
                    <label class="form-label fw-bold text-color-ips mb-2">Alterar Estado</label>
                    <select id="statusSelect" name="newStatus" class="form-select border-ips fw-bold" onchange="toggleCodeInput()">
                        @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                        {
                            if (status is OrderStatus.Cart or OrderStatus.Cancelled) continue;
                            <option value="@((int)status)" selected="@(Model.Status == status)">@status.ToDisplayName()</option>
                        }
                    </select>
                    @*
                    <button class="btn btn-sm btn-ips shadow-sm ms-3" title="Previous state" onclick="">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                    <span>@Model.Status</span>
                    <button class="btn btn-sm btn-ips shadow-sm ms-3" title="Previous state" onclick="">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                    *@
                </div>
                @* Validate delivery (only show if state is "Entregue") *@
                <div id="codeValidationArea" class="mb-3 shadow-sm p-3 border rounded bg-light" style="display: none;">
                    <label class="form-label small fw-bold text-danger">
                        <i class="bi bi-shield-lock-fill me-1"></i>
                        Código de Validação
                    </label>
                    <input type="text" id="deliveryCode" name="codeEntered"
                           class="form-control form-control-lg text-center fw-bold border-danger"
                           placeholder="0000" maxlength="6"/>
                    <div class="form-text text-muted">O código foi enviado para o email do cliente.</div>
                </div>
                <button type="button" onclick="handleUpdate()" class="btn btn-ips w-100 py-3 fw-bold text-uppercase shadow-sm mt-2">
                    <i class="bi bi-check-circle me-2"></i> Atualizar Pedido
                </button>
            </form>
        </div>
    </div>
</div>