@model IEnumerable<Projeto_SEGUES.Models.Order.Order>

@{
    ViewData["Title"] = "Gerir Pedidos - SEGUES";
}

<div class="container mt-4">
    <div class="row align-items-end mb-4 g-3">
        <div class="col-12 col-md-auto order-1 order-md-2 text-end ms-md-auto">
            <a asp-area="Admin" asp-controller="Employee" asp-action="Index"
               class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
        <div class="col-12 col-md order-2 order-md-1">
            <h2 class="fw-bold title-underline mb-0">Gerir Pedidos</h2>
        </div>
    </div>

    @* Main row *@
    <div class="row g-4">
        @* Left panel: target of HTMX *@
        <div class="col-lg-4">
            <div id="side-panel-target">
                <div class="card shadow-sm border-0 p-5 text-center text-muted card-ips hover-shadow-ips">
                    <i class="bi bi-info-circle fs-1 mb-3 opacity-50 text-color-ips"></i>
                    <p class="small fw-bold">Selecione um pedido na tabela para ver os detalhes e gerir o estado.</p>
                </div>
            </div>
        </div>

        @* Right panel: current orders table *@
        <div class="col-lg-8">
            <h5 class="fw-bold"><i class="bi bi-clock-history me-2 text-color-ips"></i> Histórico Recente</h5>
            <div
                hx-get="/Order/OrderManagement/GetOrdersTable"
                hx-trigger="orderUpdated from:body, every 30s"
                hx-swap="innerHTML">
                <partial name="_ManageOrdersTablePartial" model="Model"/>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/inventory/inventory.js"></script>
    <script type="module" src="~/js/order/order.js"></script>
}