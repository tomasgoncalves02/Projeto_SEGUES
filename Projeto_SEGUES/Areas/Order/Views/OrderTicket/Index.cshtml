@using System.Globalization
@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Gestão de Senhas - SEGUES";
    var balance = ViewBag.UserBalance;
    var price = ViewBag.CurrentPrice;
}

<div class="container mt-4">
    @* Title row *@
    <div class="d-flex mb-4 align-items-center justify-content-between flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-ticket-detailed me-2 text-color-ips"></i>
                Comprar Senhas
            </h2>
            <p class="text-muted small mt-1 mb-0">Senhas de Refeições - SEGUES</p>
            <a asp-area="Ticket" asp-controller="Ticket" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
        @* Balance and back buttons *@
        <div class="col-md-7 text-center d-flex justify-content-end align-items-center gap-3">
            <div class="card bg-color-ips text-white border-0 shadow-sm d-inline-block" style="height: 3.5em;">
                <div class="card-body py-2 px-3">
                    <small class="d-block opacity-75 fw-bold fs-7">Saldo</small>
                    <span class="fw-bold">@balance.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
    
    @* Main row with purchase form and tickets table *@
    <div class="row g-4">
        @* Purchase form *@
        <div class="col-lg-4">
            <div class="card shadow-sm card-ips hover-shadow-ips mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-color-ips mb-4">
                        <i class="bi bi-cart-plus me-2"></i>Nova Compra
                    </h5>
                    <hr class="opacity-75 mb-4">

                    <div class="alert border-0 small mb-4" style="background-color: var(--ips-shadow-soft);">
                        Preço para o seu perfil: <strong class="text-color-ips fs-5">@price.ToString("C")</strong>
                    </div>
                    <form asp-area="Order" asp-controller="OrderTicket" asp-action="BuyTicket" method="post" id="purchaseTicketForm">
                        <div class="mb-4">
                            <label class="form-label small fw-bold">Quantidade:</label>
                            <input type="number" name="quantity" id="quantityInput"
                                   data-unitprice="@price.ToString("F2", CultureInfo.InvariantCulture)"
                                   class="form-control border-secondary-subtle" min="1" value="1" step="1"
                                   @(balance < price ? "disabled" : "") />
                        </div>
                        <div class="mb-3 small text-muted">
                            Total: <strong id="totalValue" class="text-dark">@price.ToString("C")</strong>
                        </div>
                        <button type="submit" class="btn btn-ips w-100 py-2 fw-bold shadow-sm" id="submitPurchase"
                                @(balance < price ? "disabled" : "")>
                            <i class="bi bi-check2-circle me-1"></i> CONFIRMAR COMPRA
                        </button>
                    </form>
                </div>
            </div>
        </div>
        @* Table with ticket history *@
        <div class="col-lg-8">
            <div class="card shadow-sm card-ips hover-shadow-ips">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0 fw-bold text-color-ips"><i class="bi bi-list-check me-2"></i>Registo de Senhas</h5>
                </div>

                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="text-white bg-color-ips" style="position: sticky; top: 0;">
                        <tr>
                            <th>Código</th>
                            <th>Expiração</th>
                            <th>Estado</th>
                            <th>Ação</th>
                        </tr>
                        </thead>
                        <tbody id="ticket-history-body"
                               hx-get="/Ticket/Ticket/GetUpdatedTickets"
                               hx-trigger="every 30s"
                               hx-swap="innerHTML">
                        <partial name="~/Areas/Ticket/Views/Ticket/_TicketTablePartial.cshtml" model="Model" />
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/order/createOrderTicket.js"></script>
    <script type="module" src="~/js/ticket/ticket.js"></script>
}