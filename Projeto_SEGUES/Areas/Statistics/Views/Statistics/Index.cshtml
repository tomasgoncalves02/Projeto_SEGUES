@{
    ViewData["Title"] = "Estatisticas - Admin"; 
}


<div class="container mt-5">
    @* Cabeçalho *@
    <div class="row mb-5 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold title-underline mb-0">Estatísticas</h2>
            <p class="text-muted mt-2">Visualize as estatisticas do refeitório e do bar</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar ao Painel Admin
            </a>
        </div>
    </div>

    @* Grelha de Cards *@
    <div class="row g-4 justify-content-center">

        @* CARD: Gestão de Inventário *@
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="card-ips-icon mb-4">
                        <i class="bi bi-graph-up-arrow fs-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Estatísticas do Bar</h3>
                    <p class="text-muted">Visualizar estatísticas correspondentes ao Bar</p>

                    <div class="mt-auto pt-3">
                        <a asp-area="Statistics" asp-controller="OrdersStatistics" asp-action="Index"
                           class="btn btn-ips w-100 py-2 fw-bold">
                            Ver statísticas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* CARD: Histórico Geral *@
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="card-ips-icon mb-4">
                        <i class="bi bi-graph-up-arrow fs-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Estatísticas do Refeitório</h3>
                    <p class="text-muted">Visualizar estatísticas correspondentes ao Refeitório</p>

                    <div class="mt-auto pt-3">
                        <a asp-area="Statistics" asp-controller="TicketsStatistics" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">
                            Ver estatísticas
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
