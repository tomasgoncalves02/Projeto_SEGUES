@model Transaction

@{
    ViewData["Title"] = "Deposit Balance";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0" style="border-radius: 15px; background-color: #2c3e50; color: white;">
                <div class="card-body p-5">
                    <h3 class="text-center mb-4">Carregar Saldo</h3>

                    <form asp-controller="Payment" asp-action="InitiateMbWay" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Montante (€)</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input name="amount" type="number" step="0.01" min="0.10" class="form-control" placeholder="10.00" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Número MB WAY</label>
                            <input name="phoneNumber" type="text" class="form-control" placeholder="912345678" required
                                   pattern="[0-9]{9}" title="Introduza um número de telemóvel válido (9 dígitos)" />
                        </div>

                        <button type="submit" class="btn btn-info w-100 fw-bold py-2" style="color: #2c3e50;">
                            PAGAR COM MB WAY
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <small class="text-muted">Processamento seguro via MB WAY Gateway</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>