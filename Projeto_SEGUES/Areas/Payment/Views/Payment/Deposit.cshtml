@model Transaction

@{
    ViewData["Title"] = "Carregar Saldo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card card-ips shadow-lg">
                <div class="card-body p-5">
                    <h3 class="text-center mb-4">Carregar Saldo</h3>

                    <form asp-area="Payment" asp-controller="Payment" asp-action="CreateCheckoutSession" method="post">
                        @Html.AntiForgeryToken()

                        @* Amount *@
                        <div class="mb-3">
                            <label class="form-label">Montante (€)</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input name="amount" id="amountInput" type="number" step="1" min="5" class="form-control" placeholder="5.00" required />
                            </div>
                            <div id="amountError" class="text-danger small mt-1" style="display:none;"></div>
                        </div>

                       

                        <button type="submit" class="btn btn-ips w-100 fw-bold py-2 mb-3">
                            PAGAR COM CARTÃO
                        </button>
                    </form>

                    @* Botão Voltar *@
                    <div class="text-center">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small fw-bold">
                            <i class="bi bi-chevron-left"></i> Voltar ao Início
                        </a>
                    </div>

                    <div class="mt-4 text-center border-top pt-3">
                        <small class="text-muted">Processamento seguro e encriptado via <strong>Stripe</strong></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/payment/payment.js"></script>
}