@model Transaction

@{
    ViewData["Title"] = "Deposit Balance";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card card-ips shadow-lg">
                <div class="card-body p-5">
                    <h3 class="text-center mb-4">Carregar Saldo</h3>
                    <form asp-area="Payment" asp-controller="Payment" asp-action="InitiateMbWay" method="post">
                        @Html.AntiForgeryToken()
                        @* Amount *@
                        <div class="mb-3">
                            <label class="form-label">Montante (€)</label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input name="amount" type="number" step="5" min="5" class="form-control" placeholder="5.00" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Número MB WAY</label>
                            <input name="phoneNumber" type="text" class="form-control" placeholder="000000000" required
                                   pattern="[0-9]{9}" title="Introduza um número de telemóvel válido (9 dígitos)" />
                        </div>

                        <button type="submit" class="btn btn-ips w-100 fw-bold py-2">
                            PAGAR COM MB WAY
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <small class="text-muted">Processamento seguro via MB WAY Gateway</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>