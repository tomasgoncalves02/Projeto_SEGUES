@model Projeto_SEGUES.Areas.Payment.ViewModels.DepositAmountViewModel

@{
    ViewData["Title"] = "Carregar Saldo";
}

<div class="container py-3 py-md-5">
    <div class="row justify-content-center">       
        <div class="col-12 col-md-8 col-lg-6 col-xxl-4">
            <div class="card shadow-lg card-ips hover-shadow-ips border-0">

                <div class="card-body p-4 p-md-5 d-flex flex-column">

                    @* Header Section *@
                    <div class="mb-4 mb-md-5 text-center">
                        <div class="card-ips-icon mb-3 text-color-ips">
                            <i class="bi bi-wallet2 display-4"></i>
                        </div>
                        <h1 class="fw-bold h2 h1-md mb-2 title-underline">SEGUES</h1>
                        <p class="text-muted fs-6 fs-md-5 mb-0">@ViewData["Title"]</p>
                    </div>

                    @* Payment Form *@
                    <form asp-area="Payment" asp-controller="Payment" asp-action="CreateCheckoutSession" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        @* Amount Input Group *@
                        <div class="mb-4">
                            <div class="input-group shadow-sm border-0 rounded-3 overflow-hidden">
                                <span class="input-group-text bg-color-ips-light text-color-ips fw-bold px-3 fs-5 border-0">€</span>
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Amount" id="amountInput" type="number" step="0.01" min="5" max="1000"
                                           class="form-control fw-bold fs-5 text-dark border-0" placeholder="5.00" required />
                                    <label asp-for="Amount">Montante</label>
                                </div>
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small d-block mt-2"></span>
                            <div class="form-text small mt-2">
                                <i class="bi bi-info-circle me-1"></i>O montante mínimo de carregamento é de 5€.
                            </div>
                        </div>

                        @* Submit Button *@
                        <div class="mt-4">
                            <button type="submit" class="w-100 btn btn-ips btn-lg py-3 fw-bold shadow-sm transition-all">
                                <i class="bi bi-credit-card me-2"></i>Avançar para o pagamento
                            </button>
                        </div>
                    </form>

                    @* Footer Section *@
                    <div class="mt-4 text-center">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none fw-bold small mb-4 d-inline-block">
                            <i class="bi bi-arrow-left me-1"></i>Voltar à página inicial
                        </a>

                        <div class="border-top pt-4">
                            <div class="d-flex align-items-center justify-content-center flex-column flex-sm-row gap-2">
                                <i class="bi bi-shield-check text-success fs-4"></i>
                                <span class="small text-muted text-center">
                                    Processamento seguro via <strong class="text-color-ips">Stripe</strong>
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/payment/payment.js"></script>
}