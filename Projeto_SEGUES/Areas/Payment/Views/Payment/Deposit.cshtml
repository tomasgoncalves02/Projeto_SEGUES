@model Projeto_SEGUES.Areas.Payment.ViewModels.DepositAmountViewModel

@{
    ViewData["Title"] = "Carregar Saldo";
}

<div class="container py-2 px-lg-5">
    <div class="card shadow-lg card-ips hover-shadow-ips border-0 d-flex flex-column mx-lg-7">
        @* Padding p-3 in mobile, p-4/p-5 in tablet/desktop *@
        <div class="card-body p-3 p-sm-4 p-md-5 d-flex flex-column justify-content-center">
            
            <div class="mb-4 mb-md-5 text-center d-flex flex-column align-items-center">
                @* Icon *@
                <div class="card-ips-icon mb-3 text-color-ips">
                    <i class="bi bi-wallet2 display-4"></i>
                </div>
                
                <h1 class="fw-bold display-6 display-md-5 mb-2 title-underline">SEGUES</h1>
                <p class="text-muted fs-6 fs-md-5 mb-0">@ViewData["Title"]</p>
            </div>

            <form asp-area="Payment" asp-controller="Payment" asp-action="CreateCheckoutSession" method="post">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                @* Amount Input Group with Floating Label *@
                <div class="mb-4 text-start px-md-4">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-color-ips-light text-color-ips fw-bold px-3 fs-5 border-end-0" 
                              style="border-top-right-radius: 0; border-bottom-right-radius: 0;">€</span>
                        <div class="form-floating w-100">
                            <input asp-for="Amount" id="amountInput" type="number" step="0.01" min="5" max="1000"
                                   class="form-control fw-bold fs-5 text-dark" placeholder="5.00" required 
                                   style="border-top-left-radius: 0; border-bottom-left-radius: 0; border-left: 0;" />
                            <label asp-for="Amount"></label>
                        </div>
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small d-block mt-1"></span>
                    <div class="form-text small mt-1"><i class="bi bi-info-circle me-1"></i>O montante mínimo de carregamento é de 5€.</div>
                </div>

                @* Main Submit Button *@
                <div class="px-md-4">
                    <button type="submit" class="w-100 btn btn-ips btn-lg py-2 py-md-3 fw-bold shadow-sm mb-4">
                        <i class="bi bi-credit-card me-2"></i>Avançar para o pagamento
                    </button>
                </div>
            </form>

            <div class="mt-2 text-center">
                <p class="small text-muted mb-4">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="fw-bold">
                        <i class="bi bi-arrow-left me-1"></i>Voltar à página inicial
                    </a>
                </p>
                
                @* Secure Payment Footer *@
                <div class="border-top pt-3 mx-md-4">
                    <p class="small text-muted mb-0 d-flex align-items-center justify-content-center">
                        <i class="bi bi-shield-check text-success fs-5 me-2"></i>
                        <span>Processamento seguro e encriptado via <strong class="text-color-ips">Stripe</strong></span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/payment/payment.js"></script>
}