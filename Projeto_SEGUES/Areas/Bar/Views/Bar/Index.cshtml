@{
    ViewData["Title"] = "Bar - SEGUES";
    var balance = ViewBag.UserBalance ?? 0m;
}

<div class="container mt-5">
    <div class="row mb-5">
        <div class="col-12">
            <h3 class="fw-bold display-5 title-underline mb-2">Bar</h3>
            <p class="text-muted fs-5">Selecione uma das opções abaixo para gerir os seus serviços.</p>
        </div>
    </div>

    <div class="row g-4">
        @* Card Saldo *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips bg-color-ips text-white hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <small class="d-block opacity-75 fw-bold mb-2 fs-4">Saldo Disponível</small>
                    <h2 class="display-6 fw-bold my-auto">@balance.ToString("C")</h2>
                    <div class="mt-auto">
                        <a asp-area="Payment" asp-controller="Payment" asp-action="Deposit" class="btn btn-ips fw-bold w-100 py-2" style="border: 1px solid white !important">Carregar Saldo</a>
                    </div>
                </div>
            </div>
        </div>

        @* Card Loja *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cart-plus"></i></div>
                    <h5 class="fw-bold">Efetuar Pedido</h5>
                    <p class="text-muted small mb-4">Adquire aqui o teu snack.</p>
                    <div class="mt-auto">
                        <a asp-area="Bar" asp-controller="OrderManagement" asp-for asp-action="CreateOrder" class="btn w-100 py-2 fw-bold btn-ips">
                            Ir para a Loja
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Card Pedidos *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-qr-code-scan"></i></div>
                    <h5 class="fw-bold">Pedidos</h5>
                    <p class="text-muted small mb-4">Visualiza os teus pedidos.</p>
                    <div class="mt-auto">
                        <a asp-area="Bar" asp-controller="UserOrders" asp-action="ActiveOrders" class="btn w-100 py-2 fw-bold btn-ips">Ver Pedidos</a>
                    </div>
                </div>
            </div>
        </div>

        @* Card Voltar *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-arrow-left-circle"></i></div>
                    <h5 class="fw-bold">Voltar</h5>
                    <p class="text-muted small mb-4">Voltar à página anterior.</p>
                    <div class="mt-auto">
                        <a href="/" class="btn w-100 py-2 fw-bold btn-ips">Voltar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>