@model Projeto_SEGUES.Areas.Bar.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Carrinho - SEGUES";
}

@* REMOVIDO: O bloco #swal-data daqui para não disparar ao entrar *@

<div class="container mt-4 text-start">
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h1 class="fw-bold title-underline mb-0">Carrinho</h1>
        </div>
        <div class="col-md-5 text-end d-flex justify-content-end gap-3">
            <div class="bg-color-ips text-white px-4 py-2 rounded shadow-sm d-flex flex-column align-items-center">
                <small class="fw-bold text-uppercase" style="font-size: 0.7rem;">Saldo Atual</small>
                <span class="fw-bold fs-5">@Model.UserBalance.ToString("N2") €</span>
            </div>
            <a asp-area="Bar" asp-controller="UserOrders" asp-action="CreateOrder" class="btn btn-ips-outline-secondary fw-bold px-4 shadow-sm">
                <i class="bi bi-arrow-left me-2"></i> Voltar
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card card-ips shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="bg-light border rounded p-3 mb-4">
                        <small class="text-muted fw-bold text-uppercase d-block mb-1">Total a Pagar</small>
                        <span class="fs-1 fw-bold text-color-ips">@Model.TotalAmount.ToString("N2") €</span>
                    </div>

                    <form id="formConfirmacao" asp-area="Bar" asp-controller="UserOrders" asp-action="ConfirmPurchase" method="post">
                        @Html.AntiForgeryToken()
                        <p class="fw-bold small mb-2 text-uppercase text-muted text-start">Data de recebimento</p>
                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="receiveNow" id="now" value="true" checked>
                                <label class="btn btn-outline-secondary w-100 fw-bold py-2" for="now">Agora</label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="receiveNow" id="later" value="false">
                                <label class="btn btn-outline-secondary w-100 fw-bold py-2" for="later">Depois</label>
                            </div>
                        </div>
                        <div id="pickup-time-wrapper" style="display:none;">
                            <p class="fw-bold small mb-2 text-uppercase text-muted text-start">Horário de recolha</p>
                            <div class="d-flex justify-content-center mb-4">
                                <input type="time" name="pickupTime" id="pickupTime"
                                       class="form-control fw-bold text-center" style="width:auto;">
                            </div>
                        </div>

                        @section Scripts {
                            <script>
                                // Toggle do campo de hora
                                document.querySelectorAll('input[name="receiveNow"]').forEach(function(radio) {
                                    radio.addEventListener('change', function() {
                                        var wrapper = document.getElementById('pickup-time-wrapper');
                                        if (this.value === 'false') {
                                            var agora = new Date();
                                            document.getElementById('pickupTime').value =
                                                String(agora.getHours()).padStart(2, '0') + ':' +
                                                String(agora.getMinutes()).padStart(2, '0');
                                            wrapper.style.display = 'block';
                                        } else {
                                            wrapper.style.display = 'none';
                                        }
                                    });
                                });

                                // Antes de submeter, se for "Agora" preenche a hora atual
                                document.getElementById('formConfirmacao').addEventListener('submit', function() {
                                    var receiveNow = document.querySelector('input[name="receiveNow"]:checked').value;
                                    if (receiveNow === 'true') {
                                        var agora = new Date();
                                        document.getElementById('pickupTime').value =
                                            String(agora.getHours()).padStart(2, '0') + ':' +
                                            String(agora.getMinutes()).padStart(2, '0');
                                    }
                                });
                            </script>
                        }

                        <button type="button"
                                onclick="confirmarCompraBar('formConfirmacao')"
                                class="btn btn-ips w-100 py-3 fw-bold text-uppercase shadow-sm"
                                @(Model.Items.Any() ? "" : "disabled")>
                            Confirmar compra
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card card-ips shadow-sm border-0 rounded-3 overflow-hidden">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="bg-color-ips text-white">
                        <tr>
                            <th class="ps-4 text-start py-3">Nome</th>
                            <th>Preço</th>
                            <th>Qtd</th>
                            <th class="pe-4">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 text-start fw-bold">@item.Name</td>
                                <td class="text-color-ips fw-bold">@item.Price.ToString("C")</td>
                                <td><span class="badge bg-light text-dark border px-3">@item.Quantity</span></td>
                                <td class="pe-4">
                                    <button type="button" class="btn btn-link text-muted p-0 border-0"
                                            onclick="removeFromCart(@item.ProductId, '@item.Name')">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>