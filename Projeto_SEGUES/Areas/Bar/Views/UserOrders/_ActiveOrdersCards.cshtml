@model IEnumerable<Projeto_SEGUES.Models.Bar.BarOrder>

@{
    // Agrupamos por Código para mostrar um cartão por "sacada" de produtos
    var pedidosAgrupados = Model.GroupBy(o => o.RedemptionCode)
                                .Select(g => g.First())
                                .ToList();
}

@if (!pedidosAgrupados.Any())
{
    <div class="col-12 w-100 text-center py-5 my-5">
        <div class="d-flex flex-column align-items-center justify-content-center">
            <i class="bi bi-bag-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted fw-bold">Não tens pedidos ativos no Bar.</h4>
            <div class="mt-3">
                <a asp-area="Bar" asp-controller="UserOrders" asp-action="CreateOrder" class="btn btn-ips px-4 py-2 shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i>Fazer Pedido
                </a>
            </div>
        </div>
    </div>
}
else
{
    @foreach (var item in pedidosAgrupados)
    {
        // Lógica para determinar que hora mostrar
        bool eAgendado = item.OrderPickUp != TimeSpan.Zero;

        <div class="col">
            <div class="card h-100 shadow-sm card-ips border-0" style="border-top: 4px solid #008484 !important;">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between mb-3 align-items-center">
                        @* Badge de Estado *@
                        <span class="badge @(item.Status == 0 ? "bg-secondary" : item.Status == 1 ? "bg-info text-dark" : "bg-warning text-dark")">
                            @((item.Status == 0) ? "Pendente" : (item.Status == 1) ? "Em Preparação" : "Pronto")
                        </span>

                        @* Lógica da Hora: Se for agendado mostra a hora do agendamento, se não mostra a hora do pedido *@
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>
                            @if (eAgendado)
                            {
                                <span class="fw-bold text-dark">@item.OrderPickUp.ToString(@"hh\:mm")</span>
                            }
                            else
                            {
                                <span>@item.OrderDate.ToString("HH:mm")</span>
                            }
                        </small>
                    </div>

                    @* Código de Resgate *@
                    <div class="text-center my-3">
                        <h3 class="fw-bold mb-0" style="letter-spacing: 6px; color: #333;">
                            @item.RedemptionCode
                        </h3>
                        <small class="text-muted text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">Código de Resgate</small>
                    </div>

                    <div class="mt-auto">
                        <a asp-area="Bar" asp-controller="UserOrders" asp-action="OrderDetails" asp-route-id="@item.Id"
                           class="btn btn-ips w-100 py-2 fw-bold">
                            <i class="bi bi-info-circle me-2"></i>INFORMAÇÕES
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}