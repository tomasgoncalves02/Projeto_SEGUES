@model IEnumerable<Projeto_SEGUES.Models.Bar.BarOrder>

@if (!Model.Any())
{
    <div class="col-12 w-100 text-center py-5 my-5">
        <div class="d-flex flex-column align-items-center justify-content-center">
            <i class="bi bi-bag-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted fw-bold">Não tens pedidos ativos no Bar.</h4>
            <div class="mt-3">
                <a asp-area="Bar" asp-controller="OrderManagement" asp-action="CreateOrder" class="btn btn-ips px-4 py-2 shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i>Fazer Pedido
                </a>
            </div>
        </div>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm card-ips">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between mb-3 align-items-center">
                        @* Badge dinâmica baseada no estado do BarOrder *@
                        <span class="badge @(item.Status == 0 ? "bg-secondary" : item.Status == 1 ? "bg-info text-dark" : "bg-warning text-dark")">
                            @((item.Status == 0) ? "Pendente" : (item.Status == 1) ? "Em Preparação" : "Pronto")
                        </span>
                        <small class="text-muted"><i class="bi bi-clock"></i> @item.OrderDate.ToString("HH:mm")</small>
                    </div>

                    @* Código com o mesmo letter-spacing das senhas *@
                    <h3 class="text-center fw-bold my-3" style="letter-spacing: 6px; color: #333;">
                        @item.RedemptionCode
                    </h3>

                    <div class="mt-auto">
                        @* Botão igual ao das senhas, mas chama os detalhes *@
                        <button class="btn btn-ips w-100 py-2 fw-bold" onclick="verDetalhesProdutos(@item.Id)">
                            <i class="bi bi-info-circle me-2"></i>INFORMAÇÕES
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}