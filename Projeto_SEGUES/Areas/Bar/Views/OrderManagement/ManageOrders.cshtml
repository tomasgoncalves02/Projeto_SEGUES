@model IEnumerable<Projeto_SEGUES.Models.Bar.BarOrder>

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-7 text-start">
            <h2 class="fw-bold title-underline mb-0">Gerir Pedidos</h2>
        </div>
        <div class="col-md-5 text-end">
            <a asp-area="Admin" asp-controller="Employee" asp-action="Index" class="btn btn-ips-outline-secondary px-4 shadow-sm">
                Voltar
            </a>
        </div>
    </div>

    <div class="row g-4">
        @* PAINEL ESQUERDO: Alvo do HTMX *@
        <div class="col-lg-4">
            <div id="side-panel-target">
                <div class="card shadow-sm border-0 p-5 text-center text-muted card-ips">
                    <i class="bi bi-info-circle fs-1 mb-3 opacity-50 text-color-ips"></i>
                    <p class="small fw-bold">Selecione um pedido na tabela para ver os detalhes e gerir o estado.</p>
                </div>
            </div>
        </div>

        @* PAINEL DIREITO: Tabela de Monitorização *@
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="bg-color-ips text-white">
                        <tr>
                            <th>Numero</th>
                            <th>Itens</th>
                            <th>Preço</th>
                            <th>Estado</th>
                            <th>Pedido efetuado</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.GroupBy(o => o.RedemptionCode).Select(g => g.First()))
                        {
                            var totalAmount = Model.Where(o => o.RedemptionCode == order.RedemptionCode).Sum(o => o.PriceAtTime * o.Quantity);
                            var itemCount = Model.Where(o => o.RedemptionCode == order.RedemptionCode).Sum(o => o.Quantity);

                            <tr>
                                <td class="fw-bold">Pedido:@order.Id</td>
                                <td>@itemCount</td>
                                <td class="text-color-ips fw-bold">@totalAmount.ToString("N2")€</td>
                                <td>
                                    <span class="badge @(order.Status == 0 ? "bg-secondary" : order.Status == 1 ? "bg-info" : "bg-warning")">
                                        @((order.Status == 0) ? "Pendente" : (order.Status == 1) ? "Em Preparação" : "Pronto")
                                    </span>
                                </td>
                                <td>@order.OrderDate.ToString("HH:mm")</td>
                                <td>
                                    <button class="btn btn-sm btn-ips shadow-sm" 
                                            hx-get="/Bar/OrderManagement/GetOrderDetailsSide/@order.Id" 
                                            hx-target="#side-panel-target">
                                        <i class="bi bi-eye text-white"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>