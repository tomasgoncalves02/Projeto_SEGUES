@model Projeto_SEGUES.Models.Bar.BarOrder
@{
    // Obtém a lista de itens agrupados pelo RedemptionCode que passaste no ViewBag
    var items = ViewBag.ItemsInOrder as List<Projeto_SEGUES.Models.Bar.BarOrder>;
    decimal total = items?.Sum(i => i.PriceAtTime * i.Quantity) ?? 0;
}

<div class="card shadow-sm border-0 card-ips animate__animated animate__fadeIn">
    @* Barra Superior de Design *@
    <div style="height: 8px; background-color: #009d9d; border-radius: 10px 10px 0 0;"></div>

    <div class="card-body p-4 text-start">
        <div class="d-flex align-items-center mb-4">
            <i class="bi bi-cart-check fs-2 text-color-ips me-3"></i>
            <h3 class="fw-bold mb-0 text-color-ips">Pedido #@Model.Id</h3>
        </div>

        <h6 class="fw-bold border-bottom pb-2 mb-3 text-uppercase small">Informações</h6>
        <div class="mb-4">
            <p class="mb-1"><b>Valor Total:</b> <span class="text-color-ips fw-bold">@total.ToString("N2")€</span></p>
            <p class="mb-1"><b>Quantidade:</b> @(items?.Sum(i => i.Quantity) ?? 0) itens</p>

            @* ALTERAÇÃO AQUI: Mudamos de UserName/Email para a propriedade do Nome *@
            <p class="mb-1"><b>Comprador:</b> @(Model.User?.FirstName ?? Model.User?.UserName ?? "Cliente")</p>
        </div>

        <h6 class="fw-bold border-bottom pb-2 mb-3 text-uppercase small">Produtos no Pedido</h6>
        <div class="mb-4" style="max-height: 250px; overflow-y: auto;">
            @if (items != null && items.Any())
            {
                foreach (var item in items)
                {
                    <div class="d-flex justify-content-between border-bottom py-2 small">
                        <span>@item.Product.Name <b class="text-color-ips">x @item.Quantity</b></span>
                        <span class="fw-bold">@((item.PriceAtTime * item.Quantity).ToString("N2"))€</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted small">Nenhum produto encontrado.</p>
            }
        </div>

        @* Formulário de Alteração de Estado *@
        <form id="updateOrderForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="orderId" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label small fw-bold text-muted">Alterar Estado</label>
                <select id="statusSelect" name="newStatus" class="form-select border-ips fw-bold">
                    <option value="0" selected="@(Model.Status == 0)">Pendente</option>
                    <option value="1" selected="@(Model.Status == 1)">Em Preparação</option>
                    <option value="2" selected="@(Model.Status == 2)">Pronto para Entrega</option>
                    <option value="3" selected="@(Model.Status == 3)">Entregue</option>
                </select>
            </div>

            <button type="button" onclick="handleUpdate()" class="btn btn-ips w-100 py-3 fw-bold text-uppercase shadow-sm">
                <i class="bi bi-check-circle me-2"></i> Atualizar Pedido
            </button>
        </form>
    </div>
</div>