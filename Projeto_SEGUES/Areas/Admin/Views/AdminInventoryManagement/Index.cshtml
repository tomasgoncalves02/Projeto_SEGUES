@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Areas.Admin.ViewModels.InventoryManagementViewModel

@{
    ViewData["Title"] = "Gestão de Inventário";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-3 mb-md-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h2 class="fw-bold display-6 title-underline mb-1">Gestão de Inventário</h2>
            <p class="text-muted small mb-0 mt-1">Inventário de lanches e bebidas do Bar.</p>
        </div>
        <a asp-area="Admin" asp-controller="AdminBarManagement" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    <div class="row g-4 text-start">
        @* Create Product Form *@
        <div class="col-lg-4">
            <div class="card card-ips hover-shadow-ips shadow-sm h-100 border-0 small fs-md-6">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-color-ips">
                        <i class="bi bi-plus-circle me-2"></i>Novo Produto
                    </h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <form asp-area="Admin" asp-controller="AdminInventoryManagement" asp-action="Create" method="post">
                        <div class="mb-2 mb-md-3">
                            <label asp-for="@Model.NewProduct.Name" class="fw-bold small text-muted"></label>
                            <input asp-for="@Model.NewProduct.Name" class="form-control" placeholder="Ex: Sandes de Atum" required/>
                            <span asp-validation-for="@Model.NewProduct.Name" class="text-danger small"></span>
                        </div>
                        <div class="mb-2 mb-md-3">
                            <label asp-for="@Model.NewProduct.CategoryId" class="fw-bold small text-muted"></label>
                            <select asp-for="@Model.NewProduct.CategoryId" class="form-select" asp-items="Model.Categories" required>
                                <option value="">Selecione uma categoria</option>
                            </select>
                            <span asp-validation-for="@Model.NewProduct.CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="row g-2 mb-2 mb-md-3">
                            <div class="col-6">
                                <label asp-for="@Model.NewProduct.Price" class="fw-bold small text-muted">Preço (€)</label>
                                <input asp-for="@Model.NewProduct.Price" type="number" step="0.01" class="form-control fw-bold"/>
                                <span asp-validation-for="@Model.NewProduct.Price" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="@Model.NewProduct.Stock" class="fw-bold small text-muted">Stock</label>
                                <input asp-for="@Model.NewProduct.Stock" type="number" class="form-control fw-bold"/>
                                <span asp-validation-for="@Model.NewProduct.Stock" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="@Model.NewProduct.MinimumStock" class="fw-bold small text-muted">Stock mínimo</label>
                                <input asp-for="@Model.NewProduct.MinimumStock" type="number" class="form-control fw-bold"/>
                                <span asp-validation-for="@Model.NewProduct.MinimumStock" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mb-3 mb-md-4">
                            <label asp-for="@Model.NewProduct.Description" class="fw-bold small text-muted">Descrição</label>
                            <textarea asp-for="@Model.NewProduct.Description" class="form-control" rows="4" placeholder="Breve descrição..." maxlength="250"></textarea>
                            <span asp-validation-for="@Model.NewProduct.Description" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-ips w-100 py-2 py-md-3 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-2"></i>Confirmar Registo
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        @* Filter and Product List *@
        <div class="col-lg-8 d-flex flex-column">
            @* Filters *@
            <div class="card card-ips hover-shadow-ips shadow-sm mb-3 mb-md-4 border-0 small fs-md-6">
                <div class="card-body p-3 p-md-3 bg-color-ips-very-light">
                    <form id="inventoryFilterForm"
                          hx-get="/Admin/AdminInventoryManagement/GetProducts"
                          hx-trigger="submit, change, keyup delay:300ms from:#nameFilter"
                          hx-target="#productListContainer"
                          hx-indicator=".loader-spinner"
                          hx-on::after-request="updateProductsCount()"
                          class="row g-3 align-items-end">
                        
                        @* Search Filter *@
                        <div class="col-12 col-md-6">
                            <label asp-for="SearchModel.SearchString" class="form-label fw-bold small text-muted mb-1"></label>
                            <input asp-for="SearchModel.SearchString" id="nameFilter" class="form-control" placeholder="Nome do produto...">
                        </div>
                        @* Category Filter *@
                        <div class="col-12 col-md-6">
                            <label asp-for="SearchModel.CategoryId" class="fw-bold small text-muted mb-1"></label>
                            <select asp-for="SearchModel.CategoryId" class="form-select" asp-items="Model.Categories">
                                <option value="">Todas as Categorias</option>
                            </select>
                        </div>
                        @* Price Range Filter *@
                        <div class="col-12 col-md-4">
                            <label asp-for="SearchModel.MaxPrice" class="fw-bold small text-muted mb-1"></label>
                            <div class="input-group">
                                <input asp-for="SearchModel.MaxPrice" type="number" class="form-control" placeholder="Ex: 5.00" step="0.01" min="0">
                                <span class="input-group-text bg-white text-muted">€</span>
                            </div>
                        </div>
                        @* Stock *@
                        <div class="col-12 col-md-4">
                            <label asp-for="SearchModel.StockLevel" class="fw-bold small text-muted mb-1"></label>
                            <select asp-for="SearchModel.StockLevel" class="form-select" asp-items="Html.GetEnumSelectList<StockLevel>()">
                                <option value="">Qualquer</option>
                            </select>
                        </div>
                        @* Status Filter *@
                        <div class="col-12 col-md-4">
                            <label asp-for="SearchModel.ActiveOnly" class="fw-bold small text-muted mb-2 d-block"></label>
                            <div class="form-check form-switch fs-5 mb-0 d-inline-block">
                                <input asp-for="SearchModel.ActiveOnly" class="form-check-input shadow-sm" type="checkbox" role="switch" style="cursor: pointer;">
                                <label asp-for="SearchModel.ActiveOnly" class="form-check-label fs-6 ms-1 text-dark" style="cursor: pointer;">
                                    Apenas Ativos
                                </label>
                            </div>
                        </div>
                        @* Actions *@
                        <div class="col-12 mt-3 border-top pt-3">
                            <div class="d-flex justify-content-end align-items-center gap-3">
                                @* Loading Spinner do HTMX *@
                                <div class="d-flex align-items-center text-color-ips htmx-indicator loader-spinner me-2">
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span class="small fw-bold">A filtrar...</span>
                                </div>
                        
                                <a asp-area="Admin" asp-controller="AdminInventoryManagement" asp-action="Index" class="btn btn-sm fw-bold btn-reset-x btn-ips-outline-secondary px-4 shadow-sm">
                                    <i class="bi bi-x-circle me-1"></i>Limpar Filtros
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            @* Product List *@
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 flex-grow-1 d-flex flex-column">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-color-ips"><i class="bi bi-list-ul me-2"></i>Lista de Produtos</h5>
                    <span class="badge bg-color-ips-light text-color-ips border fs-6 py-2 px-3 text-center">
                        Total: <span id="productsCountBadge">@Model.Products.Count</span> produtos
                    </span>
                </div>
                <div class="table-responsive flex-grow-1" style="max-height: 600px;">
                    <table class="table table-hover align-middle mb-0 text-center small fs-md-6" id="productsTable">
                        <thead class="bg-color-ips text-white position-sticky top-0">
                            <tr>
                                <th class="py-2 py-md-3 text-start ps-3 ps-md-4">Nome</th>
                                <th class="py-2 py-md-3">Categoria</th>
                                <th class="py-2 py-md-3">Preço</th>
                                <th class="py-2 py-md-3">Stock</th>
                                <th class="py-2 py-md-3 pe-3 pe-md-4">Ação</th>
                            </tr>
                        </thead>
                        <tbody id="productListContainer"
                               hx-get="/Admin/AdminInventoryManagement/GetProducts"
                               hx-include="#inventoryFilterForm"
                               hx-trigger="every 30s"
                               hx-swap="innerHTML"
                               hx-on::after-request="updateProductsCount()">
                            <partial name="_ProductListPartial" model="@Model.Products"/>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/inventory/inventory.js"></script>
}