@model Projeto_SEGUES.Areas.Inventory.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Gestão de Inventário - SEGUES";
}

<div class="container mt-5">
    @* Top row *@
    <div class="row mb-5 align-items-center">
        <div class="col-md-6 text-start">
            <h2 class="fw-bold title-underline mb-0">Gestão de Inventário</h2>
            <p class="text-muted mt-2">Inventário de lanches e bebidas do Bar.</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-area="Admin" asp-controller="AdminBarManagement" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    <div class="row g-4 text-start">
        @* Create Product Form *@
        <div class="col-lg-4">
            <div class="card card-ips hover-shadow-ips shadow-sm h-100 border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-color-ips">
                        <i class="bi bi-plus-circle me-2"></i>Novo Produto
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-area="Admin" asp-controller="AdminInventoryManagement" asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="@Model.Name" class="form-label fw-bold small text-muted"></label>
                            <input asp-for="@Model.Name" class="form-control" placeholder="Ex: Sandes de Atum" required />
                            <span asp-validation-for="@Model.Name" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="@Model.CategoryId" class="form-label fw-bold small text-muted"></label>
                            <select asp-for="@Model.CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                                <option value="">Selecione uma categoria</option>
                            </select>
                            <span asp-validation-for="@Model.CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label asp-for="@Model.Price" class="form-label fw-bold small text-muted">Preço (€)</label>
                                <input asp-for="@Model.Price" type="number" step="0.01" class="form-control fw-bold text-color-ips" />
                            </div>
                            <div class="col-6">
                                <label asp-for="@Model.Stock" class="form-label fw-bold small text-muted">Stock</label>
                                <input asp-for="@Model.Stock" type="number" class="form-control fw-bold" />
                            </div>
                            <div class="col-12">
                                <label asp-for="@Model.MinimumStock" class="form-label fw-bold small text-muted">Stock mínimo</label>
                                <input asp-for="@Model.MinimumStock" type="number" class="form-control fw-bold" />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold small text-muted">Descrição</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Breve descrição..." maxlength="250"></textarea>
                            <div class="form-text text-end small">Máximo 250 caracteres.</div>
                        </div>
                        <button type="submit" class="btn btn-ips w-100 py-3 fw-bold shadow-sm">
                            <i class="bi bi-check-lg me-2"></i>Confirmar Registo
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* Filter and Product List *@
        <div class="col-lg-8">
            @* Filters *@
            <div class="card card-ips hover-shadow-ips shadow-sm mb-4 border-0">
                <div class="card-body p-4 filter-bar">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">Categoria</label>
                            <select class="form-select" id="categoryFilter" asp-items="ViewBag.Categories">
                                <option value="">Todas as Categorias</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-muted">Pesquisar</label>
                            <input type="text" id="nameFilter" class="form-control" placeholder="Nome do produto...">
                        </div>
                        <div class="col-md-3">
                            <div class="d-flex flex-column gap-2">
                                <button type="button" id="clearProductsTableFilters" class="btn btn-sm fw-bold">
                                    <i class="bi bi-x-circle me-1"></i> Limpar Filtros
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Product List *@
            <div class="card card-ips hover-shadow-ips shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-color-ips"><i class="bi bi-list-ul me-2"></i>Lista de Produtos</h5>
                    <span class="badge bg-light text-dark border"><span id="productsCountBadge">@ViewBag.Products.Count</span> registos</span>
                </div>
                <div class="table-responsive" style="max-height: 600px;">
                    <table class="table table-hover align-middle mb-0 text-center" id="productsTable">
                        <thead class="bg-color-ips text-white position-sticky top-0">
                            <tr>
                                <th class="py-3 text-start ps-4">Nome</th>
                                <th class="py-3">Categoria</th>
                                <th class="py-3">Preço</th>
                                <th class="py-3">Stock</th>
                                <th class="py-3 text-center pe-4">Ação</th>
                            </tr>
                        </thead>
                        <tbody id="productListContainer"
                             hx-get="/Admin/AdminInventoryManagement/GetProducts"
                             hx-trigger="every 60s"
                             hx-swap="innerHTML">
                            <partial name="_ProductListPartial" model="@ViewBag.Products" />
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/inventory/inventory.js"></script>
}