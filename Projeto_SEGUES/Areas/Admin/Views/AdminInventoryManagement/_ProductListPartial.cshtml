@using System.Text.Json
@model List<Projeto_SEGUES.Areas.Inventory.ViewModels.ProductDto>

@if (!Model.Any())
{
    <tr>
        <td colspan="5" class="text-center py-5 text-muted">
            <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
            Nenhum produto encontrado.
        </td>
    </tr>
}
else
{
    @foreach (var p in Model)
    {
        <tr class="table-row-ips-hover productRow @p.InactiveRowClass" 
            data-name="@p.Name" 
            data-categoryid="@p.CategoryId"
            data-price="@p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
            data-stock="@p.Stock"
            data-minstock="@p.MinimumStock"
            data-isactive="@p.IsActive.ToString().ToLower()">
            <td class="fw-bold text-start ps-3 ps-md-4">@p.Name</td>
            <td class="text-color-ips fw-bold">@p.CategoryName</td>
            <td class="text-color-ips fw-bold text-nowrap">@p.FormattedPrice</td>
            <td>
                <span class="badge @p.StockBadgeClass">
                    @p.Stock
                </span>
            </td>
            <td class="text-center pe-3 pe-md-4">
                <div class="btn-group shadow-sm">
                    @* Product details button *@
                    <button type="button" class="btn btn-sm btn-ips showProductDetails" title="Detalhes"
                            data-product='@Html.Raw(JsonSerializer.Serialize(p.ModalInfo))'>
                        <i class="bi bi-eye"></i>
                    </button>
                    @* Edit product button *@
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-ips-outline-secondary" title="Editar">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    @if (p.IsActive)
                    {
                        @* Inactive product button *@
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" id="delete-form-@p.Id" class="d-inline" style="z-index: 1;">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-sm btn-outline-danger confirmDeleteProduct" style="border-top-left-radius: 0; border-bottom-left-radius: 0; margin-left: -1px;"
                                    data-id="@p.Id" data-name="@p.Name" title="Desativar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        @* Reactivate product button *@
                        <form asp-action="Reactivate" asp-route-id="@p.Id" method="post" id="reactivate-form-@p.Id" class="d-inline" style="z-index: 1;">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-sm btn-outline-success confirmReactivateProduct" style="border-top-left-radius: 0; border-bottom-left-radius: 0; margin-left: -1px;"
                                    data-id="@p.Id" data-name="@p.Name" title="Reativar">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </form>
                    }
                </div>
            </td>
        </tr>
    }
}