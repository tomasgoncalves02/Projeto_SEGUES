@model Projeto_SEGUES.Areas.Admin.ViewModels.CreateProductViewModel
@{
    ViewData["Title"] = "Editar Produto";
}

<div class="container py-4 py-md-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-3 mb-md-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h1 class="fw-bold display-6 mb-1 title-underline">
                <i class="bi bi-box-seam me-2 text-color-ips"></i>
                Editar Produto
            </h1>
            <p class="text-muted small mt-1 mb-0">Altere as informações, preço ou stock do produto selecionado.</p>
        </div>
        @* Return button *@
        <a asp-area="Admin" asp-controller="AdminInventoryManagement" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 overflow-hidden small fs-md-6">
                <div class="card-body p-4 p-md-5 text-start">
                    <form asp-action="Edit" method="post" id="editForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="@Model.Id" />
                        <input type="hidden" asp-for="@Model.IsActive" />
                        <div class="row g-4">
                            @* Name *@
                            <div class="col-12 my-2 my-md-3">
                                <label asp-for="@Model.Name" class="fw-bold small text-muted"></label>
                                <input asp-for="@Model.Name" class="form-control" placeholder="Ex: Sandes de Atum"/>
                                <span asp-validation-for="@Model.Name" class="text-danger small"></span>
                            </div>
                            @* Description *@
                            <div class="col-12 my-2 my-md-3">
                                <label asp-for="@Model.Description" class="fw-bold small text-muted"></label>
                                <textarea asp-for="@Model.Description" class="form-control" rows="3" placeholder="Breve descrição..."></textarea>
                                <span asp-validation-for="@Model.Description" class="text-danger small"></span>
                            </div>
                            @* Category *@
                            <div class="col-md-6 my-2 my-md-3">
                                <label asp-for="@Model.CategoryId" class="fw-bold small text-muted"></label>
                                <select asp-for="@Model.CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">Selecione uma categoria</option>
                                </select>
                                <span asp-validation-for="@Model.CategoryId" class="text-danger small"></span>
                            </div>
                            @* Stock *@
                            <div class="col-6 col-md-3 my-2 my-md-3">
                                <label asp-for="@Model.Stock" class="fw-bold small text-muted"></label>
                                <input asp-for="@Model.Stock" type="number" class="form-control fw-bold" min="0"/>
                                <span asp-validation-for="@Model.Stock" class="text-danger small"></span>
                            </div>
                            @* Minimum Stock *@
                            <div class="col-6 col-md-3 my-2 my-md-3">
                                <label asp-for="@Model.MinimumStock" class="fw-bold small text-muted"></label>
                                <input asp-for="@Model.MinimumStock" type="number" class="form-control fw-bold" min="0"/>
                                <span asp-validation-for="@Model.MinimumStock" class="text-danger small"></span>
                            </div>
                            @* Price *@
                            <div class="col-12 my-2 my-md-3">
                                <label asp-for="@Model.Price" class="fw-bold small text-muted d-block mb-2 mb-md-3"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-color-ips-light text-color-ips px-3 fw-bold">€</span>
                                    <input asp-for="@Model.Price" type="number" step="0.01" class="form-control fw-bold px-3" min="0"/>
                                </div>
                                <span asp-validation-for="@Model.Price" class="text-danger small mt-2 d-block"></span>
                            </div>
                        </div>
                        
                        @* Buttons *@
                        <div class="d-flex flex-column flex-md-row justify-content-center gap-3 mt-3">
                            <a asp-area="Admin" asp-controller="AdminInventoryManagement" asp-action="Index" class="btn btn-ips-outline-secondary px-5 fw-bold order-2 order-md-1">Cancelar</a>
                            <button type="submit" class="btn btn-ips px-5 fw-bold shadow-sm order-1 order-md-2">
                                <i class="bi bi-check2-circle me-2"></i>Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/inventory/inventory.js"></script>
}