@model Projeto_SEGUES.Areas.Inventory.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Editar Produto - SEGUES";
}

<div class="container py-4 py-md-5">
    @* Cabeçalho *@
    <div class="text-start mb-4 px-md-2">
        <h2 class="fw-bold title-underline mb-0">Editar Produto</h2>
        <p class="text-muted mt-2">Altere as informações, preço ou stock do produto selecionado.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-body p-4 p-md-5 text-start">
                    <form asp-action="Edit" method="post" id="editForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="@Model.Id" />
                        <input type="hidden" asp-for="@Model.IsActive" />

                        <div class="row g-4">
                            @* Nome *@
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted text-uppercase">Nome do Produto</label>
                                <input asp-for="@Model.Name" class="form-control" placeholder="Ex: Sandes de Atum" />
                                <span asp-validation-for="@Model.Name" class="text-danger small"></span>
                            </div>

                            @* Descrição *@
                            <div class="col-12">
                                <label class="form-label fw-bold small text-muted text-uppercase">Descrição Detalhada</label>
                                <textarea asp-for="@Model.Description" class="form-control" rows="3" placeholder="Breve descrição..."></textarea>
                                <span asp-validation-for="@Model.Description" class="text-danger small"></span>
                            </div>

                            @* Categoria *@
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted text-uppercase">Categoria</label>
                                <select asp-for="@Model.CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">Selecione uma categoria</option>
                                </select>
                                <span asp-validation-for="@Model.CategoryId" class="text-danger small"></span>
                            </div>

                            @* Stocks agrupados como no outro form *@
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold small text-muted text-uppercase">Stock</label>
                                <input asp-for="@Model.Stock" type="number" class="form-control fw-bold" />
                                <span asp-validation-for="@Model.Stock" class="text-danger small"></span>
                            </div>

                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold small text-muted text-uppercase">Mínimo</label>
                                <input asp-for="@Model.MinimumStock" type="number" class="form-control fw-bold" />
                                <span asp-validation-for="@Model.MinimumStock" class="text-danger small"></span>
                            </div>

                            @* Campo de Preço Estilizado com as classes do teu site.css *@
                            <div class="col-12">
                                <div class="p-4 bg-light rounded border shadow-sm">
                                    <label class="form-label fw-bold small text-muted text-uppercase d-block mb-3">Preço Unitário (€)</label>
                                    <div class="input-group">
                                        @* Uso de bg-color-ips e text-white como no formulário de gestão *@
                                        <span class="input-group-text bg-color-ips text-white border-0 px-3 fw-bold">€</span>
                                        <input asp-for="@Model.Price" type="number" step="0.01" class="form-control border-0 fw-bold fs-5 px-3" />
                                    </div>
                                    <span asp-validation-for="@Model.Price" class="text-danger small mt-2 d-block"></span>
                                </div>
                            </div>
                        </div>

                        @* Botões Responsivos *@
                        <div class="d-flex flex-column flex-md-row justify-content-center gap-3 mt-5">
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 fw-bold order-2 order-md-1">Cancelar</a>
                            <button type="submit" class="btn btn-ips px-5 fw-bold shadow-sm text-uppercase order-1 order-md-2">
                                <i class="bi bi-save me-2"></i>Guardar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="module" src="~/js/inventory/inventory.js"></script>
}