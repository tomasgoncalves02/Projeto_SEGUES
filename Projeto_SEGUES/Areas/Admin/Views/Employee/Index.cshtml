@{
    ViewData["Title"] = "Painel de Gestão";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center col-12 col-md-auto mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">Painel de Gestão</h2>
        </div>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Cards *@
    <div class="row g-4 justify-content-center">
        @* Validate Tickets *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="card-ips-icon mb-3 fs-1 text-color-ips"><i class="bi bi-shield-check"></i></div>
                    <h3 class="card-title fw-bold">Validar Senhas</h3>
                    <p class="text-muted">Utilize esta ferramenta para confirmar a validade das senhas de refeição.</p>
                    <div class="mt-auto pt-3">
                        <a asp-area="Ticket" asp-controller="TicketValidation" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">
                            Validar Senhas
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        @* Manage Orders *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="card-ips-icon mb-3 fs-1 text-color-ips"><i class="bi bi-cup-straw"></i></div>
                    <h3 class="card-title fw-bold">Gerir Pedidos</h3>
                    <p class="text-muted">Utilize esta ferramenta para gerir os pedidos efetuados no bar.</p>
                    <div class="mt-auto pt-3">
                        <a asp-area="Order" asp-controller="OrderManagement" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">
                            Gerir Pedidos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>