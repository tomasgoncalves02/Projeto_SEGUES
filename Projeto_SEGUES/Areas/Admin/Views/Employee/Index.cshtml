@{
    ViewData["Title"] = "Painel de Gestão";
}

<style>
    /* Fundo suave para dar profundidade */
    body {
        background-color: #f8f9fa;
    }

    /* Contentor centralizado */
    .validation-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Cartão de Ação Única */
    .action-card {
        border: none;
        border-radius: 20px;
        background: white;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        max-width: 500px;
        width: 100%;
    }

        .action-card:hover {
            transform: scale(1.02);
            box-shadow: 0 15px 35px rgba(0, 150, 151, 0.15) !important;
        }

    /* Decoração superior */
    .card-accent {
        height: 8px;
        background: var(--ips);
        border-radius: 20px 20px 0 0;
    }
    
    .btn-validate {
        background-color: var(--ips);
        color: white;
        border: none;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s;
    }

        .btn-validate:hover {
            background-color: #007a7b;
            color: white;
            box-shadow: 0 4px 15px rgba(0, 150, 151, 0.3);
        }
</style>

<div class="container">
    @* Cabeçalho Minimalista *@
    <div class="pt-5 text-center">
        <h2 class="fw-bold text-dark">Painel de Gestão</h2>
        <div class="d-flex justify-content-center">
            <hr style="width: 50px; border: 2px solid var(--ips); opacity: 1;">
        </div>
    </div>

    <div class="validation-wrapper">
        <div class="card shadow-lg action-card">
            <div class="card-accent"></div>
            <div class="card-body p-5 text-center">

                @* Ícone Flutuante *@
                <div class="icon-circle">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h3 class="fw-bold mb-3" style="color: #333;">Validar Senhas</h3>

                <p class="text-muted mb-5">
                    Utilize esta ferramenta para confirmar a validade das senhas de refeição.
                </p>

                @* Botão de Ação Direta *@
                <a asp-area="Ticket" asp-controller="TicketValidation" asp-action="Index" class="btn btn-validate w-100 py-3 rounded-pill shadow-sm">
                    <i class="bi bi-qr-code-scan me-2"></i> Validar
                </a>

                <div class="mt-4">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small fw-bold">
                        <i class="bi bi-chevron-left"></i> Voltar ao Início
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>