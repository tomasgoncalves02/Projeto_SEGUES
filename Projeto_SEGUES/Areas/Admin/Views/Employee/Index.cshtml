@{
    ViewData["Title"] = "Painel de Gestão";
}

<div class="container mt-5">
    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold title-underline mb-0">Painel de Gestão</h2>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary px-4">Voltar</a>
    </div>

    <div class="row g-4 justify-content-center">
        @* Card: Validar Senhas (Refeitório) *@
        <div class="col-md-5">
            <div class="card h-100 shadow-sm card-ips hover-translate">
                <div class="card-body text-center p-5">
                    <div class="card-ips-icon mb-4">
                        <i class="bi bi-shield-check fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Validar Senhas</h4>
                    <p class="text-muted mb-4">
                        Utilize esta ferramenta para confirmar a validade das senhas de refeição.
                    </p>
                    <a asp-area="Ticket" asp-controller="TicketValidation" asp-action="Index"
                       class="btn btn-ips w-100 py-2 fw-bold">Validar Senhas</a>
                </div>
            </div>
        </div>

        @* Card: Gerir Pedidos (Bar) *@
        <div class="col-md-5">
            <div class="card h-100 shadow-sm card-ips hover-translate">
                <div class="card-body text-center p-5">
                    <div class="card-ips-icon mb-4">
                        <i class="bi bi-cup-straw fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Gerir Pedidos</h4>
                    <p class="text-muted mb-4">
                        Utilize esta ferramenta para gerir os pedidos efetuados no bar.
                    </p>
                    <a asp-area="Order" asp-controller="OrderManagement" asp-action="Index"
                       class="btn btn-ips w-100 py-2 fw-bold">Gerir Pedidos</a>
                </div>
            </div>
        </div>
    </div>
</div>