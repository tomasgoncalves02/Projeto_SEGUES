@{
    ViewData["Title"] = "Painel de Gestão";
}

<div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh;">
    @* Header *@
    <div class="text-center mb-5">
        <h2 class="fw-bold title-underline mx-auto mb-2">Painel de Gestão</h2>
        <p class="text-muted">Área de Funcionário</p>
    </div>
    
    @* Card *@
    <div class="card card-ips shadow-lg w-100" style="max-width: 480px;">
        <div class="card-body p-5 text-center">
            @* Icon *@
            <div class="card-ips-icon mb-4">
                <i class="bi bi-qr-code-scan fs-1"></i>
            </div>
            
            <h3 class="fw-bold mb-3 text-dark">Validar Senhas</h3>
            
            <p class="text-muted mb-4 small">
                Utilize esta ferramenta para confirmar a validade das senhas de refeição.
            </p>
            
            @* Main Button *@
            <a asp-area="Ticket" asp-controller="TicketValidation" asp-action="Index"
               class="btn btn-ips w-100 py-3 rounded-pill fw-bold shadow-sm text-uppercase">
                Validar <i class="bi bi-arrow-right ms-2 fs-6"></i>
            </a>
            
            @* Footer Link *@
            <div class="mt-4 pt-3 border-top">
                <a asp-area="" asp-controller="Home" asp-action="Index" 
                   class="text-muted small fw-bold">
                    <i class="bi bi-chevron-left me-1 fs-6"></i> Voltar ao Início
                </a>
            </div>
        </div>
    </div>
</div>