@model Projeto_SEGUES.Areas.Admin.ViewModels.MenuManagementViewModel

@{
    ViewData["Title"] = "Configurar Ementas - SEGUES";
}

<div class="container mt-5">
    @* Cabeçalho *@
    <div class="row mb-5 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold title-underline mb-0">Gestão de Ementas Externas</h2>
            <p class="text-muted mt-2">Define os destinos dos links para as ementas da empresa externa.</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @* Alerta de Sucesso *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm card-ips hover-shadow-ips p-4">
                <form asp-action="SaveLinks" method="post">
                    <div class="row g-4">

                        @* Ementa Refeitório *@
                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-light shadow-sm">
                                <label class="form-label fw-bold text-color-ips">
                                    <i class="bi bi-egg-fried me-2"></i>Ementa do Refeitório
                                </label>
                                @* asp-for preenche automaticamente o link que está na BD *@
                                <input asp-for="CanteenUrl" class="form-control form-control-lg"
                                       placeholder="https://exemplo.com/refeitorio">
                                <div class="form-text">
                                    <strong>Atual:</strong>
                                    <span class="text-break">@(string.IsNullOrEmpty(Model.CanteenUrl) ? "Nenhum link definido" : Model.CanteenUrl)</span>
                                </div>
                            </div>
                        </div>

                        @* Ementa Bar *@
                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-light shadow-sm">
                                <label class="form-label fw-bold text-color-ips">
                                    <i class="bi bi-cup-hot me-2"></i>Ementa do Bar
                                </label>
                                <input asp-for="BarUrl" class="form-control form-control-lg"
                                       placeholder="https://exemplo.com/bar">
                                <div class="form-text">
                                    <strong>Atual:</strong>
                                    <span class="text-break">@(string.IsNullOrEmpty(Model.BarUrl) ? "Nenhum link definido" : Model.BarUrl)</span>
                                </div>
                            </div>
                        </div>

                        @* Botão de Gravar *@
                        <div class="col-12 text-center mt-4">
                            <button type="submit" class="btn btn-ips px-5 py-3 fw-bold shadow-sm">
                                <i class="bi bi-save me-2"></i>Guardar Alterações
                            </button>
                        </div>

                    </div>
                </form>
            </div>          
        </div>
    </div>
</div>