@model Projeto_SEGUES.Areas.Admin.ViewModels.MenuManagementViewModel

@{
    ViewData["Title"] = "Configurar Ementas";
}

<div class="container mt-5">
    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-3 mb-md-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h2 class="fw-bold display-6 title-underline mb-1">Gestão de Ementas Externas</h2>
            <p class="text-muted small mb-0 mt-1">Define os destinos dos links para as ementas da empresa externa.</p>
        </div>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm card-ips hover-shadow-ips p-4">
                <form asp-action="SaveLinks" method="post">
                    <div class="row g-4">
                        @* Canteen Menu *@
                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-color-ips-light shadow-sm">
                                <label class="form-label fw-bold text-color-ips">
                                    <i class="icon-fork-knife bg-color-ips" style="mask-size: 40px 47px; width: 40px; height: 47px; zoom: 0.5"></i>
                                    Ementa do Refeitório
                                </label>
                                <input asp-for="CanteenUrl" class="form-control form-control-lg" placeholder="https://exemplo.com/refeitorio"/>
                                <div class="form-text">
                                    <strong>Atual:</strong>
                                    <span class="text-break">@(string.IsNullOrEmpty(Model.CanteenUrl) ? "Nenhum link definido" : Model.CanteenUrl)</span>
                                </div>
                            </div>
                        </div>
                        @* Bar Menu *@
                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-color-ips-light shadow-sm">
                                <label class="form-label fw-bold text-color-ips">
                                    <i class="bi bi-cup-hot me-2"></i>Ementa do Bar
                                </label>
                                <input asp-for="BarUrl" class="form-control form-control-lg" placeholder="https://exemplo.com/bar">
                                <div class="form-text">
                                    <strong>Atual:</strong>
                                    <span class="text-break">@(string.IsNullOrEmpty(Model.BarUrl) ? "Nenhum link definido" : Model.BarUrl)</span>
                                </div>
                            </div>
                        </div>
                        @* Save *@
                        <div class="col-12 text-center mt-3 mt-md-4">
                            <button type="submit" class="btn btn-ips px-5 py-2 py-md-3 fw-bold shadow-sm">
                                <i class="bi bi-save me-2"></i>Guardar Alterações
                            </button>
                        </div>
                    </div>
                </form>
            </div>          
        </div>
    </div>
</div>