@model Projeto_SEGUES.Areas.Admin.ViewModels.AdminUserManagementViewModel

@{
    ViewData["Title"] = "Lista de Utilizadores";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex mb-3 mb-md-4 justify-content-between align-items-center col-12 col-md-auto flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h1 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-people me-2 text-color-ips"></i>Gestão de Utilizadores
            </h1>
            <p class="text-muted mb-0 mt-1">Gestão das contas dos utilizadores e permissões.</p>
        </div>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    
    @* Filters *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-md-4 border-0 rounded-3 small fs-md-6">
        <div class="card-body p-3 p-md-4 bg-color-ips-very-light">
            <form id="filterForm"
                  hx-get="/Admin/AdminUserManagement/GetFilteredUsers"
                  hx-trigger="submit, change, keyup delay:300ms from:#searchFilter"
                  hx-target="#userTableBody"
                  hx-indicator=".loader-spinner"
                  class="row g-3 align-items-end text-start">
                
                @* Search Filter *@
                <div class="col-md-6 col-xl mt-2 mt-md-auto">
                    <label asp-for="SearchModel.SearchString" class="small fw-bold">Pesquisar</label>
                    <input asp-for="SearchModel.SearchString" id="searchFilter" type="text" class="form-control form-control-sm" placeholder="Nome ou email...">
                </div>
                
                @* Role Filter *@
                <div class="col-md-4 col-xl-2">
                    <label asp-for="SearchModel.RoleFilter" class="small fw-bold">Role</label>
                    <select asp-for="SearchModel.RoleFilter" class="form-select form-select-sm" asp-items="Model.Roles" id="roleFilter">
                        <option value="">Todos os Roles</option>
                    </select>
                </div>
                
                @* Category Filter *@
                <div class="col-md-4 col-xl-2">
                    <label asp-for="SearchModel.CategoryFilter" class="small fw-bold">Categoria</label>
                    <select asp-for="SearchModel.CategoryFilter" class="form-select form-select-sm" asp-items="Model.Categories" id="categoryFilter">
                        <option value="">Todas as Categorias</option>
                    </select>
                </div>
                
                @* Actions *@
                <div class="col-xl-auto">
                    <div class="d-flex align-items-center justify-content-end gap-3 pb-1">
                        @* HTMX Loading Spinner *@
                        <div class="d-flex align-items-center text-color-ips htmx-indicator loader-spinner" id="searchSpinner">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span class="small fw-bold">A pesquisar...</span>
                        </div>
                        @* Clear button *@
                        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="btn btn-sm btn-reset-x btn-ips-outline-secondary fw-bold px-3">
                            <i class="bi bi-x-circle me-1"></i>Limpar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* User table *@
    <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 small fs-md-6">
        <div class="card-header bg-white py-2 py-md-3 border-bottom">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <h5 class="mb-0 fw-bold text-color-ips">
                    <i class="bi bi-person-lines me-2"></i>Contas de Sistema
                </h5>
                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 gap-md-3">
                    @* Users counter *@
                    <span class="badge bg-color-ips-light text-color-ips border fs-6 py-2 px-3 text-center">
                        Total: <span id="usersCountBadge">@Model.SearchModel.Results.Count()</span> utilizadores
                    </span>

                    @* PDF Export button *@
                    <form asp-area="Admin" asp-controller="AdminUserManagement" asp-action="ExportUsersPdf" method="get" target="_blank" id="exportPdfForm" class="m-0">
                        <input asp-for="SearchModel.SearchString" type="hidden" id="exportPdfSearch" />
                        <input asp-for="SearchModel.RoleFilter" type="hidden" id="exportPdfRole" />
                        <input asp-for="SearchModel.CategoryFilter" type="hidden" id="exportPdfCategory" />
                        
                        <button type="submit" class="btn btn-ips fw-bold shadow-sm px-3 px-md-4 py-2 py-2">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Exportar PDF
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="table-responsive" style="max-height: 500px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white" style="position: sticky; top: 0;">
                <tr>
                    <th class="ps-3 ps-md-4 py-2 py-md-3 text-start">Nome</th>
                    <th class="py-2 py-md-3">Email</th>
                    <th class="py-2 py-md-3">Role</th>
                    <th class="py-2 py-md-3">Categoria</th>
                    <th class="py-2 py-md-3">Estado</th>
                    <th class="py-2 py-md-3">Saldo</th>
                    <th class="pe-3 pe-md-4 py-2 py-md-3">Ações</th>
                </tr>
                </thead>
                <tbody id="userTableBody"
                       hx-get="/Admin/AdminUserManagement/GetFilteredUsers"
                       hx-trigger="every 60s"
                       hx-include="#filterForm"
                       hx-swap="innerHTML">
                    <partial name="_UserTableRowsPartial" model="Model.SearchModel.Results"/>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/admin/userManagement.js"></script>
}