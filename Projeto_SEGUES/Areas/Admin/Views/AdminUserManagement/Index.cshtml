@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Projeto_SEGUES.Models.Enums
@using Projeto_SEGUES.Models.User
@inject UserManager<AppUser> UserManager
@model IEnumerable<Projeto_SEGUES.Models.User.AppUser>

@{
    ViewData["Title"] = "Lista de Utilizadores";
    var roles = ViewBag.Roles as List<SelectListItem> ?? [];
    var categories = ViewBag.Categories as List<SelectListItem> ?? [];
    var currentRole = ViewData["CurrentRole"] as string ?? "";
    var currentCategory = ViewData["CurrentCategory"] as string ?? "";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold title-underline">Lista de Utilizadores</h1>
        @* Return button *@
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4" style="padding-top: 0.72rem; padding-bottom: 0.71rem;">
            <i class="bi bi-arrow-left me-2"></i>Voltar ao Painel
        </a>
    </div>
    @* Filters *@
    <div class="card card-ips mb-4 shadow-sm">
        <div class="card-body py-4">
            <form method="get" asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="row g-3 align-items-center">
                @* SearchFilter *@
                <div class="col-md-6">
                    <div class="input-group flex-nowrap">
                        <label for="searchFilter" class="col-form-label fw-bold small me-3">Pesquisar:</label>
                        <input id="searchFilter" type="text" name="searchString" class="form-control border-0 bg-light"
                               placeholder="Nome ou email..."
                               value="@ViewData["SearchString"]" style="border-radius: 8px 0 0 8px; min-width: 9em"/>
                        <button class="btn btn-ips fw-bold px-4" type="submit"
                                style="border-radius: 0 8px 8px 0;">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                @* RoleFilter *@
                <div class="col-md-auto">
                    <div class="input-group flex-nowrap">
                        <label for="roleFilter" class="col-form-label fw-bold small me-3">Role:</label>
                        <select id="roleFilter" name="roleFilter" class="form-select border-0 bg-light"
                                onchange="this.form.submit()" style="border-radius: 8px;">
                            <option value="" selected=@(string.IsNullOrEmpty(currentRole) ? "selected" : null)>Todos os Roles</option>
                            @foreach (var r in roles)
                            {
                                <option value="@r.Value" selected=@(r.Value == currentRole ? "selected" : null)>@r.Text</option>
                            }
                        </select>
                    </div>
                </div>
                @* CategoryFilter *@
                <div class="col-md-auto">
                    <div class="input-group flex-nowrap">
                        <label for="categoryFilter" class="col-form-label fw-bold small me-3">Categoria:</label>
                        <select id="categoryFilter" name="categoryFilter" class="form-select border-0 bg-light"
                                onchange="this.form.submit()" style="border-radius: 8px;">
                            <option value="" selected=@(string.IsNullOrEmpty(currentCategory) ? "selected" : null)>Todas as Categorias</option>
                            @foreach (var r in categories)
                            {
                                <option value="@r.Value" selected=@(r.Value == currentCategory ? "selected" : null)>@r.Text</option>
                            }
                        </select>
                    </div>
                </div>
                @* Clean *@
                <div class="col-md-auto">
                    <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="text-decoration-none fw-bold btn-reset-x">Limpar Filtros</a>
                </div>
            </form>
        </div>
    </div>

    @* User table *@
    <div class="card shadow-sm border-0">
        <div class="table-responsive rounded-3" style="max-height: 500px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white">
                <tr>
                    <th class="ps-4 py-3">Nome</th>
                    <th class="py-3">Email</th>
                    <th class="py-3">Role</th>
                    <th class="py-3">Categoria</th>
                    <th class="py-3">Estado</th>
                    <th class="py-3">Saldo</th>
                    <th class="pe-4 py-3">Ações</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        @* Name *@
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle me-3">
                                    @(string.IsNullOrEmpty(user.FirstName) ? "?" : user.FirstName.Substring(0, 1).ToUpper())
                                </div>
                                <div class="fw-bold text-dark text-start">@user.FirstName @user.LastName</div>
                            </div>
                        </td>
                        @* Email *@
                        <td class="text-muted">@user.Email</td>
                        @* Role *@
                        <td>
                            @{
                                var userRoles = await UserManager.GetRolesAsync(user);
                                var userRole = userRoles.FirstOrDefault() ?? "Client";
                                var roleText = roles.Find(r => r.Value == userRole)?.Text ?? userRole;
                            }
                            <span class="badge @userRole.ToBadgeClass()" style="min-width: 90px; padding: 7px;">
                                @roleText.ToUpper()
                            </span>
                        </td>
                        @* Category *@
                        <td>
                            @{
                                var categoryName = user.UserCategory?.Name ?? "N/A";
                            }
                            <span class="badge @categoryName.ToBadgeClass()" style="min-width: 90px; padding: 7px;">
                                @categoryName.ToUpper()
                            </span>
                        </td>
                        @* Status (NOVO) *@
                        <td>
                            @{                                    
                                var statusPortu = user.Status == UserStatus.Active ? "ATIVO" : "INATIVO";
                                var statusColor = user.Status == UserStatus.Active ? "bg-success" : "bg-danger";
                            }
                            <span class="badge @statusColor border-0 shadow-sm" style="min-width: 90px; padding: 7px; font-weight: 600;">
                                <i class="bi @(user.Status == UserStatus.Active ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                @statusPortu
                            </span>
                        </td>
                        @* Balance *@
                        <td class="fw-bold text-color-ips">@user.Balance.ToString("C")</td>
                        @* Actions *@
                        <td class="text-start pe-4">
                            <div class="btn-group">
                                @* Detalhes *@
                                <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Details" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-ips" title="Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @* Editar - Agora com a lógica de bordas original *@
                                <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Edit" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary m-md-0 border-start-0 @(user.Id != User.FindFirstValue(ClaimTypes.NameIdentifier) ? "border-end-0" : "")"
                                   title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                @if (user.Id != User.FindFirstValue(ClaimTypes.NameIdentifier))
                                {
                                    if (user.Status == UserStatus.Inactive)
                                    {
                                        @* Botão Ativar *@
                                        <form asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Activate" asp-route-id="@user.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-0 rounded-end" title="Ativar Conta">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        @* Botão Desativar *@
                                        <form asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Deactivate" asp-route-id="@user.Id" method="post" id="deactivate-form-@user.Id" style="display:inline;">
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-0 rounded-end"
                                                    onclick="confirmDeactivate('@user.Id', '@user.FirstName @user.LastName')"
                                                    title="Desativar Conta">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDeactivate(userId, userName) {
            Notifications.confirm(
                '',
                `Tem a certeza que deseja desativar o utilizador <b>${userName}</b>?<br>
                 <small class='text-muted'>O utilizador deixará de ter acesso à plataforma.</small>`,
            ).then((result) => {
                if (result.isConfirmed) {
                    // Submit the specific form for this user
                    document.getElementById('deactivate-form-' + userId).submit();
                }
            });
        }
    </script>
}