@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Projeto_SEGUES.Models.User
@inject UserManager<AppUser> UserManager
@model IEnumerable<Projeto_SEGUES.Models.User.AppUser>

@{
    ViewData["Title"] = "Lista de Utilizadores";
    var roles = ViewBag.Roles as List<SelectListItem> ?? [];
    var categories = ViewBag.Categories as List<SelectListItem> ?? [];
    var combinedFilters = roles
        .Where(r => r.Value != "Client")
        .Concat(categories).ToList();
    var currentRole = ViewData["CurrentRole"] as string ?? "";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold title-underline">Lista de Utilizadores</h1>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn-ips-outline-secondary fw-bold px-4">
            <i class="bi bi-arrow-left me-2"></i>Voltar ao Painel
        </a>
    </div>
    @* Filters *@
    <div class="card card-ips mb-4 shadow-sm">
        <div class="card-body py-4">
            <form method="get" asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="row g-3 align-items-center">
                @* SearchFilter *@
                <div class="col-md-4">
                    <div class="input-group flex-nowrap">
                        <label for="searchFilter" class="col-form-label fw-bold small me-3">Pesquisar:</label>
                        <input id="searchFilter" type="text" name="searchString" class="form-control border-0 bg-light"
                               placeholder="Nome ou email..."
                               value="@ViewData["SearchString"]" style="border-radius: 8px 0 0 8px; min-width: 9em"/>
                        <button class="btn btn-ips fw-bold px-4" type="submit"
                                style="border-radius: 0 8px 8px 0;">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                @* RoleFilter *@
                <div class="col-md-auto">
                    <div class="input-group flex-nowrap">
                        <label for="roleFilter" class="col-form-label fw-bold small me-3">Role:</label>
                        <select id="roleFilter" name="roleFilter" class="form-select border-0 bg-light"
                                onchange="this.form.submit()" style="border-radius: 8px;">
                            <option value="" selected=@(string.IsNullOrEmpty(currentRole) ? "selected" : null)>Todos os Utilizadores</option>
                            @foreach (var r in combinedFilters)
                            {
                                <option value="@r.Value" selected=@(r.Value == currentRole ? "selected" : null)>@r.Text</option>
                            }
                        </select>
                    </div>
                </div>
                @* Clean *@
                <div class="col-md-auto">
                    <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="text-decoration-none fw-bold btn-reset-x">Limpar Filtros</a>
                </div>
            </form>
        </div>
    </div>

    @* User table *@
    <div class="card shadow-sm border-0 rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white">
                    <tr>
                        <th class="ps-4 py-3">Nome</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Role</th>
                        <th class="py-3">Saldo</th>
                        <th class="pe-4 py-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            @* Name *@
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3">
                                        @(string.IsNullOrEmpty(user.FirstName) ? "?" : user.FirstName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="fw-bold text-dark">@user.FirstName @user.LastName</div>
                                </div>
                            </td>
                            @* Email *@
                            <td class="text-muted">@user.Email</td>
                            @* Role *@
                            <td>
                                @{
                                    var userRoles = await UserManager.GetRolesAsync(user);
                                    var userRole = userRoles.FirstOrDefault() ?? "Client";
                                    var categoryName = user.UserCategory.Name;
                                    var roleText = roles.Find(r => userRole != "Client" && r.Value == userRole)?.Text ?? categoryName;
                                }
                                @if (userRole == "Client")
                                {
                                    <span class="badge @categoryName.ToBadgeClass()" style="min-width: 100px; padding: 8px;">
                                        @roleText.ToUpper()
                                    </span>
                                }
                                else
                                {
                                    <span class="badge @userRole.ToBadgeClass()" style="min-width: 100px; padding: 8px;">
                                        @roleText.ToUpper()
                                    </span>
                                }
                            </td>
                            @* Balance *@
                            <td class="fw-bold text-color-ips">@user.Balance.ToString("C")</td>
                            <td class="text-start pe-4">
                                <div class="btn-group">
                                    <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-ips" title="Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (user.Id != User.FindFirstValue(ClaimTypes.NameIdentifier))
                                    {
                                        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>