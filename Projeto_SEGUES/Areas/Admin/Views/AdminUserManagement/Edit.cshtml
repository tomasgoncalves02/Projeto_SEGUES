@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Areas.User.ViewModels.EditUserAdminViewModel

@{
    ViewData["Title"] = "Editar Utilizador";
}

<div class="container mt-5">
    @* Top row *@
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="mb-2">
                <h2 class="fw-bold m-0 title-underline">Editar Utilizador</h2>
                <p class="text-muted small">Altere as informações de perfil, permissões ou o saldo do utilizador selecionado.</p>
            </div>
            @* Form card *@
            <div class="card shadow-sm card-ips hover-shadow-ips">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id"/>
                        @* Name *@
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold small"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold small"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>
                        @* Email Field *@
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold small"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="exemplo@ips.pt" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        @* Gender and BirthDate *@
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label fw-bold small"></label>
                                <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                    <option value="">Selecione...</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BirthDate" class="form-label fw-bold small"></label>
                                <input asp-for="BirthDate" type="date" class="form-control"/>
                                <span asp-validation-for="BirthDate" class="text-danger small"></span>
                            </div>
                        </div>
                        @* Role and Category *@
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Role" class="form-label fw-bold small"></label>
                                <select asp-for="Role" class="form-select" asp-items="ViewBag.Roles">
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-bold small"></label>
                                <select asp-for="Category" class="form-select" asp-items="ViewBag.Categories">
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mb-4 p-3 bg-light rounded border">
                            <label asp-for="Balance" class="form-label fw-bold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-color-ips text-white fw-bold">€</span>
                                <input asp-for="Balance"
                                       type="number"
                                       step="0.01"
                                       max="30000"
                                       data-val="true"
                                       data-val-range="O saldo máximo permitido é de 30.000,00€."
                                       data-val-range-max="30000"
                                       data-val-range-min="0"
                                       class="form-control fw-bold" />
                            </div>
                            <span asp-validation-for="Balance" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-evenly">
                            <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="btn btn-outline-secondary fw-bold px-4">Cancelar</a>
                            <button type="submit" class="btn btn-ips fw-bold px-5">Guardar Alterações</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}