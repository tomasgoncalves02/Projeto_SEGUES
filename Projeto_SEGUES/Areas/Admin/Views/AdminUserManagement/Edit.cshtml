@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Areas.Admin.ViewModels.EditUserAdminViewModel

@{
    ViewData["Title"] = "Editar Utilizador";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex mb-3 mb-md-4 justify-content-between align-items-center col-12 col-md-auto flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h1 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-person-gear me-2 text-color-ips"></i>Editar Utilizador
            </h1>
            <p class="text-muted mb-0 mt-1">Altere as informações de perfil, permissões ou o saldo do utilizador selecionado.</p>
        </div>
        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    
    @* Form card *@
    <div class="card shadow-sm card-ips hover-shadow-ips small fs-md-6">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                <input type="hidden" asp-for="Id"/>
                @Html.AntiForgeryToken()
                
                <h5 class="fw-bold mb-3 text-color-ips">
                    <i class="bi bi-person-badge me-2"></i>Informações Pessoais
                </h5>
                <div class="row g-3 mb-3 mb-md-4 text-start">
                    @* Name *@
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="FirstName" class="form-control"/>
                            <label asp-for="FirstName" placeholder="Nome"></label>
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="LastName" class="form-control"/>
                            <label asp-for="LastName" placeholder="Apelido"></label>
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small d-block mt-1"></span>
                    </div>
                    @* Gender, BirthDate, NIF *@
                    <div class="col-md-4">
                        <div class="form-floating">
                            <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Gender>()">
                                <option value="">Selecione...</option>
                            </select>
                            <label asp-for="Gender"></label>
                        </div>
                        <span asp-validation-for="Gender" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="BirthDate" type="date" class="form-control"/>
                            <label asp-for="BirthDate"></label>
                        </div>
                        <span asp-validation-for="BirthDate" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="FiscalNumber" class="form-control" placeholder="NIF"/>
                            <label asp-for="FiscalNumber"></label>
                        </div>
                        <span asp-validation-for="FiscalNumber" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
                <h5 class="fw-bold mb-3 text-color-ips border-top pt-3">
                    <i class="bi bi-house-door me-2"></i>Morada
                </h5>
                <div class="row g-3 mb-3 mb-md-4 text-start">
                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Address" class="form-control" placeholder="Morada" />
                            <label asp-for="Address"></label>
                        </div>
                        <span asp-validation-for="Address" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-8">
                        <div class="form-floating">
                            <input asp-for="City" class="form-control" placeholder="Cidade" />
                            <label asp-for="City"></label>
                        </div>
                        <span asp-validation-for="City" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <input asp-for="PostalCode" class="form-control" placeholder="Código Postal" />
                            <label asp-for="PostalCode"></label>
                        </div>
                        <span asp-validation-for="PostalCode" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
                @if (Model.ShowSchool)
                {
                    <h5 class="fw-bold mb-3 text-color-ips border-top pt-3">
                        <i class="bi bi-building me-2"></i>Informações Institucionais
                    </h5>
                    <div class="row g-3 mb-3 mb-md-4 text-start">
                        @if (Model.IsStudent)
                        {
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="StudentNumber" class="form-control" placeholder="Nº Estudante"/>
                                    <label asp-for="StudentNumber"></label>
                                </div>
                                <span asp-validation-for="StudentNumber" class="text-danger small d-block mt-1"></span>
                            </div>
                        }
                        @if (Model.IsEmployee)
                        {
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="RoleDescription" class="form-control" placeholder="Cargo"/>
                                    <label asp-for="RoleDescription"></label>
                                </div>
                                <span asp-validation-for="RoleDescription" class="text-danger small d-block mt-1"></span>
                            </div>
                        }
                        <div class="col-md-12">
                            <div class="form-floating">
                                <select asp-for="SchoolId" class="form-select" asp-items="Model.SchoolsList">
                                    <option value="">Selecione a Escola/Faculdade...</option>
                                </select>
                                <label asp-for="SchoolId"></label>
                            </div>
                            <span asp-validation-for="SchoolId" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>
                }
                <h5 class="fw-bold mb-3 text-color-ips border-top pt-3">
                    <i class="bi bi-shield-lock me-2"></i>Acesso ao Sistema
                </h5>
                <div class="row g-3 mb-3 mb-md-4 text-start">
                    @* Email Field *@
                    <div class="col-md-12">
                        <div class="form-floating">
                            <input asp-for="Email" class="form-control" placeholder="exemplo@ips.pt"/>
                            <label asp-for="Email"></label>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>
                    @* Role and Category *@
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="Role" class="form-select" asp-items="Model.RolesList"></select>
                            <label asp-for="Role"></label>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="Category" class="form-select" asp-items="Model.CategoriesList"></select>
                            <label asp-for="Category"></label>
                        </div>
                        <span asp-validation-for="Category" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
                
                <h5 class="fw-bold mb-3 text-color-ips border-top pt-3">
                    <i class="bi bi-wallet2 me-2"></i>Saldo
                </h5>
                <div class="row g-3 mb-4 text-start">
                    <div class="col-md-4">
                        <div class="input-group input-group-lg shadow-sm">
                            <span class="input-group-text bg-color-ips-light text-color-ips fw-bold border-0">€</span>
                            <div class="form-floating flex-grow-1">
                                <input asp-for="Balance" type="number" step="0.01" max="30000" class="form-control fw-bold border-start-0" placeholder="Saldo" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" />
                                <label asp-for="Balance"></label>
                            </div>
                        </div>
                        <span asp-validation-for="Balance" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
                
                @* Actions Buttons *@
                <div class="d-grid gap-3 d-md-flex justify-content-md-end border-top pt-3 pt-md-4 mt-2">
                    <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4 shadow-sm">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-ips fw-bold px-5 shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-check2-circle me-2"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}