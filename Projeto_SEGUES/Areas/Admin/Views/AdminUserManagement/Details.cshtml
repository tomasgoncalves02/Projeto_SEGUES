@model Projeto_SEGUES.Models.User.AppUser

@{
    ViewData["Title"] = "Detalhes do Utilizador";
    var roleDisplay = ViewBag.UserRole as string ?? "Sem Role";
    var categoryDisplay = Model.UserCategory.Name;
    var accountStatus = Model.Status.ToString();
}

<div class="container mt-5">
    <div class="row align-items-center justify-content-between mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h1 class="fw-bold title-underline mb-0">👤 Ficha de Utilizador</h1>
        </div>
        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm card-ips hover-shadow-ips">
        @* Card header *@
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold">@Model.FirstName @Model.LastName</h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row g-4">
                @* Left column *@
                <div class="col-md-6 border-end">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted text-uppercase small">Email / Username</dt>
                        <dd class="col-sm-7 fw-bold">@Model.Email</dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Género</dt>
                        <dd class="col-sm-7 mt-3">@ViewBag.GenderPT</dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Data de Nascimento</dt>
                        <dd class="col-sm-7 mt-3">@Model.BirthDate.ToShortDateString()</dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Saldo Atual</dt>
                        <dd class="col-sm-7 mt-3 text-ips fs-4 fw-bold">@Model.Balance.ToString("C")</dd>
                    </dl>
                </div>

                @* Right column *@
                <div class="col-md-6 ps-md-5">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted text-uppercase small">Data de Criação</dt>
                        <dd class="col-sm-7">@Model.CreationDate.ToShortDateString()</dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Estado da Conta</dt>
                        <dd class="col-sm-7 mt-3">
                            <span class="badge @ViewBag.StatusClass fs-6 px-3 py-2 border-0 shadow-sm">
                                <i class="bi @ViewBag.StatusIcon me-1"></i>
                                @ViewBag.StatusPT
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Role</dt>
                        <dd class="col-sm-7 mt-3">
                            @{
                                string roleRaw = ViewBag.UserRoleRaw as string ?? "Client";
                            }
                            <span class="badge @roleRaw.ToBadgeClass() fs-6 px-3 py-2 shadow-sm" style="min-width: 100px;">
                                @ViewBag.UserRole.ToUpper()
                            </span>
                        </dd>

                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Categoria</dt>
                        <dd class="col-sm-7 mt-3">
                            @{
                                string categoryName = Model.UserCategory?.Name ?? "N/A";
                            }
                            <span class="badge @categoryName.ToBadgeClass() fs-6 px-3 py-2 shadow-sm" style="min-width: 100px;">
                                @categoryName.ToUpper()
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        @* Actions footer *@
        <div class="card-footer bg-light border-0 py-4 px-4 px-md-5">
            <div class="d-flex flex-wrap gap-3">
                <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-ips fw-bold px-4 py-2">
                    <i class="bi bi-pencil-square me-2"></i>Editar Dados
                </a>

                @if (User.Identity?.Name != Model.UserName)
                {
                    if (Model.Status == Projeto_SEGUES.Models.Enums.UserStatus.Inactive)
                    {
                        <form asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Activate" asp-route-id="@Model.Id" method="post" id="activate-form-@Model.Id" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-success fw-bold px-4 py-2 confirmActivateUser"
                                    style="border-radius: 8px;"
                                    data-id="@Model.Id" data-name="@Model.FirstName @Model.LastName">
                                <i class="bi bi-person-check me-2"></i>Ativar Conta
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Deactivate" asp-route-id="@Model.Id" method="post" id="deactivate-form-@Model.Id" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-outline-danger fw-bold px-4 py-2 confirmDeactivateUser"
                                    style="border-radius: 8px;"
                                    data-id="@Model.Id" data-name="@Model.FirstName @Model.LastName">
                                <i class="bi bi-person-x me-2"></i>Desativar Conta
                            </button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/admin/userManagement.js"></script>
}