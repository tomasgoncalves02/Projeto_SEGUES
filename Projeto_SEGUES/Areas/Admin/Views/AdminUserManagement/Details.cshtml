@model Projeto_SEGUES.Models.User.AppUser

@{
    ViewData["Title"] = "Detalhes do Utilizador";
    var roleDisplay = ViewBag.UserRole as string ?? "Sem Role";
    var categoryDisplay = Model.UserCategory.Name;
    var accountStatus = Model.Status.ToString();
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold title-underline">👤 Ficha de Utilizador</h1>
        @* Return button *@
        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4" style="padding-top: 0.72rem; padding-bottom: 0.71rem;">
            <i class="bi bi-arrow-left me-2"></i>Voltar à Lista
        </a>
    </div>

    <div class="card shadow-sm card-ips">
        @* Card header *@
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            @* Name *@
            <h4 class="mb-0 fw-bold">
                @Model.FirstName @Model.LastName
            </h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row g-4">
                @* Left column *@
                <div class="col-md-6 border-end">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted text-uppercase small">Email / Username</dt>
                        <dd class="col-sm-7 fw-bold">@Model.Email</dd>
                        
                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Género</dt>
                        <dd class="col-sm-7 mt-3">@Model.Gender</dd>
                        
                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Data de Nascimento</dt>
                        <dd class="col-sm-7 mt-3">@Model.BirthDate.ToShortDateString()</dd>
                        
                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Saldo Atual</dt>
                        <dd class="col-sm-7 mt-3 text-ips fs-4 fw-bold">@Model.Balance.ToString("C")</dd>
                    </dl>
                </div>

                @* Right column *@
                <div class="col-md-6 ps-md-5">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted text-uppercase small">Data de Criação</dt>
                        <dd class="col-sm-7">@Model.CreationDate.ToShortDateString()</dd>
                        
                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Estado da Conta</dt>
                        <dd class="col-sm-7 mt-3">
                            <span class="badge @accountStatus.ToBadgeClass() fs-6 px-3 py-2 border">
                                @accountStatus.ToUpper()
                            </span>
                        </dd>
                        
                        @* Role *@
                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Role</dt>
                        <dd class="col-sm-7 mt-3">
                            <span class="badge @roleDisplay.ToBadgeClass() fs-6 px-3 py-2">
                                @roleDisplay.ToUpper()
                            </span>
                        </dd>
                        
                        @* Category *@
                        <dt class="col-sm-5 text-muted text-uppercase small mt-3">Categoria</dt>
                        <dd class="col-sm-7 mt-3">
                            <span class="badge @categoryDisplay.ToBadgeClass() fs-6 px-3 py-2">
                                @categoryDisplay.ToUpper()
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        @* Actions footer *@
        <div class="card-footer bg-light border-0 py-4 px-4 px-md-5">
            <div class="d-flex flex-wrap gap-3">
                @* Edit button *@
                <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-ips fw-bold px-4 py-2">
                    <i class="bi bi-pencil-square me-2"></i>Editar Dados
                </a>

                @* Delete button *@
                @if (User.Identity?.Name != Model.UserName)
                {
                    <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger fw-bold px-4 py-2"
                       style="border-radius: 8px;">
                        <i class="bi bi-trash me-2"></i>Apagar Conta
                    </a>
                }
            </div>
        </div>
    </div>
</div>