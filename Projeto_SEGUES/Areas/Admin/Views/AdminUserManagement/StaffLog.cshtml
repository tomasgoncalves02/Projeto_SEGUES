@model Projeto_SEGUES.Areas.Admin.ViewModels.StaffLogSearchViewModel

@{
    ViewData["Title"] = "Histórico de Funcionários";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex mb-3 mb-md-4 justify-content-between align-items-center col-12 col-md-auto flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h1 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-journal-text me-2 text-color-ips"></i>Histórico de Funcionários
            </h1>
            <p class="text-muted mb-0 mt-1">Consulta detalhada de todas as operações realizadas pelos colaboradores internos.</p>
        </div>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Filters *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-3 mb-md-4 border-0 rounded-3 small fs-md-6">
        <div class="card-body p-3 p-md-4 bg-color-ips-very-light">
            <form id="filterForm"
                  hx-get="/Admin/AdminUserManagement/GetFilteredStaffLogs"
                  hx-trigger="submit, change, keyup delay:300ms from:#searchFilter"
                  hx-target="#logTableBody"
                  hx-indicator=".loader-spinner"
                  class="row g-3 align-items-end text-start">
                
                @* Search Filter *@
                <div class="col-md-6 col-xl mt-2 mt-md-auto">
                    <label asp-for="SearchString" class="small fw-bold mb-1"></label>
                    <input asp-for="SearchString" id="searchFilter" type="text" class="form-control form-control-sm" placeholder="Nome, Email ou Mensagem...">
                </div>
                
                @* Action Filter *@
                <div class="col-md-4 col-xl-2 mt-2 mt-md-auto">
                    <label asp-for="ActionFilter" class="small fw-bold mb-1"></label>
                    <select asp-for="ActionFilter" class="form-select form-select-sm" asp-items="@Html.GetEnumSelectList<Projeto_SEGUES.Models.Enums.UserAction>()" id="actionFilter">
                        <option value="">Todas</option>
                    </select>
                </div>

                @* Date Filter *@
                <div class="col-md-4 col-xl-2">
                    <label asp-for="DateFilter" class="small fw-bold mb-1"></label>
                    <input asp-for="DateFilter" type="date" class="form-control form-control-sm" id="dateFilter">
                </div>
                
                @* Actions *@
                <div class="col-xl-auto">
                    <div class="d-flex align-items-center justify-content-end gap-3 pb-1">
                        @* HTMX Loading Spinner *@
                        <div class="d-flex align-items-center text-color-ips htmx-indicator loader-spinner" id="searchSpinner">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span class="small fw-bold">A pesquisar...</span>
                        </div>
                        @* Clear button *@
                        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="StaffLog" class="btn btn-sm btn-reset-x btn-ips-outline-secondary fw-bold px-3">
                            <i class="bi bi-x-circle me-1"></i>Limpar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    @* Tabela de Registos *@
    <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 small fs-md-6">
        <div class="card-header bg-white py-2 py-md-3 border-bottom">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <h5 class="mb-0 fw-bold text-color-ips">
                    <i class="bi bi-list-check me-2"></i>Registos de Atividade
                </h5>
                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 gap-md-3">
                    @* Log counter *@
                    <span class="badge bg-color-ips-light text-color-ips border fs-6 py-2 px-3 text-center">
                        Total: <span id="logsCountBadge">@Model.Results.Count</span> registos
                    </span>

                    @* PDF Export button *@
                    <form asp-area="Admin" asp-controller="AdminUserManagement" asp-action="ExportStaffLogPdf" method="get" target="_blank" id="exportPdfForm" class="m-0">
                        <input asp-for="SearchString" type="hidden" id="exportPdfSearch" />
                        <input asp-for="ActionFilter" type="hidden" id="exportPdfAction" />
                        <input asp-for="DateFilter" type="hidden" id="exportPdfDate" />
                        
                        <button type="submit" class="btn btn-ips fw-bold shadow-sm px-3 px-md-4 py-2 py-2">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Exportar PDF
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="table-responsive" style="max-height: 600px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white" style="position: sticky; top: 0;">
                <tr>
                    <th class="ps-3 ps-md-4 py-2 py-md-3 text-start">Funcionário</th>
                    <th class="py-2 py-md-3">Operação</th>
                    <th class="py-2 py-md-3">Data e Hora</th>
                    <th class="py-2 py-md-3 text-start">Mensagem Resumida</th>
                    <th class="pe-3 pe-md-4 py-2 py-md-3">Detalhes</th>
                </tr>
                </thead>
                <tbody id="logTableBody"
                       hx-get="/Admin/AdminUserManagement/GetFilteredStaffLogs"
                       hx-trigger="every 60s"
                       hx-include="#filterForm"
                       hx-swap="innerHTML">
                    <partial name="_StaffLogTableRowsPartial" model="Model.Results"/>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/admin/staffLog.js"></script>
}