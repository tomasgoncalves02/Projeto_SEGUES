@model IEnumerable<Projeto_SEGUES.Models.Audit.UserLog>

@{
    ViewData["Title"] = "Histórico de Funcionários";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0 col-12 col-md-auto">
            <h1 class="fw-bold display-6 mb-1 title-underline">Histórico de Funcionários</h1>
            <p class="text-muted small mt-1 mb-0">Consulta detalhada de todas as operações realizadas pelos colaboradores internos.</p>
        </div>
        @* Return button *@
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* --- Barra de Filtros --- *@
    <div class="card card-ips shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body bg-color-ips-very-light p-4">
            <form method="get" class="row g-3 align-items-end text-start">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-uppercase small text-muted mb-1">Ações</label>
                    <select name="actionType" class="form-select shadow-none">
                        <option value="">Todas</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-uppercase small text-muted mb-1">Realizadas em</label>
                    <input type="date" name="date" class="form-control shadow-none" value="@Context.Request.Query["date"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-uppercase small text-muted mb-1">Pesquisar</label>
                    <input type="text" name="search" class="form-control shadow-none" placeholder="Nome, Email ou Mensagem..." value="@Context.Request.Query["search"]">
                </div>
                <div class="col-md-3 d-flex align-items-center gap-3">
                    <a asp-action="StaffLog" class="btn-reset-x">
                        Limpar <i class="bi bi-x-circle ms-1"></i>
                    </a>
                    <button type="submit" class="btn btn-ips px-4 py-2 fw-bold text-uppercase shadow-sm flex-grow-1">
                        <i class="bi bi-search me-2"></i> PESQUISAR
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* --- Tabela de Registos --- *@
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="mb-0 text-color-ips fw-bold">
                <i class="bi bi-list-check me-2"></i>Registos de Atividade
            </h5>
            <span class="badge bg-color-ips-light text-color-ips border fs-6">Total: @(Model?.Count() ?? 0) registos</span>
        </div>
        <div class="table-responsive" style="max-height: 600px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white">
                    <tr>
                        <th class="ps-4 py-3 text-start">Funcionário</th>
                        <th class="py-3">Data e Hora</th>
                        <th class="py-3">Operação</th>
                        <th class="py-3 text-start">Mensagem Resumida</th>
                        <th class="pe-4 py-3">Detalhes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var log in Model)
                        {
                            // Lógica para injetar o Nome antes do Email na mensagem original
                            string fullMessage = log.Message ?? "";
                            if (log.AppUser != null && !string.IsNullOrWhiteSpace(log.AppUser.Email) && fullMessage.Contains(log.AppUser.Email))
                            {
                                string replacement = $"{log.AppUser.FirstName} {log.AppUser.LastName} ({log.AppUser.Email})";
                                fullMessage = fullMessage.Replace(log.AppUser.Email, replacement);
                            }

                            <tr class="table-row-ips-hover">
                                <td class="ps-4 text-start">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">
                                            @(log.AppUser != null ? $"{log.AppUser.FirstName} {log.AppUser.LastName}" : "Sistema")
                                        </span>
                                        <small class="text-muted" style="font-size: 0.75rem;">@log.AppUser?.Email</small>
                                    </div>
                                </td>
                                <td class="small">
                                    @log.TimeStamp.ToString("dd/MM/yy")<br />
                                    <span class="text-muted">@log.TimeStamp.ToString("HH:mm:ss")</span>
                                </td>
                                <td>
                                    <span class="badge bg-color-ips-light text-color-ips fw-bold">
                                        @log.UserAction
                                    </span>
                                </td>
                                <td class="text-start text-truncate" style="max-width: 350px;" title="@fullMessage">
                                    @fullMessage
                                </td>
                                <td class="pe-4">
                                    <button class="btn btn-ips-outline-secondary btn-sm fw-bold px-3 shadow-sm"
                                            onclick="openLogModal('@log.UserAction', '@fullMessage', '@log.RequestPath', '@log.TimeStamp.ToString("dd/MM/yyyy HH:mm:ss")')">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {                     
                        <tr>
                            <td colspan="5" class="py-5 text-center">
                                <div class="text-muted">
                                    <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                                    <p class="mb-0 fw-bold">Nenhum registo de atividade encontrado.</p>
                                    <small>Tente ajustar os filtros de pesquisa ou a data selecionada.</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- Modal de Detalhes --- *@
<div class="modal fade" id="modalLogDetails" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-body p-5 text-center">
                <div class="card-ips-icon mb-4 hover-translate shadow-sm">
                    <i class="bi bi-info-lg fs-1"></i>
                </div>
                <h3 class="fw-bold mb-4">Detalhes da Atividade</h3>
                <div class="text-start">
                    <div class="mb-3">
                        <label class="small text-muted text-uppercase fw-bold">Operação</label>
                        <h5 id="modalUserAction" class="text-color-ips fw-bold">---</h5>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted text-uppercase fw-bold">Data e Hora</label>
                        <p id="modalTimeStamp" class="text-dark mb-0">---</p>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted text-uppercase fw-bold">Caminho (URL)</label>
                        <p id="modalRequestPath" class="text-muted small bg-color-ips-very-light p-2 rounded border">---</p>
                    </div>
                    <div class="mb-1">
                        <label class="small text-muted text-uppercase fw-bold">Mensagem / Dados</label>
                        <div class="p-3 bg-color-ips-very-light rounded border">
                            <p id="modalMessage" class="text-muted mb-0 small" style="white-space: pre-wrap;">---</p>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-ips w-100 py-2 mt-4 fw-bold shadow-sm" data-bs-dismiss="modal">
                    FECHAR DETALHES
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/staffLog.js"></script>
}