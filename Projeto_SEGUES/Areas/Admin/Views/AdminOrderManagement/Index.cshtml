@using Projeto_SEGUES.Models.Enums
@model Projeto_SEGUES.Areas.Admin.ViewModels.AdminOrderManagementViewModel
@{
    ViewData["Title"] = "Histórico Geral de Pedidos";
}

<div class="container mt-4">
    @* Header *@
    <div class="d-flex mb-3 mb-md-4 align-items-center justify-content-between col-12 col-md-auto flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h1 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-journal-text me-2 text-color-ips"></i>Histórico Geral de Pedidos
            </h1>
            <p class="text-muted mt-1 mb-0">Controlo total de transações, horários de recolha e fluxo financeiro do Bar.</p>
        </div>
        <a asp-area="Admin" asp-controller="AdminBarManagement" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto px-4 fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Bar Schedule & Weekend Settings *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-3 mb-md-4 border-0 rounded-3 small fs-md-6">
        <div class="card-body p-3 p-md-4 bg-color-ips-very-light">
            <h6 class="fw-bold mb-2 mb-md-3 text-color-ips">
                <i class="bi bi-clock-history me-2"></i>Definição do Horário de Funcionamento
            </h6>
            <div class="row align-items-center g-4">
                @* Week Schedule *@
                <div class="col-lg-7 border-end-lg">
                    <form asp-area="Admin" asp-controller="AdminOrderManagement" asp-action="UpdateOpenAndCloseTime" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3 align-items-end">
                            <div class="col-sm-4">
                                <label class="small fw-bold text-muted mb-1">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Hora de Início
                                </label>
                                <input type="time" name="openTime" class="form-control shadow-none" value="@Model.BarOpeningTimeString" />
                            </div>
                            <div class="col-sm-4">
                                <label class="small fw-bold text-muted mb-1">
                                    <i class="bi bi-box-arrow-left me-1"></i>Hora de Fecho
                                </label>
                                <input type="time" name="closeTime" class="form-control shadow-none" value="@Model.BarClosingTimeString" />
                            </div>
                            <div class="col-sm-4">
                                <button type="submit" class="btn btn-ips fw-bold w-100 shadow-sm">
                                    Atualizar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                @* Weekend Settings *@
                <div class="col-lg-5 ps-lg-4">
                    <label class="small fw-bold text-muted mb-2 mb-md-3 d-block">
                        <i class="bi bi-calendar-event me-1"></i>Disponibilidade de Fim de Semana
                    </label>

                    <div class="p-2 pd-md-3 bg-white rounded-3 border shadow-xs">
                        @* Saturday switch *@
                        <form asp-area="Admin" asp-controller="AdminOrderManagement" asp-action="UpdateWeekendStatus" method="post" id="formSat" class="mb-2 mb-md-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="day" value="Saturday" />
                            <input type="hidden" name="isOpen" value="@(Model.IsOpenSaturday ? "false" : "true")" />
                            <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0">
                                <label class="form-check-label fw-bold @(Model.IsOpenSaturday ? "text-success" : "text-danger") mb-0" for="switchSat">
                                    <i class="bi bi-calendar3 me-2"></i>Sábado: @(Model.IsOpenSaturday ? "Aberto" : "Fechado")
                                </label>
                                <input class="form-check-input ms-0 shadow-none cursor-pointer" type="checkbox" role="switch" id="switchSat" @(Model.IsOpenSaturday ? "checked" : "")>
                            </div>
                        </form>

                        @* Sunday switch *@
                        <form asp-area="Admin" asp-controller="AdminOrderManagement" asp-action="UpdateWeekendStatus" method="post" id="formSun" class="mb-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="day" value="Sunday" />
                            <input type="hidden" name="isOpen" value="@(Model.IsOpenSunday ? "false" : "true")" />
                            <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0">
                                <label class="form-check-label fw-bold @(Model.IsOpenSunday ? "text-success" : "text-danger") mb-0" for="switchSun">
                                    <i class="bi bi-calendar3-fill me-2"></i>Domingo: @(Model.IsOpenSunday ? "Aberto" : "Fechado")
                                </label>
                                <input class="form-check-input ms-0 shadow-none cursor-pointer" type="checkbox" role="switch" id="switchSun" @(Model.IsOpenSunday ? "checked" : "")>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Filters bar *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-3 mb-md-4 border-0 rounded-3 small fs-md-6">
        <div class="card-body p-3 p-md-4 bg-color-ips-very-light">
            <form id="orderFilterForm"
                  hx-get="/Admin/AdminOrderManagement/GetFilteredOrders"
                  hx-trigger="submit, change, keyup delay:300ms from:#searchFilter"
                  hx-target="#ordersTableBody"
                  hx-indicator=".loader-spinner"
                  class="row g-3 align-items-end text-start">

                @* Search Filter *@
                <div class="col-md-6 col-xl mt-2 mt-md-auto">
                    <label asp-for="SearchModel.SearchString" class="small fw-bold"></label>
                    <input asp-for="SearchModel.SearchString" id="searchFilter" type="text" class="form-control form-control-sm" placeholder="Nome, Email, Nº ou Código...">
                </div>

                @* Date Filter *@
                <div class="col-md-4 col-xl-2 mt-2 mt-md-auto">
                    <label asp-for="SearchModel.DateFilter" class="small fw-bold"></label>
                    <input asp-for="SearchModel.DateFilter" type="date" class="form-control form-control-sm" id="dateFilter">
                </div>

                @* Status Filter *@
                <div class="col-md-4 col-xl-3 mt-2 mt-md-auto">
                    <label asp-for="SearchModel.StatusFilter" class="small fw-bold"></label>
                    <select asp-for="SearchModel.StatusFilter"
                            asp-items="Html.GetEnumSelectList<OrderStatus>().Where(s => s.Value != ((int)OrderStatus.Cart).ToString()).ToList()"
                            class="form-select form-select-sm" id="statusFilter">
                        <option value="">Todos os estados</option>
                    </select>
                </div>

                @* Actions *@
                <div class="col-xl-auto">
                    <div class="d-flex align-items-center justify-content-end gap-3 pb-1">
                        @* HTMX Loading Spinner *@
                        <div class="d-flex align-items-center text-color-ips htmx-indicator loader-spinner" id="searchSpinner">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span class="small fw-bold">A pesquisar...</span>
                        </div>
                        @* Clear button *@
                        <a asp-area="Admin" asp-controller="AdminOrderManagement" asp-action="Index" class="btn btn-sm btn-reset-x btn-ips-outline-secondary fw-bold px-3">
                            <i class="bi bi-x-circle me-1"></i>Limpar Filtros
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Table *@
    <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 small fs-md-6">
        <div class="card-header bg-white py-2 py-md-3 border-bottom">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <h5 class="mb-0 fw-bold text-color-ips">
                    <i class="bi bi-receipt-cutoff me-2"></i>Registo de Pedidos
                </h5>
                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 gap-md-3">
                    @* Order counter *@
                    <span class="badge bg-color-ips-light text-color-ips border fs-6 py-2 px-3 text-center">
                        Total: <span id="ordersCountBadge">@Model.SearchModel.Results.Count()</span> pedidos
                    </span>

                    @* PDF Export button *@
                    <form asp-area="Admin" asp-controller="AdminOrderManagement" asp-action="ExportOrdersPdf" method="get" target="_blank" id="exportPdfForm" class="m-0">
                        @Html.AntiForgeryToken()
                        <input asp-for="SearchModel.SearchString" type="hidden" id="exportPdfSearch" />
                        <input asp-for="SearchModel.DateFilter" type="hidden" id="exportPdfDate" />
                        <input asp-for="SearchModel.StatusFilter" type="hidden" id="exportPdfStatus" />

                        <button type="submit" class="btn btn-ips fw-bold shadow-sm px-3 px-md-4 py-2">
                            <i class="bi bi-file-earmark-pdf me-2"></i>Exportar PDF
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="table-responsive" style="max-height: 600px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white" style="position: sticky; top: 0;">
                    <tr>
                    <th class="py-2 py-md-3 ps-3 ps-md-4 text-start">Utilizador</th>
                        <th class="py-2 py-md-3">Nº Pedido</th>
                        <th class="py-2 py-md-3">Código</th>
                        <th class="py-2 py-md-3">Data/Hora Compra</th>
                        <th class="py-2 py-md-3">Agendado p/</th>
                        <th class="py-2 py-md-3">Estado</th>
                        <th class="py-2 py-md-3">Recolhido em</th>
                        <th class="py-2 py-md-3">Produtos</th>
                        <th class="py-2 py-md-3 pe-3 pe-md-4">Preço Total</th>
                    </tr>
                </thead>
                <tbody id="ordersTableBody"
                       hx-get="/Admin/AdminOrderManagement/GetFilteredOrders"
                       hx-trigger="every 30s"
                       hx-include="#orderFilterForm"
                       hx-swap="innerHTML">
                    <partial name="~/Areas/Report/Views/ReportOrder/_OrderHistoryRowsPartial.cshtml" model="Model.SearchModel.Results" />
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/report/reportOrder.js"></script>
}