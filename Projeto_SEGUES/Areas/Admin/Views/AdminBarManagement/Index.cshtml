@{
    ViewData["Title"] = "Gestão de Pedidos - Admin";
}
<div class="container mt-5">
    <div class="row align-items-end mb-5 g-3">
        <div class="col-12 col-md-auto order-1 order-md-2 text-end ms-md-auto">
            <a asp-area="Admin" asp-controller="Admin" asp-action="Index"
               class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
        <div class="col-12 col-md order-2 order-md-1">
            <h2 class="fw-bold title-underline mb-0">Gestão de Pedidos</h2>
            <p class="text-muted small mb-0 mt-2">Painel de Controlo Administrativo do Bar</p>
        </div>

    </div>

    @* Grelha de Cards *@
    <div class="row g-4 justify-content-center">

        @* CARD: Gestão de Inventário *@
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="card-ips-icon mb-4">
                        <i class="bi bi-box-seam fs-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Gestão de Produtos</h3>
                    <p class="text-muted">Configurar o catálogo e editar preços de lanches e bebidas.</p>

                    <div class="mt-auto pt-3">
                        <a asp-area="Admin" asp-controller="AdminInventoryManagement" asp-action="Index"
                           class="btn btn-ips w-100 py-2 fw-bold">
                            Gerir Inventário
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* CARD: Histórico Geral *@
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="card-ips-icon mb-4">
                        <i class="bi bi-journal-text fs-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Histórico Geral</h3>
                    <p class="text-muted">Monitorizar todos os consumos e vendas efetuadas no bar por todos os utilizadores.</p>

                    <div class="mt-auto pt-3">
                        <a asp-area="Admin" asp-controller="AdminOrderManagement" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">
                            Ver Todos os Pedidos
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>