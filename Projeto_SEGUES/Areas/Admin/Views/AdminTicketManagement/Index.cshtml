@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>
@using Projeto_SEGUES.Models.Ticket

@{
    ViewData["Title"] = "Gestão de Senhas";
    bool isAdmin = User.IsInRole("Admin");
    List<TicketPrice> prices = ViewBag.Prices;
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row">
        <div class="col-12 col-md-auto order-2 order-md-1">
            <h2 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-shield-lock-fill me-2 text-color-ips"></i>
                Painel de Gestão e Auditoria
            </h2>
            <p class="text-muted small mb-0 mt-1">Administração de Preçários e Registo Global de Senhas</p>
        </div>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    @* --- HORÁRIO DO REFEITÓRIO --- *@
    <div class="row g-4 mb-5">
        @foreach (var servico in new[] { "Almoço", "Jantar" })
        {
            <div class="col-lg-6">
                <div class="card card-ips hover-shadow-ips shadow-sm border-0 rounded-3 h-100">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 d-flex align-items-center" style="color: darkcyan;">
                            <i class="bi bi-clock me-2"></i> Definição de Horário: @servico
                        </h6>

                        <form asp-area="Admin" asp-controller="AdminTicketManagement" asp-action="UpdateSchedule" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="serviceName" value="@servico"/>

                            <div class="row g-3 align-items-end">
                                <div class="col-auto">
                                    <label class="form-label fw-semibold small mb-1">Início</label>
                                    <input type="time" name="openTime" class="form-control shadow-none"
                                           value="@(servico == "Almoço" ? ViewBag.CanteenLunchOpeningTimeString : ViewBag.CanteenDinnerOpeningTimeString)"
                                           style="width: 140px;"/>
                                </div>

                                <div class="col-auto">
                                    <label class="form-label fw-semibold small mb-1">Fecho</label>
                                    <input type="time" name="closeTime" class="form-control shadow-none"
                                           value="@(servico == "Almoço" ? ViewBag.CanteenLunchClosingTimeString : ViewBag.CanteenDinnerClosingTimeString)"
                                           style="width: 140px;"/>
                                </div>

                                <div class="col-auto">
                                    <button type="submit" class="btn btn-ips fw-bold px-4 shadow-sm">
                                        Atualizar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
    @* Gestão de Preçários e Validade (Admin Only) *@
    @if (isAdmin && prices != null && prices.Any())
    {
        <div class="row g-4 mb-4">
            @* Tabela de Preços *@
            <div class="col-lg-8">
                <div class="card shadow-sm card-ips hover-shadow-ips h-100">
                    <div class="card-header bg-white py-3 border-bottom-0">
                        <h6 class="mb-0 fw-bold text-color-ips">
                            <i class="bi bi-currency-euro me-2"></i>Definição de Preçário
                        </h6>
                    </div>
                    <div class="card-body bg-color-ips-very-light rounded-bottom">
                        <form asp-area="Admin" asp-controller="AdminTicketManagement" asp-action="UpdatePrices" method="post">
                            <div class="row g-3 align-items-end">
                                @for (int i = 0; i < prices.Count; i++)
                                {
                                    <div class="col-md">
                                        <input type="hidden" name="updatedPrices[@i].Id" value="@prices[i].Id" />
                                        <input type="hidden" name="updatedPrices[@i].UserCategoryId" value="@prices[i].UserCategory.Id" />

                                        <label class="form-label small fw-bold">@prices[i].UserCategory.Name</label>
                                        <div class="input-group">
                                            <span class="input-group-text">€</span>
                                            <input type="text" name="updatedPrices[@i].Price" class="form-control fw-bold decimal-input"
                                                   value="@prices[i].Price.ToString("N2", new System.Globalization.CultureInfo("pt-PT"))"
                                                   min="0" max="100" />
                                        </div>
                                    </div>
                                }
                                <div class="col-md-auto ms-auto">
                                    <button type="submit" class="btn btn-ips fw-bold shadow-sm px-4">
                                        <i class="bi bi-arrow-repeat me-2"></i> ATUALIZAR
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @* Validade Global *@
            <div class="col-lg-4">
                <div class="card shadow-sm card-ips hover-shadow-ips h-100">
                    <div class="card-header bg-white py-3 border-bottom-0">
                        <h6 class="mb-0 fw-bold text-color-ips">
                            <i class="bi bi-calendar-check me-2"></i>Validade Global
                        </h6>
                    </div>
                    <div class="card-body bg-color-ips-very-light rounded-bottom">
                        <form asp-area="Admin" asp-controller="AdminTicketManagement" asp-action="UpdateValidity" method="post">
                            <div class="row g-2 align-items-end">
                                <div class="col">
                                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Dias de Validade</label>
                                    <div class="input-group">
                                        <input type="number" name="validityDays" class="form-control fw-bold" value="@ViewBag.CurrentValidityDays" min="1"/>
                                        <span class="input-group-text bg-white text-muted small fw-bold">Dias</span>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-ips fw-bold shadow-sm">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    @* --- SECÇÃO DE FILTROS DE AUDITORIA --- *@
    <div class="card card-ips hover-shadow-ips shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body p-4">
            <form id="filterForm"
                  hx-get="/Admin/AdminTicketManagement/GetUpdatedAuditTable"
                  hx-trigger="change, keyup delay:300ms from:#searchFilter"
                  hx-target="#auditTableBody"
                  hx-indicator=".loader-spinner"
                  class="row g-3 align-items-end">

                <div class="col-md-4 col-xl-2">
                    <label class="form-label small fw-bold">Estado</label>
                    <select name="stateFilter" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        <option value="Available">Disponível</option>
                        <option value="Used">Utilizada</option>
                        <option value="Expired">Expirada</option>
                    </select>
                </div>

                <div class="col-md-4 col-xl-2">
                    <label class="form-label small fw-bold">A partir de</label>
                    <input type="date" name="dateFilter" class="form-control form-control-sm">
                </div>

                <div class="col-md-4 col-xl-2">
                    <label class="form-label small fw-bold">Fluxo</label>
                    <select name="flowFilter"
                            class="form-select form-select-sm"
                            asp-items="Html.GetEnumSelectList<Projeto_SEGUES.Models.Enums.TicketFlow>()">
                        <option value="">Todas</option>
                    </select>
                </div>

                <div class="col-md-6 col-xl">
                    <label class="form-label small fw-bold">Pesquisar</label>
                    <input id="searchFilter" type="text" name="searchString" class="form-control form-control-sm"
                           placeholder="Código, Nome ou Email do utilizador...">
                </div>

                <div class="col-md-4 col-xl-auto">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" onclick="resetFilters()">Limpar</button>
                        <div class="spinner-border spinner-border-sm text-primary htmx-indicator loader-spinner" role="status"></div>
                        <button type="submit" class="btn btn-ips fw-bold px-3 py-2 shadow-sm d-flex align-items-center">
                            <i class="bi bi-search me-2"></i> PESQUISAR
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Tabela de Auditoria *@
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        @* Cabeçalho da Tabela Responsivo *@
        <div class="card-header bg-white py-3 border-bottom">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <h5 class="mb-0 fw-bold text-color-ips">
                    <i class="bi bi-list-check me-2"></i>Auditoria Geral de Senhas
                </h5>

                <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-2 gap-md-3">
                    @* Contador de registos *@
                    <span class="badge bg-color-ips-very-light text-dark border fs-6 py-2 px-3 text-center">
                        Total: @Model.Count() registos
                    </span>

                    @* Botão Exportar *@
                    <button onclick="exportPdfWithFilters()" class="btn btn-ips fw-bold shadow-sm px-4 py-2">
                        <i class="bi bi-file-earmark-pdf me-2"></i>Exportar PDF
                    </button>
                </div>
            </div>
        </div>

        <div class="table-responsive" style="max-height: 600px;">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-color-ips text-white" style="position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th class="ps-4 py-3 text-start">Dono Atual</th>
                    <th class="py-3">Código</th>
                    <th class="py-3">Estado</th>
                    <th class="py-3">Compra</th>
                    <th class="py-3">Data Transf.</th>
                    <th class="py-3">Enviado Por</th>
                    <th class="py-3">Recebido Por</th>
                    <th class="py-3">Uso</th>
                    <th class="py-3 pe-4">Expiração</th>
                </tr>
                </thead>
                <tbody id="auditTableBody"
                       hx-get="/Admin/AdminTicketManagement/GetUpdatedAuditTable"
                       hx-trigger="every 10s"
                       hx-include="#filterForm"
                       hx-swap="innerHTML">
                <partial name="_AuditTableRows" model="Model"/>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/admin/adminTicket.js"></script>
}