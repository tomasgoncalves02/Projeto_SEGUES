@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>
@using Projeto_SEGUES.Models.Ticket

@{
    ViewData["Title"] = "Gestão de Senhas - SEGUES";
    bool isAdmin = User.IsInRole("Admin");
    var prices = ViewBag.Prices as List<TicketPrice>;
    int currentValidityDays = ViewBag.CurrentValidityDays ?? 365;
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-shield-lock-fill me-2 text-color-ips"></i>
                Painel de Gestão e Auditoria
            </h2>
            <p class="text-muted small mb-0">Administração de Preçários e Registo Global de Senhas</p>
        </div>

        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4" style="padding-top: 0.72rem; padding-bottom: 0.71rem;">
            <i class="bi bi-arrow-left me-2"></i>Voltar ao Painel
        </a>
    </div>
    
    @* Price management (Admin only) *@
    @if (isAdmin && prices != null && prices.Any())
    {
        <div class="row g-4 mb-5">
            @* Price configuration *@
            <div class="col-lg-8">
                <div class="card shadow-sm card-ips h-100">
                    <div class="card-header bg-white py-3 border-bottom-0">
                        <h6 class="mb-0 fw-bold text-color-ips">
                            <i class="bi bi-currency-euro me-2"></i>Definição de Preçário
                        </h6>
                    </div>
                    <div class="card-body bg-light rounded-bottom">
                        <form asp-area="Admin" asp-controller="AdminTicketManagement" asp-action="UpdatePrices" method="post">
                            <div class="row g-3 align-items-end">
                                @* Loop prices *@
                                @for (int i = 0; i < prices.Count; i++)
                                {
                                    <div class="col-md">
                                        <label class="form-label small fw-bold">@prices[i].UserCategory.Name</label>

                                        @* Crucial: Enviar o ID para o FindAsync funcionar *@
                                        <input type="hidden" name="[@i].Id" value="@prices[i].Id" />

                                        <div class="input-group">
                                            <span class="input-group-text">€</span>
                                            @* lang="en-US" força o uso do ponto para o C# não se confundir *@
                                            <input type="number" step="0.01" lang="en-US" name="[@i].Price"
                                                   class="form-control fw-bold"
                                                   value="@prices[i].Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                                        </div>
                                    </div>
                                }
                                <div class="col-md-auto ms-auto">
                                    <button type="submit" class="btn btn-ips fw-bold shadow-sm px-4">
                                        <i class="bi bi-arrow-repeat me-2"></i> ATUALIZAR
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @* Validity configuration *@
            <div class="col-lg-4">
                <div class="card shadow-sm card-ips h-100">
                    <div class="card-header bg-white py-3 border-bottom-0">
                        <h6 class="mb-0 fw-bold text-color-ips">
                            <i class="bi bi-calendar-check me-2"></i>Validade Global
                        </h6>
                    </div>
                    <div class="card-body bg-light rounded-bottom">
                        <form asp-area="Admin" asp-controller="AdminTicketManagement" asp-action="UpdateValidity" method="post">
                            <div class="row g-2 align-items-end">
                                <div class="col">
                                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Dias de Validade</label>
                                    <div class="input-group">
                                        <input type="number" name="validityDays" class="form-control fw-bold"
                                               value="@currentValidityDays" min="1"/>
                                        <span class="input-group-text bg-white text-muted small fw-bold">Dias</span>
                                    </div>
                                    <div class="form-text small" style="font-size: 0.75rem;">
                                        Aplica-se apenas a novas compras.
                                    </div>
                                </div>
                                <div class="col-auto align-self-center">
                                    <button type="submit" class="btn btn-ips fw-bold shadow-sm">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Global Audit *@
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-color-ips">
                <i class="bi bi-list-check me-2"></i>Auditoria Geral de Senhas
            </h5>
            <span class="badge bg-light text-dark border fs-6">Total: @Model.Count() registos</span>
        </div>

        @* Adição de max-height e overflow para scroll *@
        <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0 text-center">
                @* Cabeçalho fixo (sticky) *@
                <thead class="bg-color-ips text-white" style="position: sticky; top: 0; z-index: 10;">
                    <tr>
                        <th class="ps-4 py-3">Cliente</th>
                        <th class="py-3">Código</th>
                        <th class="py-3">Estado</th>
                        <th class="py-3">Compra</th>
                        <th class="py-3">Utilização</th>
                        <th class="py-3">Expiração</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
                                Nenhum registo encontrado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Owner.FirstName @item.Owner.LastName</div>
                                    <div class="text-muted small">@item.Owner.Email</div>
                                </td>
                                <td><code class="fw-bold text-color-ips bg-light px-2 py-1 rounded">@item.ValidationCode</code></td>
                                <td>
                                    <span class="badge @item.State.ToString().ToBadgeClass()">
                                        @item.State.ToDisplayName()
                                    </span>
                                </td>
                                <td class="small">@item.TicketPurchase.TransactionDate.ToString("dd/MM/yy HH:mm")</td>
                                <td class="small fw-bold">
                                    @(item.UsedDate.HasValue? item.UsedDate.Value.ToString("dd/MM/yy HH:mm") : "-")
                                </td>
                                <td class="small">@item.ExpirationDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
