@{
    ViewData["Title"] = "Painel de Administração - SEGUES";
}

<div class="container mt-5">
    @* Top row *@
    <div class="row mb-5 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold title-underline mb-0">Painel de Administração</h2>
        </div>
        <div class="col-md-6 text-end d-flex justify-content-end align-items-center gap-3">          
            @* Return button *@
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4" style="padding-top: 0.72rem; padding-bottom: 0.71rem;">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>
    
    @* Cards *@
    <div class="row g-4">
        @* Create Internal Account *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-person-plus"></i></div>
                    <h3 class="card-title fw-bold">Novo Registo</h3>
                    <p class="text-muted">Criar manualmente um Administrador ou Funcionário no sistema.</p>
                    <div class="mt-auto pt-3">
                        <a asp-area="Admin" asp-controller="AdminCreateInternalAccount" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">
                            Criar Conta
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* User Management *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-people"></i></div>
                    <h3 class="card-title fw-bold">Gerir Utilizadores</h3>
                    <p class="text-muted">Consultar lista, ver detalhes, editar ou apagar contas registadas.</p>
                    <div class="mt-auto pt-3">
                        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">
                            Ver Lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* Ticket Management *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-ticket-perforated"></i></div>
                    <h3 class="card-title fw-bold">Gestão de Senhas</h3>
                    <p class="text-muted">Monitorizar vendas, validar estados e verificar as expirações.</p>
                    <div class="mt-auto pt-3">
                        <a asp-area="Admin" asp-controller="AdminTicketManagement" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">
                            Gerir Senhas
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* Bar Management *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body d-flex flex-column p-5 text-center">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cup-straw"></i></div>
                    <h3 class="card-title fw-bold">Gestão do Bar</h3>
                    <p class="text-muted">Gerir o inventário de produtos e categorias do bar.</p>
                    <div class="mt-auto pt-3">
                        <a asp-area="Admin" asp-controller="AdminBarManagement" asp-action="Index"class="btn btn-ips w-100 py-2 fw-bold">
                            Gerir Bar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>