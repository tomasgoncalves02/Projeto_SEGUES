@{
    ViewData["Title"] = "Painel de Administração - SEGUES";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">Painel de Administração</h2>
        </div>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Cards - Grid ajustada para col-lg-3 para combinar com o Refeitório *@
    <div class="row g-4">
        @* Create Internal Account *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-person-plus"></i></div>
                    <h5 class="fw-bold">Novo Registo</h5>
                    <p class="text-muted small mb-4">Criar manualmente um Administrador ou Funcionário no sistema.</p>
                    <div class="mt-auto">
                        <a asp-area="Admin" asp-controller="AdminCreateInternalAccount" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">Criar Conta</a>
                    </div>
                </div>
            </div>
        </div>

        @* User Management *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-people"></i></div>
                    <h5 class="fw-bold">Utilizadores</h5>
                    <p class="text-muted small mb-4">Consultar lista, ver detalhes, editar ou apagar contas registadas.</p>
                    <div class="mt-auto">
                        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">Ver Lista</a>
                    </div>
                </div>
            </div>
        </div>

        @* Ticket Management *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-ticket-perforated"></i></div>
                    <h5 class="fw-bold">Gestão de Senhas</h5>
                    <p class="text-muted small mb-4">Monitorizar vendas, validar estados e verificar as expirações.</p>
                    <div class="mt-auto">
                        <a asp-area="Admin" asp-controller="AdminTicketManagement" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">Gerir Senhas</a>
                    </div>
                </div>
            </div>
        </div>

        @* Bar Management *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cup-straw"></i></div>
                    <h5 class="fw-bold">Gestão do Bar</h5>
                    <p class="text-muted small mb-4">Gerir o inventário de produtos e categorias do bar.</p>
                    <div class="mt-auto">
                        <a asp-area="Admin" asp-controller="AdminBarManagement" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">Gerir Bar</a>
                    </div>
                </div>
            </div>
        </div>

        @* Statistics *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-bar-chart-line"></i></div>
                    <h5 class="fw-bold">Estatísticas</h5>
                    <p class="text-muted small mb-4">Consultar dados estatísticos da aplicação e utilização.</p>
                    <div class="mt-auto">
                        <a asp-area="Report" asp-controller="ReportStatistics" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">Ver Dados</a>
                    </div>
                </div>
            </div>
        </div>

        @* Staff Logs *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-journal-text"></i></div>
                    <h5 class="fw-bold">Logs Staff</h5>
                    <p class="text-muted small mb-4">Monitorizar ações realizadas pelos funcionários no sistema.</p>
                    <div class="mt-auto">
                        <a asp-area="Admin" asp-controller="AdminUserManagement" asp-action="StaffLog" class="btn btn-ips w-100 py-2 fw-bold">Gerir Logs</a>
                    </div>
                </div>
            </div>
        </div>

        @* Menu Management *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-journal-richtext"></i></div>
                    <h5 class="fw-bold">Gerir Ementas</h5>
                    <p class="text-muted small mb-4">Configurar os links externos das ementas Bar e Refeitório.</p>
                    <div class="mt-auto">
                        <a asp-area="Admin" asp-controller="AdminMenuManagement" asp-action="Index" class="btn btn-ips w-100 py-2 fw-bold">Configurar Links</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>