@model Projeto_SEGUES.Areas.Admin.ViewModels.CreateInternalUserViewModel

@{
    ViewData["Title"] = "Criar Conta Interna";
}

<div class="container mt-5">
    @* Top row *@
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-4 title-underline">Registar Colaborador</h2>
            @* Form card *@
            <div class="card shadow-lg card-ips">
                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-bold">Nome</label>
                                <input asp-for="FirstName" class="form-control" placeholder="Nome"/>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-bold">Sobrenome</label>
                                <input asp-for="LastName" class="form-control" placeholder="Apelido"/>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="utilizador@dominio.com"/>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Gender" class="form-label fw-bold">Género</label>
                                <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Projeto_SEGUES.Models.Enums.Gender>()">
                                    <option value="">Selecione...</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BirthDate" class="form-label fw-bold">Data de Nascimento</label>
                                <input asp-for="BirthDate" class="form-control" type="date"/>
                                <span asp-validation-for="BirthDate" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AccountType" class="form-label fw-bold">Função / Role</label>
                            <select asp-for="AccountType" class="form-select" asp-items="ViewBag.Roles">
                                <option value="">Selecione...</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-ips w-100 fw-bold shadow-sm py-3">
                            <i class="bi bi-send-check me-2"></i>CRIAR E NOTIFICAR POR EMAIL
                        </button>
                    </form>
                </div>
            </div>

            <div class="mt-4 text-center fs-4">
                <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary text-muted fw-bold">Voltar ao Painel</a>
            </div>
        </div>
    </div>
</div>