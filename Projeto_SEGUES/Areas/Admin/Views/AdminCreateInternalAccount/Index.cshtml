@model Projeto_SEGUES.Areas.Admin.ViewModels.CreateInternalUserViewModel

@{
    ViewData["Title"] = "Criar Conta Interna";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center col-12 col-md-auto mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">
                <i class="bi bi-person-plus me-2 text-color-ips"></i>
                Registar Colaborador
            </h2>
        </div>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Top row *@
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-7">
            @* Form card *@
            <div class="card shadow-lg card-ips hover-shadow-ips">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>
                        @* Name *@
                        <div class="row g-3 mb-3 text-start">
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <input asp-for="FirstName" class="form-control" placeholder="Nome"/>
                                    <label asp-for="FirstName"></label>
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <input asp-for="LastName" class="form-control" placeholder="Apelido"/>
                                    <label asp-for="LastName"></label>
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                        @* Email *@
                        <div class="mb-3 text-start">
                            <div class="form-floating">
                                <input asp-for="Email" class="form-control" placeholder="utilizador@dominio.com"/>
                                <label asp-for="Email"></label>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                        </div>
                        
                        @* Gender and BirthDate *@
                        <div class="row g-3 mb-3 text-start">
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Projeto_SEGUES.Models.Enums.Gender>()">
                                        <option value="">Selecione...</option>
                                    </select>
                                    <label asp-for="Gender"></label>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-floating">
                                    <input asp-for="BirthDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                                    <label asp-for="BirthDate"></label>
                                </div>
                                <span asp-validation-for="BirthDate" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                        
                        @* Account Type / Role *@
                        <div class="mb-4 text-start">
                            <div class="form-floating">
                                <select asp-for="AccountType" class="form-select" asp-items="ViewBag.Roles">
                                    <option value="">Selecione...</option>
                                </select>
                                <label asp-for="AccountType"></label>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-ips w-100 fw-bold shadow-sm py-3">
                            <i class="bi bi-send me-2"></i>Criar e notificar por email
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>