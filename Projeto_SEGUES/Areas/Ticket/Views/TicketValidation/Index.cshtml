@model Projeto_SEGUES.Areas.Ticket.ViewModels.ValidateTicketViewModel

@{
    ViewData["Title"] = "Validar Senhas";
}

<div class="container mt-5">
    @* Top row *@
    <div class="d-flex justify-content-between align-items-center col-12 col-md-auto mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 title-underline mb-1">Validar Senhas</h2>
        </div>
        <a asp-area="Admin" asp-controller="Employee" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    <div class="row g-4">
        @* Left/top column (input) *@
        <div class="col-xl-5 col-lg-6">
            <div class="card card-ips hover-shadow-ips h-100 shadow-sm small fs-md-6">
                <div class="card-body text-center p-3 pd-md-4 d-flex flex-column justify-content-center">
                    <div class="mb-3 mb-md-4">
                        <div class="card-ips-icon mb-3">
                            <i class="bi bi-qr-code-scan fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-color-ips">Leitura do Código</h4>
                        <div id="qr-reader" class="mx-auto mt-4 mb-3 w-100 rounded-3 overflow-hidden" style="max-width: 300px;"></div>
                        <div class="mt-4 p-3 bg-color-ips-very-light rounded-3 border border-light">
                            <small class="text-muted d-block fw-bold">
                                <i class="bi bi-info-circle me-1 text-color-ips"></i> Instruções:
                            </small>
                            <small class="text-muted">
                                Use um dispositivo de leitura ou digite manualmente o código de 8 caracteres.
                            </small>
                        </div>
                    </div>
                    @* Code form *@
                    <form asp-action="Index" method="post" id="validationForm" autocomplete="off">
                        <div class="mb-4">
                            <input asp-for="Code" id="ticketCodeInput"
                                   class="form-control form-control-lg text-center code-input py-2 py-md-3"
                                   placeholder="XXXXXXXX" maxlength="8"
                                   autofocus />
                            <span asp-validation-for="Code" class="text-danger mt-2 d-block small fw-bold"></span>
                        </div>

                        <button type="submit" class="btn btn-ips w-100 py-3 fw-bold shadow-sm rounded-3">
                            <i class="bi bi-check2-circle me-2"></i>Validar
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* Right column *@
        <div class="col-xl-7 col-lg-6">
            <div class="card card-ips shadow-sm h-100 small fs-md-6">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <h5 class="mb-0 fw-bold text-color-ips">
                        <i class="bi bi-clock-history me-2"></i>Histórico Recente
                    </h5>
                </div>
                <div class="table-responsive" style="max-height: 500px;">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead>
                            <tr>
                                <th class="ps-3 ps-md-4 py-2 py-md-3">Código</th>
                                <th class="py-2 py-md-3">Cliente</th>
                                <th class="pe-3 pe-md-4 py-2 py-md-3">Hora</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.RecentTickets.Any())
                        {
                            @foreach (var ticket in Model.RecentTickets)
                            {
                                <tr>
                                    <td class="ps-3 ps-md-4">
                                        <code class="badge bg-color-ips-light fw-bold text-color-ips px-2 py-1">
                                            @ticket.ValidationCode
                                        </code>
                                    </td>
                                    <td>
                                        <div class="fw-bold">
                                            @ticket.Owner.FirstName @ticket.Owner.LastName
                                        </div>
                                        <div class="text-muted small">@ticket.Owner.Email</div>
                                    </td>
                                    <td class="fw-bold">
                                        <div class="fw-bold">
                                            @ticket.UsedDate?.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="text-muted small">@ticket.UsedDate?.ToString(@"HH\:mm")</div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-5">
                                    <div class="py-4">
                                        <i class="bi bi-inbox-fill fs-1 d-block mb-3 opacity-25"></i>
                                        <span class="fw-bold">Nenhuma validação recente.</span>
                                        <p class="small mb-0">As últimas senhas validadas aparecerão aqui.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode"></script>
    <script type="module" src="~/js/ticket/ticketValidation.js"></script>
}