@model Projeto_SEGUES.Areas.Admin.ViewModels.BarCanteenConfigViewModel

@{
    ViewData["Title"] = "Refeitório - SEGUES";
}

<div class="container py-4">
    @* Page Header *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold display-6 mb-1 title-underline">Refeitório</h1>
            <p class="text-muted small mt-1 mb-0">Planeie as suas refeições e faça a gestão das suas senhas.</p>
        </div>
        @* Return button in larger screen *@
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm d-none d-md-flex">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    
    @* Schedule Banner *@
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-color-ips-light" style="border-left: 5px solid var(--ips) !important;">
                <div class="card-body py-3 d-flex flex-column flex-md-row align-items-start align-items-md-center">
                    <div class="me-md-4 mb-2 mb-md-0 d-flex align-items-center">
                        <i class="bi bi-clock text-color-ips fs-4 me-2"></i>
                        <span class="fw-bold small text-muted">Horário:</span>
                    </div>
                    <div class="d-flex flex-column flex-sm-row gap-2 gap-md-4">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-color-ips text-white me-2">Almoço</span>
                            <span class="fw-bold text-color-ips">@Model.CanteenLunchOpeningTimeString - @Model.CanteenLunchClosingTimeString</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-color-ips text-white me-2">Jantar</span>
                            <span class="fw-bold text-color-ips">@Model.CanteenDinnerOpeningTimeString - @Model.CanteenDinnerClosingTimeString</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Main row *@
    <div class="row g-4">
        @* Balance Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips bg-color-ips text-white hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <small class="d-block opacity-75 fw-bold mb-2 fs-4">Saldo Disponível</small>
                    <h2 class="display-6 fw-bold my-auto">@ViewBag.UserBalance.ToString("C")</h2>
                    <div class="mt-auto">
                        <a asp-area="Payment" asp-controller="Payment" asp-action="Deposit" class="btn btn-ips fw-bold w-100 py-2" style="border: 1px solid var(--ips-border) !important">Carregar Saldo</a>
                    </div>
                </div>
            </div>
        </div>
        @* Buy Ticket Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cart-plus"></i></div>
                    <h5 class="fw-bold">Comprar Senhas</h5>
                    <p class="text-muted small mb-4">Adquire já a tua próxima refeição.</p>
                    <div class="mt-auto">
                        <a asp-area="Order" asp-controller="OrderTicket" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Comprar Senha</a>
                    </div>
                </div>
            </div>
        </div>
        @* Active Tickets Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-qr-code"></i></div>
                    <h5 class="fw-bold">Senhas Ativas</h5>
                    <p class="text-muted small mb-4">Visualiza as tuas senhas ainda não usadas.</p>
                    <div class="mt-auto">
                        <a asp-area="Ticket" asp-controller="Ticket" asp-action="ActiveTickets" class="btn w-100 py-2 fw-bold btn-ips">Ver Senhas</a>
                    </div>
                </div>
            </div>
        </div>
        @* Send Ticket Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-send"></i></div>
                    <h5 class="fw-bold">Transferir Senhas</h5>
                    <p class="text-muted small mb-4">Enviar senhas para outras pessoas.</p>
                    <div class="mt-auto">
                        <a asp-area="Ticket" asp-controller="Ticket" asp-action="TransferTicket" class="btn w-100 py-2 fw-bold btn-ips">Transferir Senhas</a>
                    </div>
                </div>
            </div>
        </div>
        @* Menu Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-journal-richtext"></i></div>
                    <h5 class="fw-bold">Ementa</h5>
                    <p class="text-muted small mb-4">Consulta o que há para o almoço esta semana.</p>
                    <div class="mt-auto">
                        <a href="@Model.CanteenMenuLink" target="_blank" class="btn w-100 py-2 fw-bold btn-ips">
                            Ver Ementa
                        </a>
                    </div>
                </div>
            </div>
        </div>
        @* Return Button *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-arrow-left-circle"></i></div>
                    <h5 class="fw-bold">Voltar</h5>
                    <p class="text-muted small mb-4">Voltar à página anterior.</p>
                    <div class="mt-auto">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Voltar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>