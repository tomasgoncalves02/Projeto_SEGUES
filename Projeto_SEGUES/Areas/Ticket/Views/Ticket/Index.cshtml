@model Projeto_SEGUES.Areas.Admin.ViewModels.BarCanteenConfigViewModel

@{
    ViewData["Title"] = "Refeitório";
}

<div class="container py-4">
    @* Page Header *@
    <div class="d-flex justify-content-between align-items-center mb-4 flex-column flex-md-row">
        <div class="col-12 col-md-auto mb-2 mb-md-0">
            <h1 class="fw-bold display-6 mb-1 title-underline">Refeitório</h1>
            <p class="text-muted small mt-1 mb-0">Planeie as suas refeições e faça a gestão das suas senhas.</p>
        </div>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="col-12 col-md-auto btn btn-ips-outline-secondary fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* Schedule Banner *@
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm @(!Model.IsCanteenOpenNow ? "bg-color-danger-light" : "bg-color-ips-light")"
                 style="border-left: 5px solid @(!Model.IsCanteenOpenNow ? "var(--deny)" : "var(--ips)") !important;">

                <div class="card-body py-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="d-flex align-items-center">
                            <div class="text-center me-3" style="width: 40px;">
                                <i class="bi @(!Model.IsCanteenOpenNow ? "bi-calendar-x text-danger" : "bi-clock text-color-ips") fs-2"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-muted mb-1 fs-7" style="letter-spacing: 0.5px;">
                                    HORÁRIO DE FUNCIONAMENTO
                                </div>
                                <div class="d-flex align-items-center flex-wrap gap-3">

                                    @* Bloco Almoço *@
                                    <div class="d-flex align-items-center">
                                        <span class="badge @(!Model.IsLunchOpenNow || !Model.IsWorkDay ? "bg-danger" : "bg-color-ips") text-white px-2 py-1 me-2">Almoço</span>

                                        @if (!Model.IsLunchOpenNow || !Model.IsWorkDay)
                                        {
                                            <span class="fw-bold text-danger small">
                                                <i class="bi bi-x-circle-fill me-1"></i>Encerrado
                                                <span class="text-muted fw-normal ms-1">(@Model.CanteenLunchOpeningTimeString - @Model.CanteenLunchClosingTimeString)</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-color-ips fs-6">@Model.CanteenLunchOpeningTimeString - @Model.CanteenLunchClosingTimeString</span>
                                        }
                                    </div>

                                    <div class="vr d-none d-sm-block mx-1 opacity-25"></div>

                                    @* Bloco Jantar *@
                                    <div class="d-flex align-items-center">
                                        <span class="badge @(!Model.IsDinnerOpenNow || !Model.IsWorkDay ? "bg-danger" : "bg-color-ips") text-white px-2 py-1 me-2">Jantar</span>

                                        @if (!Model.IsDinnerOpenNow || !Model.IsWorkDay)
                                        {
                                            <span class="fw-bold text-danger small">
                                                <i class="bi bi-x-circle-fill me-1"></i>Encerrado
                                                <span class="text-muted fw-normal ms-1">(@Model.CanteenDinnerOpeningTimeString - @Model.CanteenDinnerClosingTimeString)</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-color-ips fs-6">@Model.CanteenDinnerOpeningTimeString - @Model.CanteenDinnerClosingTimeString</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white bg-opacity-75 px-3 py-1 rounded-pill border small fw-bold text-muted shadow-sm"
                             style="border-top: 6px solid @(!Model.IsCanteenOpenNow ? "var(--deny)" : "var(--ips)") !important;">
                            <i class="bi bi-info-circle me-1 @(!Model.IsCanteenOpenNow ? "text-danger" : "text-color-ips")"></i>
                            <span>Aberto aos dias úteis</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Main row *@
    <div class="row g-4">
        @* Balance Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips bg-color-ips text-white hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <small class="d-block opacity-75 fw-bold mb-2 fs-4">Saldo Disponível</small>
                    <h2 class="display-6 fw-bold my-auto mb-2">@ViewBag.UserBalance.ToString("C")</h2>
                    <div class="mt-auto">
                        <a asp-area="Payment" asp-controller="Payment" asp-action="Deposit" class="btn btn-ips fw-bold w-100 py-2" style="border: 1px solid var(--ips-border) !important">Carregar Saldo</a>
                    </div>
                </div>
            </div>
        </div>
        @* Buy Ticket Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cart-plus"></i></div>
                    <h5 class="fw-bold">Comprar Senhas</h5>
                    <p class="text-muted small mb-4">Adquire senhas para as suas refeições.</p>
                    <div class="mt-auto">
                        <a asp-area="Order" asp-controller="OrderTicket" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Comprar Senhas</a>
                    </div>
                </div>
            </div>
        </div>
        @* Active Tickets Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-qr-code"></i></div>
                    <h5 class="fw-bold">Senhas Ativas</h5>
                    <p class="text-muted small mb-4">Visualiza as suas senhas ainda não usadas.</p>
                    <div class="mt-auto">
                        <a asp-area="Ticket" asp-controller="Ticket" asp-action="ActiveTickets" class="btn w-100 py-2 fw-bold btn-ips">Ver Senhas</a>
                    </div>
                </div>
            </div>
        </div>
        @* Send Ticket Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-send"></i></div>
                    <h5 class="fw-bold">Transferir Senhas</h5>
                    <p class="text-muted small mb-4">Enviar senhas para outras pessoas.</p>
                    <div class="mt-auto">
                        <a asp-area="Ticket" asp-controller="Ticket" asp-action="TransferTicket" class="btn w-100 py-2 fw-bold btn-ips">Transferir Senhas</a>
                    </div>
                </div>
            </div>
        </div>
        @* Menu Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-journal-richtext"></i></div>
                    <h5 class="fw-bold">Ementa</h5>
                    <p class="text-muted small mb-4">Consulte a ementa do refeitório.</p>
                    <div class="mt-auto">
                        <a href="@Model.CanteenMenuLink" target="_blank" class="btn w-100 py-2 fw-bold btn-ips">
                            Ver Ementa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>