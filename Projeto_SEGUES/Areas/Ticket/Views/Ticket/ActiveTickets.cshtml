@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Senhas Ativas - SEGUES";
}

<div class="container mt-4">
    @* Top row *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-qr-code-scan me-2 text-color-ips"></i>
                Senhas Ativas
            </h2>
            <p class="text-muted small">Apresenta estes códigos no refeitório.</p>
        </div>
        <div class="col-md-5 text-end">
            <a asp-area="Ticket" asp-controller="Ticket" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @* Contentor que o HTMX vai atualizar *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4"
         hx-get="/Ticket/Ticket/GetUpdatedActiveTickets"
         hx-trigger="every 30s"
         hx-swap="innerHTML">

        <partial name="_ActiveTicketsPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/ticket/ticket.js"></script>
}