@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Senhas Ativas - SEGUES";
}

<style>
    .card-active {
        border: none;
        border-left: 5px solid #009697;
        transition: transform 0.2s;
    }

        .card-active:hover {
            transform: scale(1.02);
        }
</style>

<div class="container mt-4">
    @* Cabeçalho *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-qr-code-scan me-2" style="color: #009697;"></i>
                Senhas Ativas
            </h2>
            <p class="text-muted small">Apresenta estes códigos no refeitório.</p>
        </div>
        <div class="col-md-5 text-end">
            <a asp-controller="Tickets" asp-action="Refeitorio" class="btn fw-bold px-4"
               style="border: 2px solid #009697; color: #009697; border-radius: 8px;">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-ticket-perforated text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">Não tens senhas prontas a usar.</h4>
            <a asp-action="Index" class="btn btn-ips mt-3 px-4 py-2">Comprar Senha</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm card-active">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="badge bg-ips">Válido</span>
                                <small class="text-muted"><i class="bi bi-calendar-event"></i> Expira: @item.ExpirationDate.ToString("dd/MM")</small>
                            </div>

                            <h3 class="text-center fw-bold my-3" style="letter-spacing: 3px; color: #333;">
                                @item.ValidationCode
                            </h3>

                            <div class="mt-auto">
                                <button class="btn btn-ips w-100 py-2" onclick="verQr('@item.ValidationCode')">
                                    <i class="bi bi-qr-code me-2"></i>MOSTRAR QR CODE
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
