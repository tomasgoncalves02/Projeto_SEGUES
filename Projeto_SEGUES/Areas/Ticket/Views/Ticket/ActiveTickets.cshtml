@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Senhas Ativas - SEGUES";
}

<div class="container mt-4">
    @* Top row *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-qr-code-scan me-2 text-color-ips"></i>
                Senhas Ativas
            </h2>
            <p class="text-muted small">Apresenta estes códigos no refeitório.</p>
        </div>
        <div class="col-md-5 text-end">
            <a asp-area="Ticket" asp-controller="Ticket" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold px-4">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-ticket-perforated text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">Não tens senhas prontas a usar.</h4>
            <a asp-area="Purchase" asp-controller="PurchaseTicket" asp-action="Index" class="btn btn-ips mt-3 px-4 py-2">Comprar Senha</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm card-ips">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="badge bg-color-ips">Válido</span>
                                <small class="text-muted"><i class="bi bi-calendar-event"></i> Expira: @item.ExpirationDate.ToString("dd/MM/yyyy")</small>
                            </div>

                            <h3 class="text-center fw-bold my-3" style="letter-spacing: 6px;">
                                @item.ValidationCode
                            </h3>

                            <div class="mt-auto">
                                <button class="btn btn-ips w-100 py-2 showQr" data-code="@item.ValidationCode">
                                    <i class="bi bi-qr-code me-2 fw-bold"></i>QR CODE
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
