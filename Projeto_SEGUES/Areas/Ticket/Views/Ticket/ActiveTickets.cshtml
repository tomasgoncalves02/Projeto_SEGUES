@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Senhas Ativas - SEGUES";
}

<div class="container mt-4">
    @* Top row *@
    <div class="d-flex justify-content-between mb-4 align-items-center flex-column flex-md-row">
        <div class=" mb-2 mb-md-0">
            <h2 class="fw-bold display-6 mb-1 title-underline">
                <i class="bi bi-qr-code-scan me-2 text-color-ips"></i>
                Senhas Ativas
            </h2>
            <p class="text-muted small mt-1 mb-0">Apresenta estes códigos no refeitório.</p>
        </div>
        <a asp-area="Ticket" asp-controller="Ticket" asp-action="Index" class="btn btn-ips-outline-secondary fw-bold shadow-sm px-4 order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    @* HTMX refresh for active tickets *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4"
         hx-get="/Ticket/Ticket/GetUpdatedActiveTickets"
         hx-trigger="every 30s"
         hx-swap="innerHTML">

        <partial name="_ActiveTicketsPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/ticket/ticket.js"></script>
}