@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@if (!Model.Any())
{
    <div class="col-12 w-100 text-center py-5 my-5">
        <div class="d-flex flex-column align-items-center justify-content-center">
            <i class="bi bi-ticket-perforated text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted fw-bold">Não tem senhas prontas a usar.</h4>
            <div class="mt-3">
                <a asp-area="Order" asp-controller="OrderTicket" asp-action="Index" class="btn btn-ips px-4 py-2 shadow-sm">
                    <i class="bi bi-cart-plus me-2"></i>Comprar Senha
                </a>
            </div>
        </div>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm card-ips hover-shadow-ips">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="badge bg-color-ips">
                            Disponível
                        </span>
                        <small class="text-muted"><i class="bi bi-calendar-event"></i> Expira: @item.ExpirationDate.ToString("dd/MM/yyyy")</small>
                    </div>

                    <h3 class="text-center fw-bold my-3" style="letter-spacing: 6px;">
                        @item.ValidationCode
                    </h3>

                    <div class="mt-auto">
                        <button class="btn btn-ips w-100 py-2 showQr" data-code="@item.ValidationCode">
                            <i class="bi bi-qr-code me-2 fw-bold"></i>QR CODE
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}