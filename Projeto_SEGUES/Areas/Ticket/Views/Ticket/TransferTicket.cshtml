@model Projeto_SEGUES.Areas.Ticket.ViewModels.TransferTicketViewModel

@{
    ViewData["Title"] = "Transferir Senhas";
    bool hasTickets = Model.AvailableTickets.Any();
}

<div class="container my-4 my-lg-5">
    @* Header *@
    <div class="d-flex justify-content-between align-items-center col-12 col-md-auto mb-4 flex-column flex-md-row">
        <div class="mb-2 mb-md-0">
            <h2 class="fw-bold display-6 mb-1 title-underline">Transferir Senhas</h2>
            <p class="text-muted small mt-1 mb-0">Envie as suas senhas para um colega ou amigo.</p>
        </div>
        <a asp-area="Ticket" asp-controller="Ticket" asp-action="Index" class="btn btn-ips-outline-secondary col-12 col-md-auto px-4 fw-bold shadow-sm order-first order-md-last mb-3 mb-md-0">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>
    
    <form asp-area="Ticket" asp-controller="Ticket" asp-action="TransferTickets" method="post" id="transferForm">
        @Html.AntiForgeryToken()
        <div class="row g-4 mb-4">
            @* Left/top: Send Tickets Form *@
            <div class="col-lg-5">
                <div class="card shadow-sm h-100 card-ips hover-shadow-ips d-flex flex-column">
                    <div class="card-body p-3 p-md-4 d-flex flex-column text-center">
                        <h6 class="fw-bold text-color-ips fs-5">
                            <i class="bi bi-send-plus me-2"></i> Efetuar transferência
                        </h6>
                        <hr class="my-2 my-md-4 opacity-75">

                        <p class="text-muted small mb-3">
                            Selecione as senhas na tabela e insira o e-mail da pessoa que as vai receber.
                        </p>

                        @* Selection counter *@
                        <div class="p-2 p-md-3 mb-3 rounded-3 text-center bg-color-ips-light border border-info border-opacity-10">
                            <span class="fs-6 fs-md-5">
                                Senhas Selecionadas: <span id="selectedCounter" class="text-color-ips fw-bold">0</span>
                            </span>
                        </div>
                        <div class="row g-3 text-start">
                            @if (hasTickets)
                            {
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                                <div class="col-12 mb-2">
                                    <div class="form-floating">
                                        <input asp-for="RecipientEmail" class="form-control" placeholder="exemplo@ips.pt">
                                        <label asp-for="RecipientEmail"></label>
                                    </div>
                                    <span asp-validation-for="RecipientEmail" class="text-danger small text-start d-block mt-1"></span>
                                </div>
                                <button id="transferFormSubmit" type="submit" class="btn btn-ips w-100 fw-bold py-2 py-md-3 fs-6 fs-md-5 shadow-sm">
                                    <i class="bi bi-send me-2"></i> Enviar Senhas
                                </button>
                            }
                            else
                            {
                                <div class="text-muted small">
                                    Não tem senhas disponíveis para transferir. Adquire novas senhas para poder partilhá-las.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Right/bottom: Active Tickets Table *@
            <div class="col-lg-7">
                <div class="card card-ips shadow-sm border-0 rounded-3 hover-shadow-ips h-100 small fs-md-6">
                    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                        <h5 class="mb-0 fw-bold text-color-ips">
                            <i class="bi bi-list-check me-2"></i>Senhas disponíveis
                        </h5>
                    </div>

                    <div class="table-responsive" style="max-height: 500px;">
                        <table class="table table-hover align-middle text-center mb-0" id="ticketsTable">
                            <thead class="bg-color-ips text-white position-sticky top-0">
                            <tr>
                                <th class="py-2 py-md-3">Selecionar</th>
                                <th class="py-2 py-md-3">Código</th>
                                <th class="py-2 py-md-3">Data Expiração</th>
                            </tr>
                            </thead>
                            <tbody>
                            @if (hasTickets)
                            {
                                @foreach (var ticket in Model.AvailableTickets)
                                {
                                    <tr class="table-row-ips-hover ticket-row">
                                        <td class="py-2 py-md-3">
                                            <input type="checkbox" class="form-check-input ticket-checkbox border-secondary"
                                                   style="transform: scale(1.25); cursor: pointer;" name="SelectedTickets"
                                                   value="@ticket.ValidationCode">
                                        </td>
                                        <td><code class="badge bg-color-ips-light fw-bold text-color-ips px-2 py-1">@ticket.ValidationCode</code></td>
                                        <td>@ticket.ExpirationDate.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5 text-muted">
                                        <i class="bi bi-ticket-detailed fs-1 d-block mb-3 opacity-50 text-color-ips"></i>
                                        <span class="fw-bold">Não ten senhas disponíveis para transferir.</span>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/ticket/transferTicket.js"></script>
}