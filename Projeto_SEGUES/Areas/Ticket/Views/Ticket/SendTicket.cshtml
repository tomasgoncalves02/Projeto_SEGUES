@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Transferir Senhas";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold title-underline mb-0" style="border-bottom: 3px solid #009697; display: inline-block; padding-bottom: 5px;">
            Transferir Senhas
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold" style="border-color: #009697; color: #009697;">
            Voltar
        </a>
    </div>

    <div class="row g-5">
        @* Coluna da Esquerda: Formulário *@
        <div class="col-lg-5">
            <div class="card shadow-sm h-100" style="border: 2px solid #33B5E5;">
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="fw-bold mb-4" style="color: #009697;">
                        <i class="bi bi-cart-plus me-2 fs-4"></i> Efetuar transferência
                    </h5>
                    <hr class="mb-4">

                    <p class="text-muted small mb-4">
                        Selecione as senhas na tabela ao lado e insira o e-mail da pessoa que as vai receber.
                    </p>

                    <div class="p-3 mb-4 rounded text-center" style="background-color: #D1F2EB;">
                        <span class="text-dark fs-5">Senhas Selecionadas: <strong id="selectedCount" style="color: #009697; font-size: 1.5rem;">0</strong></span>
                    </div>

                    @* Formulário explicitamente direcionado para o TransferTickets do TicketController *@
                    <form asp-area="Ticket" asp-controller="Ticket" asp-action="TransferTickets" method="post" id="transferForm" class="mt-auto">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">E-mail do Destinatário:</label>
                            <input type="email" class="form-control form-control-lg" name="RecipientEmail" placeholder="exemplo@ips.pt" required>
                        </div>

                        <button type="submit" class="btn w-100 fw-bold text-white py-3 fs-5" style="background-color: #009697; border-radius: 8px;">
                            <i class="bi bi-send-fill me-2"></i> Enviar Senhas
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* Coluna da Direita: Tabela de Senhas Reais *@
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-list-check me-2" style="color: #009697;"></i>As tuas senhas disponíveis
                    </h5>
                </div>
                <div class="table-responsive" style="max-height: 500px;">
                    <table class="table table-hover align-middle text-center mb-0" id="ticketsTable">
                        <thead class="text-white" style="background-color: #009697; position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th class="py-3">Selecionar</th>
                                <th class="py-3">Código</th>
                                <th class="py-3">Data</th>
                                <th class="py-3">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var ticket in Model)
                                {
                                    <tr>
                                        <td class="py-3">
                                            @* ATENÇÃO AQUI: Adicionado form="transferForm" para ligar ao formulário da esquerda! *@
                                            <input type="checkbox" form="transferForm" class="form-check-input ticket-checkbox" style="transform: scale(1.3);" name="SelectedTickets" value="@ticket.ValidationCode" onchange="updateSelectedCount()">
                                        </td>
                                        <td class="fw-bold ticket-code" style="color: #009697;">@ticket.ValidationCode</td>
                                        <td>@ticket.ExpirationDate.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-success bg-opacity-10 text-success border border-success">Disponível</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-ticket-detailed fs-1 d-block mb-3 opacity-25"></i>
                                        <span class="fw-bold">Não tens senhas disponíveis para transferir.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/ticket/sendTicket.js"></script>
}