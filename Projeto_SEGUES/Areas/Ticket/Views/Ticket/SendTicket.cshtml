@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>

@{
    ViewData["Title"] = "Transferir Senhas";
}

<div class="container mt-5 mb-5">
    @* Cabeçalho da Página *@
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold title-underline mb-0">
            Transferir Senhas
        </h2>
        <a asp-action="Index" class="btn btn-ips-outline-secondary px-4 fw-bold shadow-sm">
            <i class="bi bi-arrow-left me-2"></i>Voltar
        </a>
    </div>

    <div class="row g-5">
        @* Coluna da Esquerda: Formulário de Envio *@
        <div class="col-lg-5">
            <div class="card shadow-sm h-100 card-ips hover-shadow-ips">
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="fw-bold mb-4 text-color-ips">
                        <i class="bi bi-send-plus me-2 fs-4"></i> Efetuar transferência
                    </h5>
                    <hr class="mb-4 opacity-75">

                    <p class="text-muted small mb-4">
                        Selecione as senhas na tabela ao lado e insira o e-mail da pessoa que as vai receber.
                    </p>

                    @* Contador de Seleção com fundo suave IPS *@
                    <div class="p-3 mb-4 rounded text-center bg-color-ips-light border border-info border-opacity-10">
                        <span class="text-dark fs-5">
                            Senhas Selecionadas: <strong id="selectedCount" class="text-color-ips" style="font-size: 1.5rem;">0</strong>
                        </span>
                    </div>

                    <form asp-area="Ticket" asp-controller="Ticket" asp-action="TransferTickets" method="post" id="transferForm" class="mt-auto">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">E-mail do Destinatário:</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input type="email" class="form-control form-control-lg border-start-0 ps-0"
                                       name="RecipientEmail" placeholder="exemplo@ips.pt" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-ips w-100 fw-bold py-3 fs-5 shadow-sm transition-all">
                            <i class="bi bi-send-fill me-2"></i> Enviar Senhas
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* Coluna da Direita: Tabela de Seleção *@
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-list-check me-2 text-color-ips"></i>As tuas senhas disponíveis
                    </h5>
                </div>

                <div class="table-responsive" style="max-height: 500px;">
                    <table class="table table-hover align-middle text-center mb-0" id="ticketsTable">
                        @* O segredo está nesta classe bg-color-ips e no CSS global que adicionámos *@
                        <thead class="bg-color-ips text-white position-sticky top-0">
                            <tr>
                                <th class="py-3">Selecionar</th>
                                <th class="py-3">Código</th>
                                <th class="py-3">Data Expiração</th>
                                <th class="py-3">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var ticket in Model)
                                {
                                    <tr class="table-row-ips-hover">
                                        <td class="py-3">
                                            <input type="checkbox" form="transferForm" class="form-check-input ticket-checkbox"
                                                   style="transform: scale(1.25); cursor: pointer;" name="SelectedTickets"
                                                   value="@ticket.ValidationCode" onchange="updateSelectedCount()">
                                        </td>
                                        <td class="fw-bold text-color-ips">@ticket.ValidationCode</td>
                                        <td>@ticket.ExpirationDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3">
                                                Disponível
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-ticket-detailed fs-1 d-block mb-3 opacity-25 text-color-ips"></i>
                                        <span class="fw-bold">Não tens senhas disponíveis para transferir.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/ticket/sendTicket.js"></script>
}