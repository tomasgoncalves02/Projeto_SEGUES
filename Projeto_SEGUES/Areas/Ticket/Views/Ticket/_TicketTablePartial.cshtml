@model IEnumerable<Projeto_SEGUES.Models.Ticket.Ticket>
@using Projeto_SEGUES.Extensions
@using Projeto_SEGUES.Models.Enums

@foreach (var item in Model)
{
    <tr>
        <td><code class="fw-bold text-color-ips">@item.ValidationCode</code></td>
        <td class="small">@item.ExpirationDate.ToString("dd/MM/yyyy")</td>
        <td>
            <span class="badge @item.State.ToString().ToBadgeClass()">
                @item.State.ToDisplayName()
            </span>
        </td>
        <td class="text-center">
            @if (item.State == TicketState.Available)
            {
                <button type="button" class="btn btn-ips btn-sm fw-bold showQr" data-code="@item.ValidationCode">
                    <i class="bi bi-qr-code"></i>
                </button>
            }
            else
            {
                <span class="text-muted small">--</span>
            }
        </td>
    </tr>
}