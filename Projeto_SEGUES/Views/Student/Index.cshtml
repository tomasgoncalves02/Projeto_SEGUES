@model Projeto_SEGUES.Models.User

@{
    ViewData["Title"] = "Área do Estudante";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>Área do Estudante</h1>
        @* Usamos o Model para ir buscar o Nome se a Identity falhar *@
        <span class="badge bg-primary">@Model.FirstName @Model.LastName</span>
    </div>

    <div class="row g-4">
        @* SALDO ATUAL *@
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 bg-primary text-white p-4">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75">O meu Saldo</h6>
                    @* CORREÇÃO AQUI: Usamos @Model.Balance em vez de ViewBag *@
                    <h2 class="display-6 fw-bold mt-2">@Model.Balance.ToString("C")</h2>
                    <a href="/Wallet/TopUp" class="btn btn-light btn-sm mt-3 fw-bold text-primary">Carregar</a>
                </div>
            </div>
        </div>

        @* COMPRA RÁPIDA *@
        <div class="col-md-8">
            <div class="card h-100 shadow-sm border-start border-4 border-success">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h3 class="fw-bold">Comprar Refeição</h3>
                        <p class="text-muted mb-0">Adquire as tuas senhas para o refeitório (2,90€).</p>
                    </div>
                    <a asp-controller="Tickets" asp-action="Index" class="btn btn-success btn-lg px-4">
                        Comprar ->
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>