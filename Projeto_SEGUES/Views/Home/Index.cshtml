@{
    ViewData["Title"] = "Página Inicial - SEGUES";
    var balance = ViewBag.UserBalance ?? 0m;
}

<div class="container mt-5">
    <div class="row mb-5">
        <div class="col-12">
            <h3 class="fw-bold display-5">Olá, @ViewBag.FirstName! 👋</h3>
            <p class="text-muted fs-5">Selecione uma das opções abaixo para gerir os seus serviços.</p>
        </div>
    </div>

    @* Main row *@
    <div class="row g-4">
        @* Balance Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips bg-color-ips text-white hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <small class="d-block opacity-75 fw-bold mb-2 fs-4">Saldo Disponível</small>
                    <h2 class="display-6 fw-bold my-auto">@balance.ToString("C")</h2>
                    <div class="mt-auto">
                        <a asp-area="Payment" asp-controller="Payment" asp-action="Deposit" class="btn btn-ips fw-bold w-100 py-2" style="border: 1px solid var(--ips-border) !important">Carregar Saldo</a>
                    </div>
                </div>
            </div>
        </div>
        @* Ticket Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cart-plus"></i></div>
                    <h5 class="fw-bold">Refeitório</h5>
                    <p class="text-muted small mb-4">Compra e usa as tuas senhas de refeição.</p>
                    <div class="mt-auto">
                        <a asp-area="Ticket" asp-controller="Ticket" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Ir para o Refeitório</a>
                    </div>
                </div>
            </div>
        </div>
        @* Bar Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cup-straw"></i></div>
                    <h5 class="fw-bold">Bar</h5>
                    <p class="text-muted small mb-4">Compra e gere os teus pedidos no bar.</p>
                    <div class="mt-auto">
                        <a asp-area="Bar" asp-controller="Bar" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Ir para o Bar</a>
                    </div>
                </div>
            </div>
        </div>
        @* History Card *@
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm card-ips hover-translate d-flex flex-column">
                <div class="card-body text-center d-flex flex-column p-4">
                    <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-clock-history"></i></div>
                    <h5 class="fw-bold">Histórico</h5>
                    <p class="text-muted small mb-4">Visualiza o teu histórico de utilização e validade.</p>
                    <div class="mt-auto">
                        <a asp-area="Report" asp-controller="Report" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Ver Histórico</a>
                    </div>
                </div>
            </div>
        </div>
        @* Employee Panel *@
        @if (User.IsInRole("Employee"))
        {
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm card-ips p-4 hover-translate">
                    <div class="card-body text-center d-flex flex-column p-0">
                        <div class="mb-3 text-color-ips" style="color: #009697; font-size: 2.5rem;">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <h5 class="fw-bold" style="color: #2D2926;">Painel de Gestão</h5>
                        <p class="text-muted small mb-4">Efetua as tuas tarefas de funcionário e gestão de refeições.</p>
                        <div class="mt-auto">
                            <a asp-area="Admin" asp-controller="Employee" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">
                                Ver Painel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        @* Admin Panel *@
        @if (User.IsInRole("Admin"))
        {
            <div class="col-12 mt-4">
                <div class="card shadow-lg card-admin p-4 hover-translate">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h4 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2"></i>Painel de Administração</h4>
                            <p class="mb-0 opacity-75">Configurações de limites e gestão de contas internas.</p>
                        </div>
                        <div class="col-md-4 text-center">
                            @* or 2B95 *@
                            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-light btn-lg px-5">Gerir Sistema &#x2192</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>