@using Microsoft.AspNetCore.Identity
@using Projeto_SEGUES.Areas.Order.ViewModels
@inject SignInManager<Projeto_SEGUES.Models.User.AppUser> SignInManager

@{
    ViewData["Title"] = "Página Inicial";
    OrderTotalViewModel cartTotal = ViewBag.CartTotal;
}

@if (!SignInManager.IsSignedIn(User))
{
    <div class="container d-flex flex-column px-xl-0 py-xl-4" style="min-height: 80vh;">
        <div class="row align-items-center flex-grow-1">
            <div class="col-lg-5">
                <p class="fs-3 mb-1 text-muted">BEM-VINDO AO</p>
                <h1 class="display-1 fw-bold">S<span class="text-color-ips">.</span>E<span class="text-color-ips">.</span>G<span class="text-color-ips">.</span>U<span class="text-color-ips">.</span>E<span class="text-color-ips">.</span>S<span class="text-color-ips">.</span></h1>
                <h2 class="fw-bold mb-4">
                    <span aria-hidden="true">
                        <b class="text-color-ips fs-1">S</b>istema <b class="text-color-ips fs-1">E</b>letrónico de <b class="text-color-ips fs-1">G</b>estão <b class="text-color-ips fs-1">U</b>niversitária de <b class="text-color-ips fs-1">E</b>ncomendas e <b class="text-color-ips fs-1">S</b>enhas
                    </span>
                    <span class="visually-hidden">
                        Sistema Eletrónico de Gestão Universitária de Encomendas e Senhas
                    </span>
                </h2>

                <p class="fs-5 text-muted mb-4">
                    Compre as suas senhas no refeitório e faz pedidos no bar de forma rápida e simples.
                </p>
                
                <div style="max-width: 450px;">
                    <div class="d-flex gap-2 mb-2">
                        <button id="pickMenu"
                                class="btn btn-ips py-3 flex-fill fw-bold"
                                data-canteen="@ViewBag.CanteenLink"
                                data-bar="@ViewBag.BarLink">
                            Ver Ementa
                        </button>
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-ips-outline-secondary py-3 flex-fill fw-bold col-2">Iniciar Sessão</a>
                    </div>
                    <a asp-controller="Home" asp-action="Schedule" class="btn btn-ips w-100 py-3 fw-bold">
                        Horário de Funcionamento
                    </a>
                </div>
            </div>

            <div class="col-lg-7 text-center">
                <img src="~/images/hero-devices.jpg" class="img-fluid animate-float" alt="SEGUES">
            </div>
        </div>

        <div class="text-center mt-auto pt-4">
            <p class="mb-0">Não tens conta? <a asp-area="Identity" asp-page="/Account/Register" class="fw-bold text-color-ips">Regista-te aqui.</a></p>
        </div>
    </div>
    @section Scripts {
        <script type="module" src="~/js/home.js"></script>
    }
}
else
{
    var balance = ViewBag.UserBalance ?? 0m;
    <div class="container mt-5 text-start">
        <div class="flex-column mb-3 align-items-center">
            <div class="flex-column flex-sm-row d-flex justify-content-between align-items-center mb-2">
                <h3 class="fw-bold display-5 mb-2">Olá, @ViewBag.FirstName! 👋</h3>
                @if (cartTotal is { TotalQuantity: > 0 })
                {
                    <div class="d-flex align-items-center bg-color-ips-very-light p-2 px-3 rounded-3 shadow-sm border">
                        <div class="text-center me-3 border-end pe-3">
                            <span class="fw-bold small d-block text-uppercase text-muted mb-1">Carrinho</span>
                            <a asp-area="Order" asp-controller="CreateOrder" asp-action="Checkout" class="position-relative d-inline-block text-decoration-none">
                                <i class="bi bi-cart-check fs-2 text-color-ips"></i>
                                <span id="cartCount" class="position-absolute badge rounded-pill bg-danger fs-7"
                                      style="top: -2px; right: -5px; padding: 0.35em 0.5em; border: 2px solid white;">
                                    @cartTotal.TotalQuantity
                                </span>
                            </a>
                        </div>
                        <div class="text-center">
                            <span class="fw-bold small d-block text-uppercase text-muted">Total</span>
                            <span id="cartTotal" class="fw-bold text-color-ips fs-5">@cartTotal.TotalValue.ToString("C")</span>
                        </div>
                    </div>
                }
            </div>
            <p class="text-muted fs-5">Selecione uma das opções abaixo para gerir os seus serviços.</p>
        </div>
        <div class="row g-4">
            @* Balance Card *@
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm card-ips hover-shadow-ips bg-color-ips text-white hover-translate d-flex flex-column">
                    <div class="card-body text-center d-flex flex-column p-4">
                        <small class="d-block opacity-75 fw-bold mb-2 fs-4">Saldo Disponível</small>
                        <h2 class="display-6 fw-bold my-auto mb-2">@balance.ToString("C")</h2>
                        <div class="mt-auto">
                            <a asp-area="Payment" asp-controller="Payment" asp-action="Deposit" class="btn btn-ips fw-bold w-100 py-2" style="border: 1px solid var(--ips-border) !important">Carregar Saldo</a>
                        </div>
                    </div>
                </div>
            </div>

            @* Ticket Card *@
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                    <div class="card-body text-center d-flex flex-column p-4">
                        <div class="fs-1 mb-3 text-color-ips"><i class="icon-fork-knife bg-color-ips" style="mask-size: 40px 47px; width: 40px; height: 47px;"></i></div>
                        <h5 class="fw-bold">Refeitório</h5>
                        <p class="text-muted small mb-4">Compra, utiliza e transfere as suas senhas de refeição ou consulta a ementa do refeitório.</p>
                        <div class="mt-auto">
                            <a asp-area="Ticket" asp-controller="Ticket" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Ir para o Refeitório</a>
                        </div>
                    </div>
                </div>
            </div>

            @* Bar Card *@
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                    <div class="card-body text-center d-flex flex-column p-4">
                        <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-cup-straw"></i></div>
                        <h5 class="fw-bold">Bar</h5>
                        <p class="text-muted small mb-4">Compra e gere os seus pedidos no bar ou consulta a ementa.</p>
                        <div class="mt-auto">
                            <a asp-area="Order" asp-controller="Order" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Ir para o Bar</a>
                        </div>
                    </div>
                </div>
            </div>

            @* History Card *@
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm card-ips hover-shadow-ips hover-translate d-flex flex-column">
                    <div class="card-body text-center d-flex flex-column p-4">
                        <div class="fs-1 mb-3 text-color-ips"><i class="bi bi-clock-history"></i></div>
                        <h5 class="fw-bold">Histórico</h5>
                        <p class="text-muted small mb-4">Visualiza o seu histórico de utilização da aplicação.</p>
                        <div class="mt-auto">
                            <a asp-area="Report" asp-controller="Report" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Ver Histórico</a>
                        </div>
                    </div>
                </div>
            </div>

            @* Employee & Admin Panels *@
            @if (User.IsInRole("Employee"))
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm card-ips hover-shadow-ips p-4 hover-translate">
                        <div class="card-body text-center d-flex flex-column p-0">
                            <div class="mb-3 text-color-ips fs-1">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <h5 class="fw-bold">Painel de Gestão</h5>
                            <p class="text-muted small mb-4">Realize a validação e gestão dos serviços.</p>
                            <div class="mt-auto">
                                <a asp-area="Admin" asp-controller="Employee" asp-action="Index" class="btn w-100 py-2 fw-bold btn-ips">Ver Painel</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (User.IsInRole("Admin"))
            {
                <div class="col-12 mt-4">
                    <div class="card shadow-lg card-admin hover-shadow-ips p-4 hover-translate">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h4 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2"></i>Painel de Administração</h4>
                                <p class="mb-2 opacity-75 py-1">Configurações e gestão da aplicação.</p>
                            </div>
                            <div class="col-md-4 text-center">
                                <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-light btn-lg px-5">Gerir Sistema &#x2192</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}