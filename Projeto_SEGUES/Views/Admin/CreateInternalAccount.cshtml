@model Projeto_SEGUES.Models.CreateInternalUserViewModel

@{
    ViewData["Title"] = "Criar Conta Interna";
}

<style>
    .ips-card {
        border: none !important;
        border-top: 5px solid #009697 !important;
        border-radius: 12px !important;
    }

    .text-ips {
        color: #009697 !important;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-4">Registar Administrador ou Funcionário</h2>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="card shadow-lg ips-card">
                <div class="card-body p-5">
                    <form asp-action="CreateInternalAccount" method="post">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-bold">Nome</label>
                                <input asp-for="FirstName" class="form-control" placeholder="Ex: João" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-bold">Sobrenome</label>
                                <input asp-for="LastName" class="form-control" placeholder="Ex: Silva" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email Profissional</label>
                            <input asp-for="Email" class="form-control" placeholder="utilizador@dominio.com" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Gender" class="form-label fw-bold">Género</label>
                                <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<Projeto_SEGUES.Models.Enums.Enums.Gender>()">
                                    <option value="">Selecione...</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="AccountType" class="form-label fw-bold">Função / Role</label>
                                <select asp-for="AccountType" class="form-select">
                                    <option value="Admin">Administrador</option>
                                    <option value="Employee">Funcionário</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-lg text-white w-100 fw-bold shadow-sm" style="background-color: #009697;">
                            <i class="bi bi-send-check me-2"></i>CRIAR E NOTIFICAR POR EMAIL
                        </button>
                    </form>
                </div>
            </div>

            <div class="mt-3 text-center">
                <a asp-action="Index" class="text-muted">Voltar ao Painel</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var successMsg = @Html.Raw(Json.Serialize(TempData["Success"]));
            var errorMsg = @Html.Raw(Json.Serialize(TempData["Error"]));

            if (successMsg && successMsg.length > 0) {
                Swal.fire({
                    icon: 'success',
                    title: 'Sucesso!',
                    text: successMsg,
                    confirmButtonColor: '#009697',
                    confirmButtonText: 'OK'
                }).then((result) => {
                   
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("Index", "Admin")';
                    }
                });
            }

            if (errorMsg && errorMsg.length > 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Erro!',
                    text: errorMsg,
                    confirmButtonColor: '#d33'
                });
            }
        });
    </script>
}