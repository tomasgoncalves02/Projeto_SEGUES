@model IEnumerable<Projeto_SEGUES.Models.Ticket>
@using static Projeto_SEGUES.Models.Enums.Enums

@{
    ViewData["Title"] = "Gestão de Senhas - SEGUES";
    var userRole = ViewBag.UserRole;
}

@* Importação do SweetAlert2 *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .title-underline {
        border-bottom: 4px solid #009697;
        display: inline-block;
        padding-bottom: 5px;
    }

    .text-ips {
        color: #009697 !important;
    }

    .bg-ips {
        background-color: #009697 !important;
    }

    .btn-ips {
        background-color: #009697 !important;
        color: white !important;
        border: none;
    }

        .btn-ips:hover {
            filter: brightness(90%);
            color: white;
        }

    .card-ips {
        border: none !important;
        border-top: 5px solid #009697 !important;
        border-radius: 10px !important;
    }
</style>

<div class="container mt-4">
    @* --- CABEÇALHO --- *@
    <div class="row mb-4 align-items-center">
        <div class="col-md-7">
            <h2 class="fw-bold title-underline mb-2">
                <i class="bi bi-shield-lock-fill me-2" style="color: #009697;"></i>
                Painel de Gestão e Auditoria
            </h2>
            <p class="text-muted small">Administração de Preçários e Registo Global de Senhas</p>
        </div>

        <div class="col-md-5 text-end">
            <a asp-controller="Admin" asp-action="Index" class="btn fw-bold px-4"
               style="border: 2px solid #009697; color: #009697; border-radius: 8px;">
                <i class="bi bi-arrow-left me-2"></i>Voltar
            </a>
        </div>
    </div>

    @* --- SECÇÃO ADMIN: DEFINIÇÃO DE PREÇOS (VERSÃO COMPACTA E RESPONSIVA) --- *@
    @if (userRole == UserRole.Admin)
    {
        var prices = ViewBag.Prices as List<Projeto_SEGUES.Models.TicketPrice>;
        <div class="card shadow-sm card-ips mb-5">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0 fw-bold text-ips"><i class="bi bi-currency-euro me-2"></i>Definição de Preçário (RF17)</h6>
            </div>
            <div class="card-body p-3 bg-light">
                <form asp-controller="Tickets" asp-action="UpdatePrices" method="post" class="row g-2 align-items-end">
                    @if (prices != null)
                    {
                        @for (int i = 0; i < prices.Count; i++)
                        {
                            <div class="col-md">
                                <label class="form-label small fw-bold text-muted mb-1">@Html.DisplayFor(modelItem => prices[i].TicketType)</label>
                                <input type="hidden" name="updatedPrices[@i].Id" value="@prices[i].Id" />
                                <input type="hidden" name="updatedPrices[@i].TicketType" value="@prices[i].TicketType" />
                                <input type="hidden" name="updatedPrices[@i].InitialDatePrice" value="@prices[i].InitialDatePrice.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white text-ips fw-bold">€</span>
                                    <input type="text" name="updatedPrices[@i].Price" class="form-control fw-bold" value="@prices[i].Price.ToString("F2")" />
                                </div>
                            </div>
                        }
                        <div class="col-md-2">
                            <label class="form-label small fw-bold text-muted mb-1">Validade</label>
                            <input type="date" name="updatedPrices[0].EndDatePrice" class="form-control form-control-sm fw-bold" min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@prices[0].EndDatePrice.ToString("yyyy-MM-dd")" />
                            @for (int i = 1; i < prices.Count; i++)
                            {
                                <input type="hidden" name="updatedPrices[@i].EndDatePrice" value="@prices[0].EndDatePrice.ToString("yyyy-MM-dd")" id="hiddenDate_@i" />
                            }
                        </div>
                    }
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-ips btn-sm w-100 fw-bold shadow-sm px-3" style="height: 31px;">
                            <i class="bi bi-arrow-repeat"></i> ATUALIZAR
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @* --- SECÇÃO: AUDITORIA GLOBAL --- *@
    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold text-ips"><i class="bi bi-list-check me-2"></i>Auditoria Geral de Senhas</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #009697; color: white;">
                    <tr>
                        <th class="ps-3">Utente</th>
                        <th>Código</th>
                        <th>Estado</th>
                        <th>Compra</th>
                        <th>Uso</th> @* Nova Coluna *@
                        <th>Expiração</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold small">@item.Owner?.FirstName @item.Owner?.LastName</div>
                                <div class="text-muted" style="font-size: 0.7rem;">@item.Owner?.Email</div>
                            </td>
                            <td><code class="fw-bold text-ips">@item.ValidationCode</code></td>
                            <td>
                                @if (item.State == TicketState.Available)
                                {
                                    <span class="badge bg-ips">Disponível</span>
                                }
                                else if (item.State == TicketState.Used)
                                {
                                    <span class="badge bg-secondary">Consumida</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Expirada</span>
                                }
                            </td>
                            <td class="small">@item.PurchaseDate.ToString("dd/MM/yy HH:mm")</td>

                            @* Lógica para Data de Uso *@
                            <td class="small fw-bold">
                                @(item.UsedDate.HasValue? item.UsedDate.Value.ToString("dd/MM/yy HH:mm") : "-")
                            </td>

                            <td class="small">@item.ExpirationDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var success = @Html.Raw(Json.Serialize(TempData["Success"]));
            var error = @Html.Raw(Json.Serialize(TempData["Error"]));

            if (success) {
                Swal.fire({ icon: 'success', title: 'Sucesso', text: success, confirmButtonColor: '#009697' });
            }
            if (error) {
                Swal.fire({ icon: 'error', title: 'Erro', text: error, confirmButtonColor: '#d33' });
            }
        });
    </script>
}