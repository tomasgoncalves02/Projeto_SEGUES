@model Projeto_SEGUES.Models.Audit.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="container text-center mt-5">
    <h1 class="text-danger display-4">Erro!</h1>
    <h2 class="text-danger mt-3">@Model.ErrorMessage</h2>

    <p class="text-muted mt-4 text-center">
        Por favor, tente novamente. Se o problema persistir, entre em contacto com o <a href="mailto:segues2026@gmail.com" class="fw-bold">suporte</a>.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="mt-4 p-3 bg-light rounded d-inline-block text-start border">
            <strong>Código do Erro:</strong><code class="d-block mt-1 fs-5">@Model.ErrorCode</code><br />
            <strong>Id do pedido:</strong><code class="d-block mt-1 fs-5">@Model.RequestId</code>
            <small class="text-muted">Por favor, forneça estes códigos ao contactar o suporte para facilitar o diagnóstico.</small>
        </div>
    }
    
    <div class="mt-5">
        <a href="/" class="btn btn-primary">Voltar à Página Inicial</a>
    </div>
</div>
