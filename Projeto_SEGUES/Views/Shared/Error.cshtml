@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Um erro aconteceu ao tentar executar o seu pedido.</h2>

<p>
    Por favor, tente novamente. Se o problema persistir, entre em contacto com o <a mailto="segues2026@gmail.com">suporte</a>.
</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@* Swapping to Development environment will display more detailed information about the error that occurred. *@
