@using Microsoft.AspNetCore.Identity
@using Projeto_SEGUES.Models.User
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var nome = user?.FirstName ?? "Utilizador";
    var inicial = nome[0].ToString().ToUpper();

    <div class="dropdown">
        <div class="dropdown-toggle d-flex align-items-center p-0" id="userMenu" data-bs-toggle="dropdown" tabindex="0" role="button" aria-haspopup="true" aria-expanded="false">
            <div class="avatar-circle">@inicial</div>
            @* d-none (hide in mobile); d-sm-inline (show in tablet/pc) *@
            <span class="ms-2 d-none d-sm-inline text-dark fw-bold">Olá, @nome!</span>
        </div>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
            <li><a class="dropdown-item fw-bold" asp-area="User" asp-page="/Index">Perfil</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                @* Logout (POST for security) *@
                <form class="form-inline fw-bold" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new {area = ""})">
                    <button type="submit" class="dropdown-item text-danger">Sair</button>
                </form>
            </li>
        </ul>
    </div>
}